diff --git a/Telegram/SourceFiles/stopscroll/stopscroll.cpp b/Telegram/SourceFiles/stopscroll/stopscroll.cpp
new file mode 100644
index 0000000..576ffaa
--- /dev/null
+++ b/Telegram/SourceFiles/stopscroll/stopscroll.cpp
@@ -0,0 +1,171 @@
+#include "stopscroll/stopscroll.h"
+
+#include "stopscroll/stopscroll_policy.h"
+#include "data/data_peer.h"
+#include "history/history.h"
+#include "lang/lang_keys.h"
+#include "mainwidget.h"
+#include "window/window_session_controller.h"
+
+#include <QtCore/QCoreApplication>
+#include <QtCore/QFile>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QTimer>
+#include <QtNetwork/QLocalSocket>
+
+namespace Stopscroll {
+namespace {
+
+constexpr auto kRefreshMs = 1000;
+
+class Manager final : public QObject {
+public:
+	Manager();
+	[[nodiscard]] bool blocked(const PeerData *peer);
+	[[nodiscard]] bool ready() const;
+	[[nodiscard]] quint64 revision() const;
+
+private:
+	void refresh();
+	void observe(const QString &name, quint64 id);
+
+	Policy _policy;
+	QByteArray _lastPolicy;
+	QSet<QString> _inflight;
+	quint64 _revision = 0;
+
+};
+
+Manager::Manager() : QObject(QCoreApplication::instance()) {
+	refresh();
+	const auto timer = new QTimer(this);
+	QObject::connect(timer, &QTimer::timeout, this, [=] { refresh(); });
+	timer->start(kRefreshMs);
+}
+
+void Manager::refresh() {
+	auto file = QFile(u"/etc/stopscroll/telegram.json"_q);
+	if (!file.open(QIODevice::ReadOnly) || file.size() > 1024 * 1024) {
+		return;
+	}
+	const auto bytes = file.readAll();
+	if (bytes != _lastPolicy && _policy.update(bytes)) {
+		_lastPolicy = bytes;
+		++_revision;
+	}
+}
+
+void Manager::observe(const QString &name, quint64 id) {
+	_policy.remember(name, id);
+	const auto key = name + ':' + QString::number(id);
+	if (_policy.recorded(name, id) || _inflight.contains(key)) {
+		return;
+	}
+	_inflight.insert(key);
+	const auto socket = new QLocalSocket(this);
+	const auto payload = QJsonDocument(QJsonObject{
+		{ u"cmd"_q, u"telegram-observe"_q },
+		{ u"username"_q, name },
+		{ u"id"_q, QString::number(id) },
+	}).toJson(QJsonDocument::Compact) + '\n';
+	QObject::connect(socket, &QLocalSocket::connected, socket, [=] {
+		socket->write(payload);
+	});
+	QObject::connect(socket, &QLocalSocket::readyRead, socket, [=] {
+		if (socket->canReadLine() || socket->bytesAvailable() > 65536) {
+			socket->disconnectFromServer();
+			socket->deleteLater();
+		}
+	});
+	QObject::connect(socket, &QLocalSocket::errorOccurred, socket, [=] {
+		socket->deleteLater();
+	});
+	QObject::connect(socket, &QObject::destroyed, this, [=] {
+		_inflight.remove(key);
+	});
+	QTimer::singleShot(3000, socket, [=] {
+		socket->abort();
+		socket->deleteLater();
+	});
+	socket->connectToServer(u"/run/stopscroll/stopscroll.sock"_q);
+}
+
+bool Manager::blocked(const PeerData *peer) {
+	if (!peer || !peer->isChannel()) {
+		return false;
+	}
+	const auto id = peerToChannel(peer->id).bare;
+	auto names = QStringList();
+	for (const auto &name : peer->usernames()) {
+		names.push_back(name.toLower());
+	}
+	const auto primary = peer->username().toLower();
+	if (!primary.isEmpty() && !names.contains(primary)) {
+		names.push_back(primary);
+	}
+	for (const auto &name : names) {
+		if (_policy.contains(name)) {
+			observe(name, id);
+		}
+	}
+	return _policy.blocked(id, names);
+}
+
+bool Manager::ready() const {
+	return _policy.ready();
+}
+
+quint64 Manager::revision() const {
+	return _revision;
+}
+
+[[nodiscard]] Manager &Instance() {
+	static const auto result = new Manager();
+	return *result;
+}
+
+}
+
+bool Blocked(const PeerData *peer) {
+	return Instance().blocked(peer);
+}
+
+QString UnavailableReason() {
+	return Instance().ready()
+		? tr::lng_stopscroll_channel_blocked(tr::now)
+		: tr::lng_stopscroll_policy_unavailable(tr::now);
+}
+
+bool Prevent(
+		const PeerData *peer,
+		Window::SessionController *controller) {
+	if (!Blocked(peer)) {
+		return false;
+	}
+	controller->showToast(UnavailableReason());
+	return true;
+}
+
+quint64 Revision() {
+	return Instance().revision();
+}
+
+void Attach(QObject *context, Window::SessionController *controller) {
+	const auto timer = new QTimer(context);
+	QObject::connect(timer, &QTimer::timeout, context, [=] {
+		if (Blocked(controller->activeChatCurrent().peer())) {
+			CloseBlocked(controller);
+		}
+	});
+	timer->start(kRefreshMs);
+}
+
+void CloseBlocked(Window::SessionController *controller) {
+	controller->content()->showHistory(PeerId(), Window::SectionShow(
+		Window::SectionShow::Way::ClearStack,
+		anim::type::instant), MsgId());
+	controller->showToast(UnavailableReason());
+}
+
+}

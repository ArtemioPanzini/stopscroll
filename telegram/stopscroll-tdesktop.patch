+[[nodiscard]] std::unique_ptr<QTimer> WatchChannelPolicy(Fn<void()> refresh) {
+	auto timer = std::make_unique<QTimer>();
+	QObject::connect(timer.get(), &QTimer::timeout, timer.get(),
+		[revision = Stopscroll::Revision(), refresh = std::move(refresh)]() mutable {
+			const auto current = Stopscroll::Revision();
+			if (revision != current) {
+				revision = current;
+				refresh();
+			}
+		});
+	timer->start(1000);
+	return timer;
+}
+
+void FillChannelRows(
+		not_null<PeerListDelegate*> delegate,
+		const std::vector<not_null<PeerData*>> &peers,
+		int limit,
+		Fn<void(not_null<PeerData*>)> append) {
+	const auto already = delegate->peerListFullRowsCount();
+	auto same = (already == limit);
+	for (auto i = 0; same && i != limit; ++i) {
+		same = (delegate->peerListRowAt(i)->peer() == peers[i]);
+	}
+	if (same) {
+		return;
+	}
+	for (auto i = already; i != 0;) {
+		delegate->peerListRemoveRow(delegate->peerListRowAt(--i));
+	}
+	for (auto i = 0; i != limit; ++i) {
+		append(peers[i]);
+	}
+	delegate->peerListRefreshRows();
+}

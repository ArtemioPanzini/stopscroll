+#pragma once
+
+class PeerData;
+class QObject;
+
+namespace Window {
+class SessionController;
+}
+
+namespace Stopscroll {
+
+[[nodiscard]] bool Blocked(const PeerData *peer);
+[[nodiscard]] QString UnavailableReason();
+[[nodiscard]] bool Prevent(
+	const PeerData *peer,
+	Window::SessionController *controller);
+[[nodiscard]] quint64 Revision();
+void Attach(QObject *context, Window::SessionController *controller);
+void CloseBlocked(Window::SessionController *controller);
+
+}
diff --git a/Telegram/SourceFiles/stopscroll/stopscroll_policy.cpp b/Telegram/SourceFiles/stopscroll/stopscroll_policy.cpp
new file mode 100644
index 0000000..c5408a8
--- /dev/null
+++ b/Telegram/SourceFiles/stopscroll/stopscroll_policy.cpp
@@ -0,0 +1,106 @@
+#include "stopscroll/stopscroll_policy.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QRegularExpression>
+
+namespace Stopscroll {
+
+bool Policy::update(const QByteArray &json) {
+	if (json.size() > 1024 * 1024) {
+		return false;
+	}
+	const auto document = QJsonDocument::fromJson(json);
+	if (!document.isObject()) {
+		return false;
+	}
+	const auto root = document.object();
+	if (root.size() != 2
+		|| root.value("version").toDouble() != 1.
+		|| !root.value("channels").isArray()) {
+		return false;
+	}
+	const auto entries = root.value("channels").toArray();
+	if (entries.size() > 10000) {
+		return false;
+	}
+	const auto usernamePattern = QRegularExpression(
+		QRegularExpression::anchoredPattern("[a-z][a-z0-9_]{0,31}"));
+	const auto idPattern = QRegularExpression(
+		QRegularExpression::anchoredPattern("[1-9][0-9]{0,15}"));
+	auto channels = QHash<QString, QSet<quint64>>();
+	for (const auto &entry : entries) {
+		if (!entry.isObject()) {
+			return false;
+		}
+		const auto channel = entry.toObject();
+		const auto name = channel.value("username").toString();
+		if (channel.size() != 2
+			|| !usernamePattern.match(name).hasMatch()
+			|| channels.contains(name)
+			|| !channel.value("ids").isArray()) {
+			return false;
+		}
+		auto ids = QSet<quint64>();
+		for (const auto &value : channel.value("ids").toArray()) {
+			const auto text = value.toString();
+			if (!idPattern.match(text).hasMatch()) {
+				return false;
+			}
+			const auto id = text.toULongLong();
+			if (!id || id > ((quint64(1) << 52) - 1)) {
+				return false;
+			}
+			ids.insert(id);
+		}
+		channels.insert(name, std::move(ids));
+	}
+	for (auto i = _remembered.begin(); i != _remembered.end();) {
+		if (!channels.contains(i.key())) {
+			i = _remembered.erase(i);
+		} else {
+			++i;
+		}
+	}
+	_channels = std::move(channels);
+	_ready = true;
+	return true;
+}
+
+bool Policy::ready() const {
+	return _ready;
+}
+
+bool Policy::blocked(quint64 id, const QStringList &names) const {
+	if (!_ready) {
+		return true;
+	}
+	for (const auto &name : names) {
+		if (contains(name.toLower())) {
+			return true;
+		}
+	}
+	for (auto i = _channels.cbegin(); i != _channels.cend(); ++i) {
+		if (i.value().contains(id) || _remembered.value(i.key()).contains(id)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool Policy::contains(const QString &name) const {
+	return _channels.contains(name);
+}
+
+bool Policy::recorded(const QString &name, quint64 id) const {
+	return _channels.value(name).contains(id);
+}
+
+void Policy::remember(const QString &name, quint64 id) {
+	if (contains(name) && id && id <= ((quint64(1) << 52) - 1)) {
+		_remembered[name].insert(id);
+	}
+}
+
+}

+				exchange(next, other)
+			})
+		})
+	}
+}
+
+// Pause the real connection map after it has installed the sockets, before
+// admission releases its read lock and forwarding can enter either copy loop.
+type pausedTracker struct {
+	core.ConnMapper
+	installed, release chan struct{}
+}
+
+func (p *pausedTracker) Track(id, uid, pid string, conns ...core.MinConn) int {
+	n := p.ConnMapper.Track(id, uid, pid, conns...)
+	close(p.installed)
+	<-p.release
+	return n
+}
+
+func TestCutoffOverlapsTrack(t *testing.T) {
+	for _, proto := range []string{"tcp", "udp"} {
+		t.Run(proto, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				f := newCutoffFixture(t, proto)
+				p := &pausedTracker{f.h.conntracker, make(chan struct{}), make(chan struct{})}
+				f.h.conntracker = p
+				a, app := net.Pipe()
+				b, peer := net.Pipe()
+				defer app.Close()
+				defer peer.Close()
+				go f.h.forward(a, rwext{b, 0}, &FlowSummary{ID: "paused", generation: f.h.admission.snapshot()})
+				<-p.installed
+				if f.admission.TryLock() {
+					f.admission.Unlock()
+					t.Error("registration is not ordered against the sweep")
+				}
+				receipt := make(chan string, 1)
+				started := make(chan struct{})
+				go func() { close(started); receipt <- f.CloseConns("") }()
+				<-started
+				close(p.release)
+				if <-receipt != "paused" {
+					t.Fatal("overlapping connection escaped the sweep")
+				}
+				synctest.Wait()
+				if _, err := app.Write([]byte{'x'}); !errors.Is(err, io.ErrClosedPipe) {
+					t.Fatalf("old application endpoint: %v", err)
+				}
+			})
+		})
+	}
+}
+
+func TestCutoffLateDNSUntrack(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		f := newCutoffFixture(t, "udp")
+		f.resolver.retiredDone = make(chan struct{})
+		old, app := net.Pipe()
+		defer app.Close()
+		f.h.dnsOverride(old, "7", &FlowSummary{ID: "retired", UID: "7", generation: f.h.admission.snapshot()})
+		synctest.Wait()
+		f.CloseConns("")
+		fresh, stub := net.Pipe()
+		defer stub.Close()
+		// The first retired socket used numeric tracking key 1. A different
+		// flow in the new generation can legitimately have UID 1.
+		f.h.dnsOverride(fresh, "1", &FlowSummary{ID: "fresh", UID: "1", generation: f.h.admission.snapshot()})
+		synctest.Wait()
+		close(f.resolver.retiredDone)
+		synctest.Wait()
+		if _, err := stub.Write([]byte{'n'}); err != nil {
+			t.Fatalf("retired Untrack closed the fresh DNS flow: %v", err)
+		}
+	})
+}

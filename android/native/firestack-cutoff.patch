+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package intra
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/celzero/firestack/intra/core"
+	"github.com/celzero/firestack/intra/dnsx"
+	"github.com/celzero/firestack/intra/netstack"
+	"github.com/celzero/firestack/intra/protect"
+	"github.com/celzero/firestack/intra/settings"
+)
+
+type cutoffListener struct {
+	zeroListener
+	holdPreflow bool
+	entered     chan struct{}
+	release     chan struct{}
+}
+
+func (l *cutoffListener) pause() {
+	l.entered <- struct{}{}
+	<-l.release
+}
+func (l *cutoffListener) Preflow(_, _ int32, _, _ string) *PreMark {
+	if l.holdPreflow {
+		l.pause()
+	}
+	return nil
+}
+
+func (l *cutoffListener) Flow(_, _ int32, _, _, _, _, _, _ string, _ bool) *Mark {
+	if !l.holdPreflow {
+		l.pause()
+	}
+	return &Mark{CID: "allowed", PIDCSV: "Base"}
+}
+func (l *cutoffListener) Inflow(_, _ int32, _, _ string) *Mark {
+	l.pause()
+	return &Mark{CID: "allowed", PIDCSV: "Base"}
+}
+
+type cutoffDNS struct {
+	dnsx.Resolver
+	calls       atomic.Int32
+	retiredDone chan struct{}
+}
+
+func (*cutoffDNS) Gateway() dnsx.Gateway { return nil }
+func (d *cutoffDNS) Serve(_ string, c protect.Conn, _, fid string) (int64, int64, []error) {
+	d.calls.Add(1)
+	n, _ := io.Copy(io.Discard, c)
+	if fid == "retired" && d.retiredDone != nil {
+		<-d.retiredDone
+	}
+	return n, 0, nil
+}
+
+type cutoffConn struct {
+	net.Conn
+	reads  atomic.Int32
+	closed atomic.Bool
+}
+
+func (c *cutoffConn) Close() error             { c.closed.Store(true); return c.Conn.Close() }
+func (c *cutoffConn) Read([]byte) (int, error) { c.reads.Add(1); return 0, io.EOF }
+
+type cutoffFixture struct {
+	*rtunnel
+	h        *baseHandler
+	listener *cutoffListener
+	resolver *cutoffDNS
+}
+
+func newCutoffFixture(t *testing.T, proto string) cutoffFixture {
+	t.Helper()
+	ctx, done := context.WithCancel(context.Background())
+	t.Cleanup(done)
+	a := new(flowAdmission)
+	ctx = context.WithValue(ctx, admissionKey{}, a)
+	r := new(cutoffDNS)
+	l := &cutoffListener{entered: make(chan struct{}), release: make(chan struct{})}
+	tcp := NewTCPHandler(ctx, r, nil, l).(*tcpHandler)
+	udp := NewUDPHandler(ctx, r, nil, l).(*udpHandler)
+	h := tcp.baseHandler
+	if proto == "udp" {
+		h = udp.baseHandler
+	}
+	return cutoffFixture{&rtunnel{handlers: netstack.NewGConnHandler(nil, tcp, udp, nil), admission: a}, h, l, r}
+}
+
+func TestCutoffDelayedDecision(t *testing.T) {
+	oldMode := settings.BlockMode.Swap(settings.BlockModeFilter)
+	t.Cleanup(func() { settings.BlockMode.Store(oldMode) })
+	for _, proto := range []string{"tcp", "udp"} {
+		for _, path := range []string{"preflow", "forward", "reverse", "dns"} {
+			t.Run(proto+"/"+path, func(t *testing.T) {
+				synctest.Test(t, func(t *testing.T) {
+					f := newCutoffFixture(t, proto)
+					f.listener.holdPreflow = path == "preflow"
+					a, b := net.Pipe()
+					local, remote := &cutoffConn{Conn: a}, &cutoffConn{Conn: b}
+					defer b.Close()
+					go func() {
+						addr := netip.MustParseAddrPort("192.0.2.123:53")
+						var generation uint64
+						var mark *Mark
+						if path == "reverse" {
+							mark, generation = f.h.onInflow(addr, addr)
+						} else {
+							mark, _, _, _, generation = f.h.onFlow(addr, addr)
+						}
+						s := &FlowSummary{ID: mark.CID, Proto: proto, generation: generation}
+						if path == "dns" {
+							f.h.dnsOverride(local, "test", s)
+						} else {
+							f.h.forward(local, rwext{remote, 0}, s)
+						}
+					}()
+					<-f.listener.entered
+					f.CloseConns("")
+					close(f.listener.release)
+					synctest.Wait()
+					if n := local.reads.Load() + remote.reads.Load(); n != 0 {
+						t.Errorf("old decision entered payload copy: %d reads", n)
+					}
+					if f.resolver.calls.Load() != 0 {
+						t.Error("old decision started DNS Serve")
+					}
+					if !local.closed.Load() || path != "dns" && !remote.closed.Load() {
+						t.Error("old endpoints left open")
+					}
+				})
+			})
+		}
+	}
+}
+
+func TestCutoffRegisteredSockets(t *testing.T) {
+	for _, proto := range []string{"tcp", "udp"} {
+		t.Run(proto, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				f := newCutoffFixture(t, proto)
+				open := func(id string) (net.Conn, net.Conn) {
+					a, app := net.Pipe()
+					b, peer := net.Pipe()
+					t.Cleanup(func() { app.Close(); peer.Close() })
+					s := &FlowSummary{ID: id, Proto: proto, generation: f.h.admission.snapshot()}
+					go f.h.forward(a, rwext{b, 0}, s)
+					synctest.Wait()
+					return app, peer
+				}
+				exchange := func(a, b net.Conn) {
+					t.Helper()
+					go a.Write([]byte{'x'})
+					var v [1]byte
+					if _, err := io.ReadFull(b, v[:]); err != nil || v[0] != 'x' {
+						t.Fatalf("current generation transfer: %q, %v", v, err)
+					}
+				}
+				app, peer := open("existing")
+				exchange(app, peer)
+				var dnsApps []net.Conn
+				for i := 0; i < 2; i++ { // Kotlin can supply the same (or empty) CID.
+					dns, stub := net.Pipe()
+					t.Cleanup(func() { stub.Close() })
+					f.h.dnsOverride(dns, "test", &FlowSummary{ID: "same", Proto: proto, generation: f.h.admission.snapshot()})
+					dnsApps = append(dnsApps, stub)

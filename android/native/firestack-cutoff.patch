diff --git a/intra/cutoff_retrier_test.go b/intra/cutoff_retrier_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..afd5c357e371874483847d1c50f2eaacd336e1f0
--- /dev/null
+++ b/intra/cutoff_retrier_test.go
@@ -0,0 +1,229 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package intra
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/celzero/firestack/intra/dialers"
+	"github.com/celzero/firestack/intra/protect"
+)
+
+const retryTestLimit = 3 * time.Second
+const retryPayload = "first request"
+
+type retryTestConn interface {
+	net.Conn
+	CloseRead() error
+	CloseWrite() error
+}
+
+type retryFixture struct {
+	listener *net.TCPListener
+	client   retryTestConn
+	first    *net.TCPConn
+	dials    atomic.Int32
+}
+
+func loopbackRetrier(t *testing.T, beforeSecond func()) *retryFixture {
+	t.Helper()
+	listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	f := &retryFixture{listener: listener}
+	d := protect.MakeNsRDialExt("cutoff-test", context.Background(), nil, func(_, _ string, _ syscall.RawConn) error {
+		if f.dials.Add(1) == 2 && beforeSecond != nil {
+			beforeSecond()
+		}
+		return nil
+	})
+	f.client, err = dialers.DialWithSplitRetry(d, nil, listener.Addr().(*net.TCPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { f.client.Close() })
+	f.first, err = listener.AcceptTCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { f.first.Close() })
+	return f
+}
+
+func readRequest(t *testing.T, c net.Conn) {
+	t.Helper()
+	c.SetReadDeadline(time.Now().Add(retryTestLimit))
+	b := make([]byte, len(retryPayload))
+	if _, err := io.ReadFull(c, b); err != nil || string(b) != retryPayload {
+		t.Fatalf("read first request %q: %v", b, err)
+	}
+}
+
+// Accept a possible replacement and acknowledge any replay. Closing the listener
+// also releases Accept when full close prevents the replacement entirely.
+func (f *retryFixture) observeReplay() <-chan string {
+	result := make(chan string, 1)
+	go func() {
+		c, err := f.listener.AcceptTCP()
+		if err != nil {
+			result <- ""
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(retryTestLimit))
+		b := make([]byte, len(retryPayload))
+		n, _ := io.ReadFull(c, b)
+		if n > 0 {
+			c.Write([]byte{'a'})
+		}
+		result <- string(b[:n])
+	}()
+	return result
+}
+
+func TestCutoffRetrierFirstResponse(t *testing.T) {
+	for _, full := range []bool{true, false} {
+		name := "half-close permits retry"
+		if full {
+			name = "full close retires retry"
+		}
+		t.Run(name, func(t *testing.T) {
+			f := loopbackRetrier(t, nil)
+			if _, err := io.WriteString(f.client, retryPayload); err != nil {
+				t.Fatal(err)
+			}
+			readRequest(t, f.first)
+			replayed := f.observeReplay()
+			if full {
+				f.client.Close()
+			} else {
+				f.client.CloseWrite()
+				f.first.Close()
+			}
+			var b [1]byte
+			n, err := f.client.Read(b[:])
+			f.listener.Close()
+			payload := <-replayed
+			if full {
+				if n != 0 || err == nil || f.dials.Load() != 1 || payload != "" {
+					t.Fatalf("full close: read %q, err %v, dials %d, replay %q", b, err, f.dials.Load(), payload)
+				}
+			} else if n != 1 || err != nil || b[0] != 'a' || payload != retryPayload {
+				t.Fatalf("half close: read %q, err %v, replay %q", b, err, payload)
+			}
+		})
+	}
+	t.Run("read half-close retains writes", func(t *testing.T) {
+		f := loopbackRetrier(t, nil)
+		f.client.CloseRead()
+		if _, err := io.WriteString(f.client, retryPayload); err != nil {
+			t.Fatal(err)
+		}
+		readRequest(t, f.first)
+	})
+}
+
+func TestCutoffRetrierBlockedDial(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	f := loopbackRetrier(t, func() { close(entered); <-release })
+	tun := newCutoffFixture(t, "tcp")
+	// Real forwarding wraps the protected TCP retrier in rwext. Register a
+	// second UDP flow so the test observes the remainder of the actual sweep.
+	local, app := net.Pipe()
+	defer app.Close()
+	go tun.h.forward(local, rwext{f.client, 0}, &FlowSummary{ID: "retrying", Proto: "tcp"})
+	if _, err := io.WriteString(app, retryPayload); err != nil {
+		t.Fatal(err)
+	}
+	readRequest(t, f.first)
+	uh := tun.handlers.UDP().(*udpHandler)
+	u, ua := net.Pipe()
+	v, ub := net.Pipe()
+	defer ua.Close()
+	defer ub.Close()
+	go uh.forward(u, rwext{v, 0}, &FlowSummary{ID: "other", Proto: "udp"})
+	go ua.Write([]byte{'u'})
+	var b [1]byte
+	if _, err := io.ReadFull(ub, b[:]); err != nil {
+		t.Fatal(err)
+	}
+	replayed := f.observeReplay()
+	f.first.Close()
+	select {
+	case <-entered:
+	case <-time.After(retryTestLimit):
+		close(release)
+		t.Fatal("second TCP dial did not begin")
+	}
+	receipt := make(chan string, 1)
+	go func() { receipt <- tun.CloseConns("") }()
+	select {
+	case ids := <-receipt:
+		if ids != "retrying,other" {
+			t.Errorf("closed IDs %q", ids)
+		}
+		ua.SetWriteDeadline(time.Now().Add(retryTestLimit))
+		if _, err := ua.Write([]byte{'x'}); err == nil {
+			t.Error("UDP flow survived the sweep")
+		}
+	case <-time.After(retryTestLimit):
+		t.Error("cutoff waited for the pending TCP dial")
+	}
+	close(release)
+	if got := <-replayed; got != "" {
+		t.Errorf("replacement received buffered payload: %q", got)
+	}
+}
+
+// Once a replacement is published, interrupt its pending first-response read
+// without waiting for the server, and leave the replacement socket closed.
+func TestCutoffRetrierPublishedReplacement(t *testing.T) {
+	f := loopbackRetrier(t, nil)
+	if _, err := io.WriteString(f.client, retryPayload); err != nil {
+		t.Fatal(err)
+	}
+	readRequest(t, f.first)
+	f.first.Close()
+	readDone := make(chan error, 1)
+	go func() { var b [1]byte; _, err := f.client.Read(b[:]); readDone <- err }()
+	f.listener.SetDeadline(time.Now().Add(retryTestLimit))
+	next, err := f.listener.AcceptTCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer next.Close()
+	readRequest(t, next)
+	closed := make(chan struct{})
+	go func() { f.client.Close(); close(closed) }()
+	select {
+	case <-closed:
+	case <-time.After(retryTestLimit):
+		next.Close()
+		t.Fatal("close waited for a remote first response")
+	}
+	var b [1]byte
+	if n, err := next.Read(b[:]); n != 0 || err != io.EOF {
+		t.Fatalf("replacement still open: read %d, %v", n, err)
+	}
+	select {
+	case err := <-readDone:
+		if err == nil {
+			t.Fatal("retired response read succeeded")
+		}
+	case <-time.After(retryTestLimit):
+		t.Fatal("first-response reader did not exit")
+	}
+	if got := f.dials.Load(); got != 2 {
+		t.Fatalf("additional dial after close: %d", got)
+	}
+}

+				synctest.Wait()
+				if f.resolver.calls.Load() != 2 {
+					t.Fatal("DNS fixtures did not enter Serve")
+				}
+				gen := f.h.admission.snapshot()
+				open("selected")
+				if f.CloseConns("selected") != "selected" || f.CloseConns("same") != "" || f.h.admission.snapshot() != gen {
+					t.Fatal("targeted close changed policy admission")
+				}
+				exchange(app, peer)
+				if got := f.CloseConns(""); got != "existing" {
+					t.Fatalf("upstream closed-ID result changed: %q", got)
+				}
+				synctest.Wait()
+				for _, c := range append(dnsApps, app, peer) {
+					// Deadlines bound the RED case when no sweep closed the DNS socket.
+					c.SetDeadline(time.Now().Add(time.Second))
+					if _, err := c.Write([]byte{'y'}); !errors.Is(err, io.ErrClosedPipe) {
+						t.Errorf("old endpoint after close-all: %v", err)
+					}

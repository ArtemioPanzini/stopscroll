+// EstablishedConn returns the live endpoint for synchronous close in the
+// connection tracker. The forwarding wrappers schedule Close asynchronously.
+func EstablishedConn(conn net.Conn) net.Conn {
+	switch g := conn.(type) {
+	case *GTCPConn:
+		if c := g.conn(); c != nil {
+			return c
+		}
+	case *GUDPConn:
+		if c := g.conn(); c != nil {
+			return c
+		}
+	}
+	return conn
+}

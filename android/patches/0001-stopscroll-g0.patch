@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll;
+
+import android.content.ContentProvider;
+import android.os.Binder;
+import android.os.Bundle;
+
+/** The Binder identity check precedes even a null method received from IPC. */
+public abstract class ShellCallProvider extends ContentProvider {
+    @Override
+    public final Bundle call(String method, String arg, Bundle extras) {
+        requireShell();
+        return callFromShell(method, arg);
+    }
+
+    @Override
+    public final Bundle call(String authority, String method, String arg, Bundle extras) {
+        requireShell();
+        if (authority == null) {
+            throw new UnsupportedOperationException("Missing provider authority");
+        }
+        return callFromShell(method, arg);
+    }
+
+    protected abstract Bundle callFromShell(String method, String arg);
+
+    protected static void requireShell() {
+        if (Binder.getCallingUid() != 2000) {
+            throw new SecurityException("ADB shell required");
+        }
+    }
+}

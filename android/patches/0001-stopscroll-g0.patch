+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/EngineAdapterTest.kt
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.time.ZoneId
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.FutureTask
+import java.util.concurrent.TimeUnit.SECONDS
+import kotlin.concurrent.thread
+import org.junit.Assert.*
+import org.junit.Test
+
+internal class TestTunnel(override val owner: Any = Any()) : EngineTarget {
+    var close: () -> Unit = {}
+    var refresh: () -> Unit = {}
+    var probe: () -> PlatformProtection = { PlatformProtection(true, true, true, true) }
+    var sweeps = 0
+    override fun sweep() { sweeps++; close() }
+    override fun refreshResolver(): String { refresh(); return "Preferred" }
+    override fun platform() = probe()
+}
+
+internal class TestTimers : SessionTimers {
+    var cutoff: (() -> Unit)? = null
+    val warnings = mutableListOf<String>()
+    override fun deadline(elapsedMs: Long, action: () -> Unit): () -> Unit {
+        cutoff = action
+        return {}
+    }
+    override fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit = {}
+    override fun warn(site: String) { warnings.add(site) }
+}
+
+class EngineAdapterTest {
+    private var now = ClockSample(1783850400000, 7000, 12)
+    private val timers = TestTimers()
+    private val engine = EngineAdapter({ now }, timers, 200)
+    private val target = TestTunnel()
+    private val state = JournalState.initial(ZoneId.of("UTC"), now, examplePolicy())
+    private val closed = BudgetEngine(state).snapshot(now)
+    private val open = BudgetEngine(BudgetEngine(state).open("video", 60, now).state).snapshot(now)
+    private fun attach(t: TestTunnel = target) {
+        engine.register(t.owner)
+        engine.attach(t)
+        assertTrue(engine.installPreferred(t) {})
+    }
+
+    @Test fun bridgeReplacementAndInFlightApplyCannotTransferReceipts() {
+        attach()
+        val old = engine.apply(closed).receipt!!
+        val started = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        target.refresh = { started.countDown(); resume.await(3, SECONDS) }
+        val task = FutureTask { engine.apply(open).receipt }
+        thread { task.run() }
+        assertTrue(started.await(3, SECONDS))
+        val second = TestTunnel()
+        attach(second)
+        engine.unregister(target.owner)
+        engine.detach(target)
+        resume.countDown()
+        assertNull(task.get(3, SECONDS))
+        assertFalse(engine.permits(target, old))
+        assertSame(second, engine.apply(closed).receipt?.target)
+    }
+
+    @Test fun resolverFailureClosesAccessAndOnlySuccessfulRecoveryGetsNewReceipt() {
+        attach()
+        val original = engine.apply(open).receipt!!
+        target.refresh = { error("resolver refused refresh") }
+        assertNull(engine.apply(closed).receipt)
+        assertNull(engine.receipt(target))
+        assertFalse(engine.permits(target, original))
+        assertEquals(2, target.sweeps)
+        target.refresh = {}
+        assertEquals(0L, engine.apply(closed).receipt?.snapshot?.revision)
+    }
+
+    @Test fun timedOutSweepForcesProcessTerminationBeforeRecovery() {
+        attach()
+        assertNotNull(engine.apply(open).receipt)
+        val hanging = CountDownLatch(1)
+        target.close = { hanging.await(3, SECONDS) }
+        try { assertThrows(IllegalStateException::class.java) { engine.apply(closed) } }
+        finally { hanging.countDown() }
+        assertNull(engine.receipt(target))
+        assertEquals(Preferred.FAILED, engine.preferred)
+        assertFalse(engine.installPreferred(target) {})
+    }
+
+    @Test fun failedPreferredAndMissingProtectionNeverActivate() {
+        engine.register(target.owner)
+        engine.attach(target)
+        assertFalse(engine.installPreferred(target) { error("installation failed") })
+        assertNull(engine.apply(open).receipt)
+        assertTrue(engine.installPreferred(target) {})
+        target.probe = { PlatformProtection(true, false, false, true) }
+        assertNull(engine.apply(open).receipt)
+        target.probe = { PlatformProtection(true, true, true, false) }
+        assertNull(engine.apply(open).receipt)
+    }
+
+    @Test fun guardedCallbacksCheckAllDomainsBeforeUpstreamAndRevalidateItsAnswer() {
+        attach()
+        assertNotNull(engine.apply(closed).receipt)
+        fun admit(vararg domains: String): String? = engine.admitted(target, domains.toList()) { "upstream" }
+        assertNull(engine.admitted(target, listOf("video.example.org")) { error("must not delegate") })
+        assertEquals("upstream", admit("accounts.video.example.org"))
+        val ack = engine.apply(open).receipt!!
+        assertEquals("Preferred", ack.resolverId)
+        assertEquals("upstream", admit("video.example.org"))
+        assertNull(admit("video.example.org", "live.video.example.org"))
+        assertNull(admit("pay.accounts.video.example.org"))
+        assertNull(engine.admitted(target, listOf("video.example.org")) {
+            now = now.copy(elapsedMs = open.sites.getValue("video").session!!.deadlineMs)
+            "stale response"
+        })
+        // A delayed alarm cannot authorize a callback after monotonic expiry.
+        assertNull(admit("video.example.org"))
+    }
+
+    @Test fun nativeSweepFailureEscalatesAndCannotRearmTheRetiredEngine() {
+        val e = EngineAdapter({ now }, timers, 100, fatalDisconnect = { throw AssertionError("kernel FD teardown") })
+        val t = object : EngineTarget by target {
+            override fun sweep() = error("native cutoff failed")
+        }
+        e.register(t.owner)
+        e.attach(t)
+        assertTrue(e.installPreferred(t) {})
+        val fatal = assertThrows(AssertionError::class.java) { e.apply(open) }
+        assertEquals("kernel FD teardown", fatal.message)
+        assertFalse(e.installPreferred(t) {})
+        assertNull(e.receipt(t))
+    }
+
+    @Test fun ordinaryTrafficAfterIdleOvernightSleepQueuesOneReset() {
+        attach()
+        assertNotNull(engine.apply(closed).receipt)
+        var resets = 0
+        engine.onDue = { resets++ }
+        // The executor has accumulated zero additional awake time during this sleep.
+        val awakeElapsed = now.elapsedMs
+        now = now.copy(wallMs = now.wallMs + 86400000, elapsedMs = now.elapsedMs + 86400000)
+        assertEquals(7000L, awakeElapsed)
+        assertNull(timers.cutoff)
+        repeat(10) {
+            assertEquals("allow", engine.admitted(target, listOf("ordinary.example")) { "allow" })
+            assertNull(engine.admitted(target, listOf("video.example.org")) { "allow" })
+            assertNull(engine.admitted(target, listOf("news.example.org")) { "allow" })
+        }
+        assertEquals(1, resets)
+        val current = BudgetEngine(state).tick(now).state
+        assertNotNull(engine.apply(BudgetEngine(current).snapshot(now)).receipt)
+        assertEquals("allow", engine.admitted(target, emptyList()) { "allow" })
+        assertEquals(1, resets)
+    }
+
+    @Test fun retiredAlarmCannotSweepNewTargetInstallingPreferred() {
+        attach()
+        assertNotNull(engine.apply(open).receipt)
+        val oldAlarm = timers.cutoff!!
+        val b = TestTunnel(target.owner)
+        engine.attach(b)
+        val entered = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        val install = FutureTask { engine.installPreferred(b) { entered.countDown(); resume.await(6, SECONDS) } }
+        thread { install.run() }
+        try {
+            assertTrue(entered.await(3, SECONDS))
+            b.close = { error("unexpected B sweep") }
+            oldAlarm()
+            assertEquals(0, b.sweeps)
+            resume.countDown()
+            assertTrue(install.get(3, SECONDS))
+        } finally { resume.countDown() }
+    }
+
+    @Test fun nativeCleanupMayOutliveDisconnectButCannotOverlapSuccessorInSameProcess() {
+        val lifetime = NativeProcessLifetime { throw AssertionError("process death") }
+        val owner = Any()
+        lifetime.register(owner)
+        val cleanup = CountDownLatch(1)
+        val delayed = FutureTask { cleanup.await(3, SECONDS); "old global mapper cleared" }
+        lifetime.construct(owner) { thread { delayed.run() } }
+        // Firestack can already report disconnected while this old cleanup is outstanding.
+        assertNull(delayed.takeIf { it.isDone })
+        var constructions = 1
+        try {
+            assertThrows(AssertionError::class.java) { lifetime.retire(owner) }
+            assertThrows(AssertionError::class.java) { lifetime.register(Any()) }
+            assertThrows(AssertionError::class.java) { lifetime.register(owner); lifetime.construct(owner) { constructions++ } }
+            assertEquals(1, constructions)
+        } finally { cleanup.countDown() }
+        assertEquals("old global mapper cleared", delayed.get(3, SECONDS))
+        val newProcess = NativeProcessLifetime { error("unexpected retirement") }
+        newProcess.register(owner)
+        newProcess.construct(owner) { constructions++ }
+        assertEquals(2, constructions)
+    }
+
+    @Test fun partialNativeConstructionAlsoConsumesTheProcessSlot() {
+        val owner = Any()
+        val process = NativeProcessLifetime { throw AssertionError("process death") }
+        process.register(owner)
+        assertThrows(AssertionError::class.java) { process.construct(owner) { error("failed after FD allocation") } }
+        assertThrows(AssertionError::class.java) { process.construct(owner) { fail("second context") } }
+    }
+}

--- /dev/null
+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/AndroidIdnaTest.kt
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class AndroidIdnaTest {
+    @Test fun android13NameprepRejectsUnassignedCharacters() {
+        // Robolectric uses host java.net.IDN. Android 13 libcore delegates to this SDK's
+        // ICU entry point with flags=0 and returns the original label on a nameprep error.
+        val convert = Class.forName("com.android.icu.text.ExtendedIDNA")
+            .getMethod("convertIDNToUnicode", String::class.java, Int::class.javaPrimitiveType)
+        for ((label, expected) in mapOf("xn--e28h" to "xn--e28h", "xn--ls8h" to "xn--ls8h",
+            "xn--caf-dma" to "café", "xn--bcher-kva" to "bücher")) {
+            val actual = try {
+                convert.invoke(null, label, 0).toString()
+            } catch (e: java.lang.reflect.InvocationTargetException) {
+                if (e.cause?.javaClass?.name != "android.icu.text.StringPrepParseException") throw e
+                label
+            }
+            assertEquals(label, expected, actual)
+        }
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/ControllerTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/ControllerTest.kt
new file mode 100644
index 0000000..aa5a781
--- /dev/null
+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/ControllerTest.kt
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonObject
+import java.io.File
+import java.time.ZoneId
+import java.util.UUID
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit.SECONDS
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class ControllerTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val file get() = File(folder.root, "stopscroll/state.json")
+    private var clock = ClockSample(1783850400000, 7000, 12)
+    private val initial get() = JournalState.initial(ZoneId.of("Europe/Belgrade"), clock, examplePolicy())
+    private val target = TestTunnel()
+    private val timers = TestTimers()
+    private val engine = EngineAdapter({ clock }, timers)
+    private val store by lazy { StateStore(file) }
+    private fun controller(source: StateStore = store) =
+        StopscrollController(source, { initial }, { clock }, engine, timers, { target.platform() })
+    private fun attach() {
+        engine.register(target.owner)
+        engine.attach(target)
+        engine.installPreferred(target) {}
+    }
+    private fun request(op: String, revision: Long? = null, minutes: Int = 5) =
+        RpcRequest(UUID.randomUUID().toString(), op, JsonObject().apply {
+            if (op.startsWith("session.")) addProperty("site", "video")
+            if (op == "session.open") addProperty("minutes", minutes)
+        }, revision)
+    private fun RpcReply.code() = json["error"].asJsonObject["code"].asString
+
+    @Test fun reservePrecedesGrantAndRestartReplaysOriginalReply() {
+        attach()
+        val c = controller()
+        c.reconcile()
+        target.refresh = {
+            assertEquals(300, store.read().accounts.getValue("video").session!!.reservedSeconds)
+            assertNull(engine.receipt(target))
+        }
+        val open = request("session.open", 0)
+        val reply = c.execute(open)
+        assertTrue(reply.json.toString(), reply.ok)
+        assertFalse(engine.receipt(target)!!.snapshot.blocks("video.example.org", clock))
+        target.refresh = {}
+        val close = c.execute(request("session.close", 1))
+        assertTrue(close.ok)
+        val replay = controller().execute(open)
+        assertEquals(reply.json, replay.json)
+        assertNull(store.read().accounts["video"]!!.session)
+        assertEquals("CONFLICT", c.execute(open.copy(expectedRevision = 2)).code())
+    }
+
+    @Test fun concurrentUiAndUsbAreOneBudgetAndOneRevision() {
+        attach()
+        val c = controller()
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val replies = (1..2).map { pool.submit<RpcReply> { c.execute(request("session.open", 0)) } }
+                .map { it.get(10, SECONDS) }
+            assertEquals(1, replies.count { it.ok })
+            assertEquals("CONFLICT", replies.single { !it.ok }.code())
+            assertEquals(1L, store.read().revision)
+        } finally { pool.shutdownNow() }
+    }
+
+    @Test fun cutoffSweepsWithoutWaitingForTheWriterAndStaleAlarmCannotSweepAgain() {
+        attach()
+        val entered = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        var stall = false
+        val c = controller(StateStore(file, beforeFinish = {
+            if (stall) {
+                entered.countDown()
+                check(resume.await(10, SECONDS))
+            }
+        }))
+        assertTrue(c.execute(request("session.open", 0)).ok)
+        val alarm = timers.cutoff!!
+        stall = true
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val write = pool.submit<RpcReply> { c.execute(request("session.open", 1)) }
+            assertTrue(entered.await(10, SECONDS))
+            val swept = CountDownLatch(1)
+            target.close = { swept.countDown() }
+            clock = clock.copy(elapsedMs = clock.elapsedMs + 300000)
+            val expiry = pool.submit { alarm() }
+            assertTrue(swept.await(2, SECONDS))
+            assertNull(engine.receipt(target))

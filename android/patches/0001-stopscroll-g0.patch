+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.content.Context
+import android.os.SystemClock
+import com.celzero.bravedns.data.AppConfig
+import com.celzero.bravedns.service.PersistentState
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.concurrent.atomic.AtomicLong
+
+/** Temporary diagnostic state for the signed G0 build. */
+internal object G0Vpn {
+    const val resolverUrl = "https://cloudflare-dns.com/dns-query"
+    const val resolverIps = "1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001"
+
+    data class Saved(val revision: Long, val policy: G0Domains)
+
+    @Volatile var saved = Saved(0L, G0Domains.EMPTY)
+        private set
+    val cutoff = G0Cutoff<G0Tunnel>(SystemClock::elapsedRealtime)
+    val policy get() = saved.policy
+    @Volatile var saveFailed = false
+        private set
+    @Volatile var watch: FlowWatch? = null
+
+    class FlowWatch(val uid: Int) {
+        val tcp = AtomicLong()
+        val udp = AtomicLong()
+        val blocked = AtomicLong()
+
+        fun record(protocol: Int, blockedFlow: Boolean) {
+            when (protocol) {
+                6 -> tcp.incrementAndGet()
+                17 -> udp.incrementAndGet()
+            }
+            if (blockedFlow) blocked.incrementAndGet()
+        }
+    }
+
+    fun configure(state: PersistentState) {
+        state.braveMode = AppConfig.BraveMode.DNS_FIREWALL.mode
+        state.logsEnabled = false
+        state.blocklistEnabled = false
+        state.allowBypass = false
+        state.splitDns = false
+        state.useSystemDnsOnCaptivePortal = false
+        state.useSystemDnsForUndelegatedDomains = false
+        state.defaultDnsUrl = resolverUrl
+        state.dnsType = AppConfig.DnsType.DOH.type
+    }
+
+    fun restore(context: Context) {
+        val text = preferences(context).getString("policy", null) ?: return
+        val json = JSONObject(text)
+        val policy = G0Domains.create(strings(json.getJSONArray("domains")), strings(json.getJSONArray("exceptions")))
+        saved = Saved(json.optLong("revision", 0L), policy)
+    }
+
+    fun durableRevision(): Long? = saved.revision.takeUnless { saveFailed }
+
+    fun replace(context: Context, next: G0Domains) {
+        val revision = saved.revision + 1
+        val json = JSONObject()
+            .put("revision", revision)
+            .put("domains", JSONArray(next.domains))
+            .put("exceptions", JSONArray(next.exceptions))
+        saveFailed = true
+        check(preferences(context).edit().putString("policy", json.toString()).commit()) {
+            "Unable to save G0 domains"
+        }
+        saved = Saved(revision, next)
+        saveFailed = false
+    }
+
+    fun strings(array: JSONArray): List<String> {
+        require(array.length() <= 1_000) { "Too many domain entries" }
+        return List(array.length()) { index ->
+            requireNotNull(array.get(index) as? String) { "Domain entry must be a string" }
+        }
+    }
+
+    private fun preferences(context: Context) = context.getSharedPreferences("stopscroll-g0", Context.MODE_PRIVATE)
+}

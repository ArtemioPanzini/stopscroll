+++ b/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/DailyLifecycleTest.kt
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Application
+import android.app.Notification
+import android.content.Intent
+import android.os.SystemClock
+import com.celzero.bravedns.util.Utilities
+import java.io.File
+import java.time.ZoneId
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE, application = Application::class)
+class DailyLifecycleTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val journal get() = File(folder.root, "stopscroll/state.json")
+    private var clock = ClockSample(1783850400000, 7000, 12)
+    private val zone = ZoneId.of("Europe/Belgrade")
+
+    /** Each instance owns a different native target, timers, controller and file handle. Only the
+     * journal file, simulated OS clock and platform permission survive process replacement. */
+    private inner class Process {
+        val target = TestTunnel()
+        val alarms = TestTimers()
+        var warningAttempts = 0
+        val timers = object : SessionTimers by alarms {
+            override fun warn(site: String) { warningAttempts++; throw SecurityException("POST_NOTIFICATIONS denied") }
+        }
+        val engine = EngineAdapter({ clock }, timers)
+        val client = DailyController(StopscrollController(StateStore(journal),
+            { JournalState.initial(zone, clock, examplePolicy()) }, { clock }, engine, timers,
+            { PlatformProtection(false, true, true, true) }))
+        init { engine.onDue = client::reconcile }
+        fun bindAlwaysOn() {
+            engine.register(target.owner)
+            engine.attach(target)
+            engine.installPreferred(target) {}
+            client.reconcile()
+        }
+        fun status() = DailyStatus.from(client.execute(DailyCommands.status()))
+    }
+
+    private fun advance(seconds: Long) {
+        clock = clock.copy(wallMs = clock.wallMs + seconds * 1000, elapsedMs = clock.elapsedMs + seconds * 1000)
+    }
+
+    @Test fun sameBootRestartRestoresOriginalDeadlineOnlyAfterNewProtectedServiceBinds() {
+        val first = Process()
+        first.bindAlwaysOn()
+        assertTrue(first.client.execute(DailyCommands.session("video", 0, true, 5)).ok)
+        val end = first.client.ending.value!!
+        advance(81)
+        val next = Process()
+        next.client.reconcile()
+        val before = next.status()
+        assertEquals("stopped", before.state)
+        assertNull(before.applied)
+        assertEquals(zone, before.zone)
+        assertEquals(219, before.sites.getValue("video").reserved)
+        next.bindAlwaysOn()
+        assertEquals("active", next.status().state)
+        assertEquals(end, next.client.ending.value)
+        assertEquals(end.elapsedMs, next.status().sites.getValue("video").end)
+        assertFalse(next.engine.receipt(next.target)!!.snapshot.blocks("video.example.org", clock))
+        assertTrue(next.client.execute(DailyCommands.session("video", 1, false)).ok)
+        assertNull(next.client.ending.value)
+    }
+
+    @Test fun firstUnlockedProcessAfterRebootChargesFullReserveAndPublishesClosedRules() {
+        val old = Process()
+        old.bindAlwaysOn()
+        assertTrue(old.client.execute(DailyCommands.session("video", 0, true, 5)).ok)
+        clock = clock.copy(wallMs = clock.wallMs + 90_000, bootCount = 13, elapsedMs = 4000)
+        val unlocked = Process()
+        unlocked.client.reconcile()
+        assertNull(unlocked.client.ending.value)
+        val closed = unlocked.status()
+        assertEquals("stopped", closed.state)
+        assertEquals(zone, closed.zone)
+        assertEquals(0, closed.sites.getValue("video").reserved)
+        assertEquals(45 * 60 - 300, closed.sites.getValue("video").remaining)
+        unlocked.bindAlwaysOn()
+        assertEquals("active", unlocked.status().state)
+        assertTrue(unlocked.engine.receipt(unlocked.target)!!.snapshot.blocks("video.example.org", clock))
+    }
+
+    @Test fun deniedWarningStillSweepsAtDeadlineWithoutActivityOrStatus() {
+        val p = Process()
+        p.bindAlwaysOn()
+        assertTrue(p.client.execute(DailyCommands.session("video", 0, true, 3)).ok)
+        advance(60)
+        p.client.reconcile()
+        assertEquals(1, p.warningAttempts)
+        val sweeps = p.target.sweeps
+        val alarm = p.alarms.cutoff!!
+        advance(120)
+        alarm()
+        assertTrue(p.target.sweeps > sweeps)
+        assertNull(p.client.ending.value)
+        assertTrue(p.engine.receipt(p.target)!!.snapshot.blocks("video.example.org", clock))
+        assertNull(StateStore(journal).read().accounts.getValue("video").session)
+    }
+
+    @Test fun notificationAndInternalConfigureIntentsOpenDailyScreenWithoutSettingsActions() {
+        val context = RuntimeEnvironment.getApplication()
+        val n = StopscrollNotifications.service(context, "test", SessionEnd(SystemClock.elapsedRealtime() + 60000, zone))
+        assertTrue(n.extras.getCharSequence(Notification.EXTRA_TEXT).toString().contains("конец"))
+        assertTrue(n.actions.isNullOrEmpty())
+        val oldSettings = Intent().setClassName(context.packageName, "com.celzero.bravedns.ui.activity.AppLockActivity")
+        val routed = Utilities.getActivityPendingIntent(context, oldSettings, 0, false)
+        listOf(n.contentIntent, routed).forEach {
+            assertTrue(it.isImmutable)
+            val dest = shadowOf(it).savedIntent
+            assertEquals(StopscrollActivity::class.java.name, dest.component!!.className)
+            assertEquals(context.packageName, dest.component!!.packageName)
+            assertNull(dest.extras)
+        }
+        val empty = StopscrollNotifications.service(context, "test", null)
+        assertFalse(empty.extras.getCharSequence(Notification.EXTRA_TEXT).toString().contains("конец"))
+    }
+}

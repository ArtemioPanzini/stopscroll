+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Application
+import android.content.Intent
+import androidx.work.ListenableWorker
+import androidx.work.testing.TestListenableWorkerBuilder
+import com.celzero.bravedns.receiver.BraveAutoStartReceiver
+import com.celzero.bravedns.scheduler.BootStartWorker
+import com.celzero.bravedns.service.PersistentState
+import com.celzero.bravedns.service.VpnController
+import io.mockk.*
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.koin.core.context.startKoin
+import org.koin.core.context.stopKoin
+import org.koin.dsl.module
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE, application = Application::class)
+class DailyStartupTest {
+    @Test fun bootAndUnlockEnqueueRecoveryAndAlwaysOnDefersServiceStartToTheOs() {
+        val app = RuntimeEnvironment.getApplication()
+        val prefs = mockk<PersistentState>(relaxed = true)
+        startKoin { modules(module { single { prefs } }) }
+        mockkObject(BootStartWorker.Companion, VpnController)
+        try {
+            every { prefs.prefAutoStartBootUp } returns true
+            every { BootStartWorker.enqueue(any(), any()) } just Runs
+            val receiver = BraveAutoStartReceiver()
+            receiver.onReceive(app, Intent(Intent.ACTION_BOOT_COMPLETED))
+            receiver.onReceive(app, Intent(Intent.ACTION_USER_UNLOCKED))
+            receiver.onReceive(app, Intent(Intent.ACTION_LOCKED_BOOT_COMPLETED))
+            verify(exactly = 1) { BootStartWorker.enqueue(app, BootStartWorker.BOOT_COMPLETE_EVENT) }
+            verify(exactly = 1) { BootStartWorker.enqueue(app, BootStartWorker.USER_UNLOCKED_EVENT) }
+            confirmVerified(BootStartWorker.Companion)
+
+            every { VpnController.state() } returns mockk { every { activationRequested } returns true }
+            every { VpnController.isAlwaysOn(app) } returns true
+            val worker = TestListenableWorkerBuilder<BootStartWorker>(app).build()
+            assertEquals(ListenableWorker.Result.success(), runBlocking { worker.doWork() })
+            verify(exactly = 1) { VpnController.isAlwaysOn(app) }
+            verify(exactly = 0) { VpnController.start(any(), any()) }
+        } finally {
+            unmockkObject(BootStartWorker.Companion, VpnController)
+            stopKoin()
+        }
+    }
+}
diff --git a/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodecTest.kt b/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodecTest.kt

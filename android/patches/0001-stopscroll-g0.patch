+import com.celzero.bravedns.data.AppConfig
+import com.celzero.bravedns.service.PersistentState
+import com.celzero.bravedns.service.VpnController
+import com.google.gson.JsonObject
+import java.io.File
+import java.time.ZoneId
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledThreadPoolExecutor
+import java.util.concurrent.TimeUnit.MILLISECONDS
+import java.util.concurrent.atomic.AtomicBoolean
+
+internal fun legacyPolicy(raw: String?): Policy {
+    if (raw == null) return Policy.EMPTY
+    val legacy = strictJson(raw).obj()
+    legacy.fields("revision", "domains", "exceptions")
+    legacy["revision"].number(0, Long.MAX_VALUE)
+    val domains = legacy["domains"].array()
+    val exceptions = legacy["exceptions"].array()
+    if (domains.isEmpty && exceptions.isEmpty) return Policy.EMPTY
+    val policy = PolicyCodec.toJson(Policy.EMPTY)
+    policy["sites"].asJsonObject.add("legacy", JsonObject().apply {
+        addProperty("mode", "blocked"); addProperty("budget_min", 0)
+        add("domains", domains); add("exceptions", exceptions)
+    })
+    return PolicyCodec.fromJson(policy)
+}
+
+internal object G0Vpn {
+    const val resolverUrl = "https://cloudflare-dns.com/dns-query"
+    const val resolverIps = "1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001"
+    private lateinit var context: Context
+    // Boot count does not change during one process. Avoid Binder or disk in native callbacks.
+    private var bootCount = -1
+    fun clock() = ClockSample(System.currentTimeMillis(), SystemClock.elapsedRealtime(), bootCount)
+    private val workers = Executors.newSingleThreadExecutor()
+    lateinit var controller: DailyController
+        private set
+    private val timers = AndroidTimers { context }
+    private fun endProcess(): Nothing {
+        // Firestack supplies no join for socket teardown or process-global DNS mapper cleanup.
+        // Kernel process death disposes all FDs, workers and global state together.
+        Process.killProcess(Process.myPid())
+        Runtime.getRuntime().halt(1)
+        error("Process termination returned")
+    }
+
+    val lifetime = NativeProcessLifetime(::endProcess)
+    val cutoff = EngineAdapter(::clock, timers, fatalDisconnect = ::endProcess)
+
+    fun restore(app: Context) {
+        context = app.applicationContext
+        bootCount = Settings.Global.getInt(app.contentResolver, Settings.Global.BOOT_COUNT, -1)
+        controller = DailyController(StopscrollController(StateStore(File(app.filesDir, "stopscroll/state.json")), {
+            val prefs = app.getSharedPreferences("stopscroll-g0", Context.MODE_PRIVATE)
+            val raw = prefs.getString("policy", null)
+            val legacyFile = File(app.applicationInfo.dataDir, "shared_prefs/stopscroll-g0.xml")
+            // SharedPreferences may swallow a malformed XML document and report empty values.
+            check(raw != null || (!legacyFile.exists() && !File(legacyFile.path + ".bak").exists())) {
+                "Existing G0 policy cannot be read"
+            }
+            JournalState.initial(ZoneId.systemDefault(), clock(), legacyPolicy(raw))
+        }, ::clock, cutoff, timers) {
+            PlatformProtection(false, VpnController.isAlwaysOn(app), VpnController.isVpnLockdown(), exempt())
+        })
+        cutoff.onDue = ::reconcileAsync
+        // A trusted calendar adjustment can move the daily boundary before the armed elapsed
+        // deadline. Revoke an expired snapshot before any serialized disk or status work.
+        app.registerReceiver(object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                cutoff.calendarChanged()
+            }
+        }, IntentFilter(Intent.ACTION_TIME_CHANGED))
+        reconcileAsync()
+    }
+
+    fun reconcileAsync() { workers.execute { controller.reconcile() } }
+    fun exempt() = context.getSystemService(PowerManager::class.java).isIgnoringBatteryOptimizations(context.packageName)
+
+    fun configure(state: PersistentState) {
+        state.braveMode = AppConfig.BraveMode.DNS_FIREWALL.mode
+        state.prefAutoStartBootUp = true
+        state.logsEnabled = false
+        state.blocklistEnabled = false
+        state.allowBypass = false
+        state.enableDnsAlg = false
+        state.enableDnsCache = false
+        state.splitDns = false
+        state.useSystemDnsOnCaptivePortal = false
+        state.useSystemDnsForUndelegatedDomains = false
+        state.defaultDnsUrl = resolverUrl
+        state.dnsType = AppConfig.DnsType.DOH.type
+    }
+}
+
+private class AndroidTimers(private val app: () -> Context) : SessionTimers {
+    // Keep slow journal ticks entirely off the cutoff executor.
+    private val cutoffs = ScheduledThreadPoolExecutor(1).apply { removeOnCancelPolicy = true }
+    private val ticks = ScheduledThreadPoolExecutor(1).apply { removeOnCancelPolicy = true }
+    private fun delayTo(due: Long) = (due - SystemClock.elapsedRealtime()).coerceAtLeast(0)
+
+    override fun deadline(elapsedMs: Long, action: () -> Unit): () -> Unit {
+        val power = app().getSystemService(PowerManager::class.java)
+        val wake = power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Stopscroll:SessionDeadline")
+        wake.setReferenceCounted(false)
+        wake.acquire(delayTo(elapsedMs) + 2000)
+        val released = AtomicBoolean()
+        fun release() {
+            if (released.compareAndSet(false, true) && wake.isHeld) wake.release()
+        }
+        val future = try {
+            cutoffs.schedule({ try { action() } finally { release() } }, delayTo(elapsedMs), MILLISECONDS)
+        } catch (e: Exception) { release(); throw e }
+        return { future.cancel(false); release() }
+    }
+
+    override fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit {
+        val future = ticks.schedule({ action(); G0Vpn.controller.refreshEnding() }, delayTo(elapsedMs), MILLISECONDS)
+        return { future.cancel(false) }
+    }
+
+    override fun warn(site: String) {
+        val context = app()
+        val manager = context.getSystemService(NotificationManager::class.java)
+        val channel = "stopscroll_session"
+        manager.createNotificationChannel(NotificationChannel(channel, "Stopscroll sessions", NotificationManager.IMPORTANCE_DEFAULT))
+        val notification = Notification.Builder(context, channel).setSmallIcon(android.R.drawable.ic_lock_idle_alarm)
+            .setContentTitle("Stopscroll").setContentText("Отрезок для $site закончится через две минуты")
+            .setContentIntent(StopscrollNotifications.open(context))
+            .setTimeoutAfter(120000).setAutoCancel(true).build()
+        manager.notify(site, 1, notification)
+    }
+}

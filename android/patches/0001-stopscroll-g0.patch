+    @Test fun firstPacketsAfterSleepReconcileTheDayBeforeTheAwakeTimerFires() {
+        val zone = ZoneId.of("Europe/Belgrade")
+        val oneAm = java.time.ZonedDateTime.of(2026, 11, 18, 1, 0, 0, 0, zone)
+        clock = clock.copy(wallMs = oneAm.toInstant().toEpochMilli())
+        var awakeMs = 1000L
+        var dueAwake = Long.MAX_VALUE
+        var wakeLocks = 0
+        var timer: (() -> Unit)? = null
+        val sleeping = object : SessionTimers by timers {
+            override fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit {
+                dueAwake = awakeMs + elapsedMs - clock.elapsedMs
+                timer = action
+                return {}
+            }
+            override fun deadline(elapsedMs: Long, action: () -> Unit): () -> Unit {
+                wakeLocks++
+                return {}
+            }
+        }
+        val gate = EngineAdapter({ clock }, sleeping)
+        val c = StopscrollController(store, { initial }, { clock }, gate, sleeping, target::platform)
+        var queued = 0
+        gate.onDue = { queued++ }
+        gate.register(target.owner)
+        gate.attach(target)
+        gate.installPreferred(target) {}
+        c.reconcile()
+        val yesterday = store.read().dayId
+        assertEquals(awakeMs + 3 * 3600000, dueAwake)
+        val sleep = 6 * 3600000L
+        awakeMs += 100
+        clock = clock.copy(wallMs = clock.wallMs + sleep + 100, elapsedMs = clock.elapsedMs + sleep + 100)
+        if (awakeMs >= dueAwake) timer!!()
+        assertEquals(yesterday, store.read().dayId)
+        repeat(20) {
+            assertEquals("allow", gate.admitted(target, listOf("ordinary.example")) { "allow" })
+            assertNull(gate.admitted(target, listOf("video.example.org")) { "allow" })
+        }
+        assertEquals(1, queued)
+        c.reconcile()
+        assertEquals(yesterday.plusDays(1), store.read().dayId)
+        assertEquals(0, wakeLocks)
+    }

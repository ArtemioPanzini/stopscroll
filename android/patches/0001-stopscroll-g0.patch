+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class DailyScreenTest {
+    @Test fun schemaStatusUsesItsOwnClockTimezoneAndActualReserve() {
+        val data = strictJson("""
+            {"policy_hash":"abc","timezone":"Europe/Belgrade","day_id":"2026-11-18","reset_hour":4,
+            "default_session_min":15,"clock":{"wall_ms":1795003200000,"elapsed_ms":20000,"boot_count":42},
+            "protection":{"state":"degraded","tunnel":true,"always_on":true,"lockdown":true,
+            "ignoring_battery_optimizations":false,"preferred_state":"ready","reason":"VPN protection is incomplete"},
+            "sites":{"video":{"mode":"limited","budget_min":45,"remaining_sec":2580,"reserved_sec":480,
+            "session":{"start_elapsed_ms":0,"deadline_elapsed_ms":500000}},"news":{"mode":"blocked",
+            "budget_min":0,"remaining_sec":0,"reserved_sec":0,"session":null}}}
+        """).obj()
+        val reply = RpcReply(JsonObject().apply {
+            addProperty("ok",true); addProperty("revision",7); addProperty("applied_revision",null as Number?)
+            add("data",data)
+        })
+        val daily = DailyStatus.from(reply)
+        assertEquals("degraded", daily.state)
+        assertEquals("Europe/Belgrade", daily.zone.id)
+        assertNull(daily.applied)
+        assertEquals(2580, daily.sites.getValue("video").remaining)
+        assertEquals(480, daily.sites.getValue("video").reserved)
+        assertEquals(1795003680000L, daily.endWall(daily.sites.getValue("video").end!!))
+        assertFalse(daily.sites.getValue("news").limited)
+        assertFalse(daily.exempt)
+    }
+
+    @Test fun touchesUseDisplayedRevisionFreshUuidAndExactFiveOperationProtocol() {
+        val open = DailyCommands.session("video", 9L, open = true)
+        assertEquals("session.open", open.op)
+        assertEquals(9L, open.expectedRevision)
+        assertTrue(open.args["minutes"].isJsonNull)
+        val selected = DailyCommands.session("video", 9L, open = true, minutes = 7)
+        assertEquals(7, selected.args["minutes"].asInt)
+        val close = DailyCommands.session("video", 10L, open = false)
+        assertEquals("session.close", close.op)
+        assertEquals(setOf("site"), close.args.keySet())
+        assertEquals(3, setOf(open.requestId, selected.requestId, close.requestId).size)
+    }
+}

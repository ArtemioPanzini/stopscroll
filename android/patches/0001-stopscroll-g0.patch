diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/EngineAdapter.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/EngineAdapter.kt
new file mode 100644
index 0000000..8f75346
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/EngineAdapter.kt
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.util.concurrent.Callable
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit.MILLISECONDS
+import java.util.concurrent.TimeoutException
+
+internal data class PlatformProtection(val tunnel: Boolean, val alwaysOn: Boolean, val lockdown: Boolean, val exempt: Boolean) {
+    val protected get() = tunnel && alwaysOn && lockdown && exempt
+}
+
+internal interface EngineTarget {
+    val owner: Any
+    fun sweep()
+    fun refreshResolver(): String
+    fun platform(): PlatformProtection
+}
+
+internal interface SessionTimers {
+    fun deadline(elapsedMs: Long, action: () -> Unit): () -> Unit
+    fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit
+    fun warn(site: String)
+}
+
+internal data class NativeReceipt(val target: EngineTarget, val snapshot: PolicySnapshot,
+                                 val cutoffMs: Long, val resolverId: String, val generation: Long)
+internal data class AppliedResult(val receipt: NativeReceipt?, val error: String?)
+internal enum class Preferred { PENDING, INSTALLING, READY, FAILED }
+
+/** The short monitor owns the exact native identity, receipt and alarm. Never run JNI, disk,
+ * platform probes, timer setup/cancellation, or controller reconciliation under this monitor. */
+internal class EngineAdapter(
+    private val clock: () -> ClockSample,
+    private val timers: SessionTimers,
+    private val nativeTimeoutMs: Long = 900,
+    private val fatalDisconnect: () -> Nothing = { error("Native tunnel could not be stopped") }
+) {
+    private val native = Executors.newCachedThreadPool { r -> Thread(r, "Stopscroll native").apply { isDaemon = true } }
+    private var service: Any? = null
+    private var generation = 0L
+    private var retired = false
+    @Volatile var target: EngineTarget? = null
+        private set
+    @Volatile var preferred = Preferred.PENDING
+        private set
+    @Volatile var applied: NativeReceipt? = null
+        private set
+    @Volatile var error: String? = null
+        private set
+    @Volatile var lastDue: Long? = null
+        private set
+    @Volatile var lastCutoff: Long? = null
+        private set
+
+    // A receipt can be superseded during a slow save. Keep its alarm armed until a confirmed sweep.
+    private class Alarm(val due: Long, val grant: NativeReceipt) { var cancel: () -> Unit = {} }
+    private var alarm: Alarm? = null
+    private var resetQueued: NativeReceipt? = null
+    var onDue: () -> Unit = {}
+
+    fun receipt(identity: EngineTarget) = applied?.takeIf { it.target === identity }
+    fun permits(identity: EngineTarget, sample: NativeReceipt) = receipt(identity) === sample
+
+    fun <R> admitted(identity: EngineTarget, domains: List<String>, upstream: () -> R?): R? {
+        val receipt = receipt(identity) ?: return null
+        val now = clock()
+        if (!callbackCurrent(receipt, now) || domains.any { receipt.snapshot.blocks(it.trim(), now) }) return null
+        val result = upstream() ?: return null
+        return result.takeIf { permits(identity, receipt) && callbackCurrent(receipt, clock()) }
+    }
+
+    private fun callbackCurrent(receipt: NativeReceipt, now: ClockSample): Boolean {
+        if (receipt.snapshot.validAt(now)) return true
+        if (!receipt.snapshot.closedAcrossReset(now)) return false
+        val queue = synchronized(this) {
+            if (applied !== receipt) return false
+            (resetQueued !== receipt).also { if (it) resetQueued = receipt }
+        }
+        if (queue) onDue()
+        // No active reservations crossed this boundary. The old matcher still enforces every
+        // saved block/exception. Ordinary traffic can proceed while the new day is journaled.
+        return true
+    }
+
+    @Synchronized fun invalidate(reason: String? = null) {
+        generation++
+        applied = null
+        error = reason
+        resetQueued = null
+    }
+
+    private fun changeTarget(next: EngineTarget?) {
+        invalidate()
+        target = next
+        retired = false
+        preferred = Preferred.PENDING
+    }
+    private fun replaceTarget(change: () -> EngineTarget?) {
+        val retired = synchronized(this) {
+            val old = target
+            val next = change()
+            if (old === next) return
+            val oldAlarm = alarm
+            alarm = null
+            changeTarget(next)
+            old to oldAlarm
+        }
+        try { retired.first?.let(::sweep) } finally { retired.second?.cancel?.invoke() }
+    }
+
+    fun register(owner: Any) = replaceTarget { service = owner; null }
+    fun attach(identity: EngineTarget) = replaceTarget { if (service === identity.owner) identity else target }
+    fun detach(identity: EngineTarget) = replaceTarget { target.takeUnless { it === identity } }
+    fun unregister(owner: Any) = replaceTarget {
+        if (service === owner) { service = null; null } else target
+    }
+
+    fun installPreferred(identity: EngineTarget, install: () -> Unit): Boolean {
+        synchronized(this) {
+            if (target !== identity || retired || preferred == Preferred.INSTALLING || preferred == Preferred.READY) return false
+            preferred = Preferred.INSTALLING
+        }
+        val installed = try {
+            bounded(install, timeoutMs = 10000)
+            true
+        } catch (_: TimeoutException) {
+            quarantine(identity, "Preferred resolver installation timed out")
+            return false
+        } catch (_: Exception) { false }
+        synchronized(this) {
+            if (target !== identity || retired) return false
+            preferred = if (installed) Preferred.READY else Preferred.FAILED
+            if (!installed) invalidate("Preferred resolver installation failed")
+        }
+        return installed
+    }
+
+    private fun <T> bounded(block: () -> T, timeoutMs: Long = nativeTimeoutMs): T {
+        val work = native.submit(Callable(block))
+        try { return work.get(timeoutMs, MILLISECONDS) }
+        finally { work.cancel(true) }
+    }
+
+    private fun sweep(identity: EngineTarget): Boolean {
+        try {
+            bounded(identity::sweep)
+            return true
+        } catch (_: Exception) {
+            quarantine(identity, "Native flow cutoff failed")
+            return false
+        }
+    }
+
+    private fun quarantine(identity: EngineTarget, reason: String) {
+        // Neither JNI interruption nor a disconnected flag joins the frozen native handlers.
+        // The one-context construction guard prevents any successor until the process is gone.
+        synchronized(this) {
+            if (target === identity) {
+                retired = true
+                preferred = Preferred.FAILED
+                invalidate(reason)
+            }
+        }
+        fatalDisconnect()
+    }
+
+    fun failClosed(reason: String, expected: NativeReceipt? = null) {
+        val identity = synchronized(this) {
+            if (expected != null && applied !== expected) return
+            invalidate(reason)
+            target
+        }
+        identity?.let(::sweep)
+    }
+
+    private fun expire(expected: Alarm) {
+        synchronized(this) {
+            // Alarm identity binds the original grant generation. A later disk transition can
+            // clear its admission receipt without erasing the still-forwarding sweep obligation.
+            if (alarm !== expected || target !== expected.grant.target) return
+            alarm = null
+            lastDue = expected.due
+            invalidate()
+        }
+        if (sweep(expected.grant.target)) lastCutoff = clock().elapsedMs
+        onDue()
+    }
+
+    fun calendarChanged() {
+        val obligation = synchronized(this) {
+            // Also veto any in-progress grant whose elapsed cutoff was computed on the old clock.
+            invalidate()
+            alarm.also {
+                alarm = null
+                if (it != null) lastDue = clock().elapsedMs
+            }
+        }
+        if (obligation != null) try {
+            if (sweep(obligation.grant.target)) lastCutoff = clock().elapsedMs
+        } finally { obligation.cancel() }
+        onDue()
+    }
+
+    @Synchronized fun authorizeOutcome(receipt: NativeReceipt): Boolean =
+        applied === receipt && generation == receipt.generation && receipt.snapshot.validAt(clock())
+
+    fun confirm(receipt: NativeReceipt): Boolean {
+        if (applied !== receipt) return false
+        val protected = try { bounded(receipt.target::platform).protected } catch (_: Exception) { false }
+        return protected && applied === receipt && receipt.snapshot.validAt(clock())
+    }
+
+    fun apply(snapshot: PolicySnapshot): AppliedResult {
+        val receipt = activate(snapshot)
+        val reason = if (receipt != null) null else error ?: "No current protected VPN receipt"
+        return AppliedResult(receipt, reason)
+    }
+
+    private fun activate(snapshot: PolicySnapshot): NativeReceipt? {
+        val identity: EngineTarget
+        val ticket: Long
+        synchronized(this) {
+            applied?.let { if (it.snapshot.revision == snapshot.revision) return it }
+            identity = target ?: return null
+            if (preferred != Preferred.READY) return null
+            invalidate()
+            ticket = generation
+        }
+        if (!sweep(identity)) return null
+        val swept = clock().elapsedMs
+        synchronized(this) {
+            alarm?.takeIf { it.due <= swept }?.let {
+                lastDue = it.due
+                lastCutoff = swept
+            }
+        }
+        val resolverId: String
+        val problem = try {
+            resolverId = bounded(identity::refreshResolver)
+            if (bounded(identity::platform).protected) null else "VPN protection is incomplete"
+        } catch (_: TimeoutException) {
+            quarantine(identity, "Native resolver or protection probe timed out")
+            return null
+        } catch (_: Exception) {
+            synchronized(this) { if (generation == ticket) invalidate("Native resolver or VPN protection is unconfirmed") }
+            return null
+        }
+        if (problem != null) {
+            synchronized(this) { if (generation == ticket) invalidate(problem) }
+            return null
+        }
+        val sampled = clock()
+        val due = snapshot.cutoffAt(sampled)
+        val candidate = NativeReceipt(identity, snapshot, swept, resolverId, ticket)
+        val next = due?.let { Alarm(it, candidate) }
+        // Install while closed. Even a delayed timer setup can never publish an expired grant.
+        if (next != null) try {
+            next.cancel = timers.deadline(next.due) { expire(next) }
+        } catch (_: Exception) {
+            synchronized(this) { if (generation == ticket) invalidate("Cannot arm the protected session deadline") }
+            return null
+        }
+        var previous: Alarm? = null
+        val result = synchronized(this) {
+            val now = clock()
+            if (generation != ticket || target !== identity || !snapshot.validAt(now) ||
+                (next != null && now.elapsedMs >= next.due)) null
+            else {
+                previous = alarm
+                alarm = next
+                candidate.also { applied = it }
+            }
+        }
+        if (result == null) next?.cancel?.invoke() else previous?.cancel?.invoke()
+        return result
+    }
+}

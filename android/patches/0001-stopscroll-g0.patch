+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.content.ContentProviderOperation
+import android.content.ContentProviderResult
+import android.content.ContentValues
+import android.content.res.AssetFileDescriptor
+import android.database.Cursor
+import android.net.Uri
+import android.os.Bundle
+import android.os.CancellationSignal
+import android.os.ParcelFileDescriptor
+
+/** The only exposed operation is a schema-1 RPC from the Android shell UID. */
+class UsbControlProvider internal constructor(
+    private val execute: (RpcRequest) -> RpcReply
+) : ShellCallProvider() {
+    constructor() : this({ request -> G0Vpn.controller.execute(request) })
+
+    override fun onCreate() = true
+
+    override fun callFromShell(method: String?, arg: String?): Bundle {
+        if (method != "rpc") throw UnsupportedOperationException("Stopscroll supports the rpc call only")
+        val request = try {
+            RpcCodec.decodeRequest(arg)
+        } catch (e: RpcDecodeException) {
+            return result(RpcCodec.encodeFailure(e.requestId, e.code, e.message ?: e.code))
+        }
+
+        val reply = execute(request)
+        val encoded = try {
+            RpcCodec.encodeReply(request.requestId, reply.json)
+        } catch (e: PolicyException) {
+            if (e.code == "TOO_LARGE") {
+                // Size is checked after validating the envelope and its saved revision.
+                RpcCodec.encodeFailure(request.requestId, e.code, "Reply exceeds 96 KiB", reply.json["revision"].asLong)
+            } else {
+                RpcCodec.encodeFailure(request.requestId, "INVALID_RESPONSE", "Unable to encode the Stopscroll reply")
+            }
+        }
+        return result(encoded)
+    }
+
+    private fun result(encoded: String) = Bundle().apply { putString("result_b64", encoded) }
+
+    private fun unsupported(): Nothing {
+        requireShell()
+        throw UnsupportedOperationException("Stopscroll supports the rpc call only")
+    }
+
+    override fun query(
+        uri: Uri, projection: Array<out String>?, selection: String?,
+        selectionArgs: Array<out String>?, sortOrder: String?
+    ): Cursor? = unsupported()
+
+    override fun query(
+        uri: Uri, projection: Array<out String>?, selection: String?,
+        selectionArgs: Array<out String>?, sortOrder: String?, cancellationSignal: CancellationSignal?
+    ): Cursor? = unsupported()
+
+    override fun query(
+        uri: Uri, projection: Array<out String>?, queryArgs: Bundle?, cancellationSignal: CancellationSignal?
+    ): Cursor? = unsupported()
+
+    override fun getType(uri: Uri): String? = unsupported()
+    override fun getTypeAnonymous(uri: Uri): String? = unsupported()
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = unsupported()
+    override fun insert(uri: Uri, values: ContentValues?, extras: Bundle?): Uri? = unsupported()
+    override fun bulkInsert(uri: Uri, values: Array<out ContentValues>): Int = unsupported()
+
+    override fun update(
+        uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?
+    ): Int = unsupported()
+
+    override fun update(uri: Uri, values: ContentValues?, extras: Bundle?): Int = unsupported()
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = unsupported()
+    override fun delete(uri: Uri, extras: Bundle?): Int = unsupported()
+
+    override fun applyBatch(operations: ArrayList<ContentProviderOperation>): Array<ContentProviderResult> = unsupported()
+
+    override fun applyBatch(
+        authority: String, operations: ArrayList<ContentProviderOperation>
+    ): Array<ContentProviderResult> = unsupported()
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor = unsupported()
+
+    override fun openFile(
+        uri: Uri, mode: String, signal: CancellationSignal?
+    ): ParcelFileDescriptor = unsupported()
+
+    override fun openAssetFile(uri: Uri, mode: String): AssetFileDescriptor = unsupported()
+
+    override fun openAssetFile(
+        uri: Uri, mode: String, signal: CancellationSignal?
+    ): AssetFileDescriptor = unsupported()
+
+    override fun openTypedAssetFile(uri: Uri, mimeTypeFilter: String, opts: Bundle?): AssetFileDescriptor =
+        unsupported()
+
+    override fun openTypedAssetFile(
+        uri: Uri, mimeTypeFilter: String, opts: Bundle?, signal: CancellationSignal?
+    ): AssetFileDescriptor = unsupported()
+
+    override fun getStreamTypes(uri: Uri, mimeTypeFilter: String): Array<String>? = unsupported()
+    override fun canonicalize(uri: Uri): Uri? = unsupported()
+    override fun uncanonicalize(uri: Uri): Uri? = unsupported()
+    override fun refresh(uri: Uri, args: Bundle?, signal: CancellationSignal?): Boolean = unsupported()
+}

+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import org.json.JSONArray
+import org.json.JSONObject
+import org.koin.core.component.KoinComponent
+import org.koin.core.component.inject
+import java.nio.ByteBuffer
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** G0 acceptance hooks, reachable only through the Android shell UID. */
+class UsbControlProvider : ContentProvider(), KoinComponent {
+    private val persistentState by inject<PersistentState>()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val gate = G0Vpn.cutoff
+    private val deadlines = G0Deadlines<G0Tunnel, Deadline>(gate)
+
+    private class Deadline(val due: Long, val lock: PowerManager.WakeLock) {
+        lateinit var job: Job
+        private val released = AtomicBoolean()
+        fun release() {
+            if (released.compareAndSet(false, true) && lock.isHeld) lock.release()
+        }
+        fun cancel() {
+            job.cancel()
+            release()
+        }
+    }
+
+    override fun onCreate() = true
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        val uid = requireShell()
+        require(method == "rpc") { "Expected rpc method" }
+        val reply = try {
+            dispatch(requireNotNull(context), decode(arg))
+        } catch (_: Exception) {
+            JSONObject().put("ok", false).put("error", "G0 request failed")
+        }.put("uid", uid)
+        return Bundle().apply {
+            putString("result_b64", Base64.encodeToString(reply.toString().toByteArray(Charsets.UTF_8), Base64.NO_WRAP))
+        }
+    }
+
+    private fun dispatch(app: Context, request: JSONObject): JSONObject {
+        val op = request.get("op") as? String
+        when (op) {
+            "status" -> Unit
+            "enable" -> app.startActivity(Intent(app, G0VpnActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            "watchUid" -> {
+                val uid = number(request, "uid")
+                require(uid == -1L || uid in 10_000L..99_999L)
+                G0Vpn.watch = if (uid < 0) null else G0Vpn.FlowWatch(uid.toInt())
+            }
+            "blockDomains", "closeAll", "setAlg", "timedBlock" -> {
+                val before = gate.state
+                val live = gate.protectedTarget() ?: return refused(app)
+                if (before.target !== live) return refused(app)
+                when (op) {
+                    "timedBlock" -> {
+                        val duration = number(request, "duration_ms")
+                        require(duration in 1L..120_000L)
+                        if (!scheduleBlock(app, policy(request), duration, before)) return refused(app)
+                    }
+                    "setAlg" -> {
+                        val enabled = request.get("enabled") as? Boolean ?: error("Expected boolean")
+                        if (!setAlg(live, before, enabled)) return refused(app)
+                    }
+                    else -> {
+                        val next = if (op == "blockDomains") policy(request) else null
+                        val (oldTimer, claim) = synchronized(gate) {
+                            if (gate.state !== before || before.changing) null to null
+                            else {
+                                val old = if (next != null) deadlines.clear() else null
+                                old to gate.begin(live)
+                            }
+                        }
+                        if (claim == null) return refused(app)
+                        val applied = try { transition(app, claim, next) } finally { oldTimer?.cancel() }
+                        if (!applied) return status(app).put("ok", false)
+                    }
+                }
+            }
+            else -> throw IllegalArgumentException("Unknown G0 operation")
+        }
+        return status(app)
+    }
+
+    private fun refused(app: Context) = status(app).put("ok", false)
+        .put("error", "Active Always-on VPN with lockdown and a current tunnel are required")
+
+    private fun setAlg(live: G0Tunnel, before: G0Cutoff.State<G0Tunnel>, enabled: Boolean): Boolean =
+        gate.updateAlg(live, before, enabled, { persistentState.enableDnsAlg }, live.adapter::g0SetAlg) {
+            persistentState.enableDnsAlg = it
+        }
+
+    private fun transition(app: Context, claim: G0Cutoff.Claim<G0Tunnel>, policy: G0Domains?): Boolean =
+        gate.complete(claim) {
+            if (policy != null) G0Vpn.replace(app, policy)
+            G0Vpn.durableRevision()
+        }
+
+    private fun scheduleBlock(app: Context, policy: G0Domains, duration: Long,
+                              before: G0Cutoff.State<G0Tunnel>): Boolean {
+        val power = app.getSystemService(PowerManager::class.java)
+        val lock = power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Stopscroll:G0Deadline")
+        lock.setReferenceCounted(false)
+        lock.acquire(duration + 2_000L)
+        val next = Deadline(SystemClock.elapsedRealtime() + duration, lock)
+        next.job = scope.launch(start = CoroutineStart.LAZY) {
+            try {
+                delay((next.due - SystemClock.elapsedRealtime()).coerceAtLeast(0L))
+                val claim = deadlines.claim(next, next.due) ?: return@launch
+                transition(app, claim, policy)
+            } finally {
+                next.release()
+            }
+        }
+        val old = deadlines.arm(before, next)
+        if (old === next) {
+            next.cancel()
+            return false
+        }
+        next.job.start()
+        old?.cancel()
+        return true
+    }
+
+    private fun status(app: Context): JSONObject {
+        // Slow Android/native calls finish before taking the receipt snapshot. A replacement
+        // during any query cannot inherit the sampled adapter's platform protection or stats.
+        val live = gate.state.target
+        val response = JSONObject()
+            .put("always_on", VpnController.isAlwaysOn(app))
+            .put("lockdown", VpnController.isVpnLockdown())
+            .put("mode", "dns_firewall")
+            .put("resolver", G0Vpn.resolverUrl)
+            .put("bootstrap", G0Vpn.resolverIps)
+            .put("dns_cache", persistentState.enableDnsCache)
+            .put("logs_enabled", persistentState.logsEnabled)
+            .put("ignoring_battery_optimizations", app.getSystemService(PowerManager::class.java)
+                .isIgnoringBatteryOptimizations(app.packageName))
+        val info = try { live?.adapter?.g0DnsInfo() } catch (_: Exception) { null }
+        val active = live?.adapter?.hasTunnel() == true
+        val platform = active && live != null && gate.protectedTarget(live) === live
+        val currentTimer = synchronized(gate) { deadlines.pending }
+        val held = currentTimer?.lock?.isHeld == true
+        val (configuredAlg, snapshot) = gate.withAlgLock {
+            val configured = persistentState.enableDnsAlg
+            configured to synchronized(gate) { Triple(gate.state, deadlines.pending, G0Vpn.saved) }
+        }
+        val (s, deadline, saved) = snapshot
+        val same = live != null && s.target === live
+        val protected = same && platform && s.appliedRevision != null
+        val error = s.error ?: when {
+            s.target != null && s.preferred != G0Cutoff.Preferred.READY -> "Preferred DNS is ${s.preferred.name.lowercase()}"
+            s.target != null && !protected -> "No protected native receipt"
+            else -> null
+        }
+        response.put("ok", error == null)
+            .put("tunnel", same && active)
+            .put("protected", protected)
+            .put("dns_alg", if (s.algUncertain) JSONObject.NULL else configuredAlg)
+            .put("dns_alg_confirmed", same && s.preferred == G0Cutoff.Preferred.READY && !s.algUncertain)
+            .put("saved_revision", saved.revision)
+            .put("applied_revision", s.appliedRevision?.takeIf { protected } ?: JSONObject.NULL)
+            .put("cutoff_generation", s.generation)
+            .put("admission_closed", s.appliedRevision == null)
+            .put("preferred_state", s.preferred.name.lowercase())
+            .put("last_transition_due_elapsed_ms", s.due ?: JSONObject.NULL)
+            .put("last_transition_trigger_elapsed_ms", s.trigger ?: JSONObject.NULL)
+            .put("last_cutoff_elapsed_ms", s.cutoff ?: JSONObject.NULL)
+            .put("domains", JSONArray(saved.policy.domains))
+            .put("exceptions", JSONArray(saved.policy.exceptions))
+            .put("deadline_elapsed_ms", deadline?.due ?: 0L)
+            .put("now_elapsed_ms", SystemClock.elapsedRealtime())
+            .put("wake_lock_held", deadline === currentTimer && held)
+            .put("last_close_call_ms", s.closeMs ?: JSONObject.NULL)
+            .put("error", error ?: JSONObject.NULL)
+        if (same && info != null) {
+            response.put("native_preferred_dns", info.dnsPreferred)
+                .put("native_default_dns", info.dnsDefault)
+                .put("native_fallback", info.defaultDNSAsFallback)
+        }
+        G0Vpn.watch?.let {
+            response.put("watched_uid", it.uid)
+                .put("watched_tcp", it.tcp.get())
+                .put("watched_udp", it.udp.get())
+                .put("watched_blocked", it.blocked.get())
+        }
+        return response
+    }
+
+    private fun policy(request: JSONObject): G0Domains {
+        val domains = G0Vpn.strings(request.getJSONArray("domains"))
+        val exceptions = if (request.has("exceptions")) G0Vpn.strings(request.getJSONArray("exceptions")) else emptyList()
+        return G0Domains.create(domains, exceptions)
+    }
+
+    private fun number(request: JSONObject, key: String): Long = when (val value = request.get(key)) {
+        is Int -> value.toLong()
+        is Long -> value
+        else -> throw IllegalArgumentException("Expected integer")
+    }
+
+    private fun decode(arg: String?): JSONObject {
+        val encoded = requireNotNull(arg)
+        require(encoded.length <= REQUEST_LIMIT / 3 * 4)
+        val decoded = Base64.decode(encoded, Base64.NO_WRAP)
+        require(decoded.size <= REQUEST_LIMIT)
+        return JSONObject(Charsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(decoded)).toString())
+    }
+
+    private fun requireShell(): Int = Binder.getCallingUid().also {
+        if (it != 2_000) throw SecurityException("Stopscroll USB control requires shell UID 2000")
+    }
+
+    private fun unsupported(): Nothing {
+        requireShell()
+        throw UnsupportedOperationException("Stopscroll supports content call only")
+    }
+
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?, selectionArgs: Array<out String>?, sortOrder: String?): Cursor? = unsupported()
+    override fun getType(uri: Uri): String? = unsupported()
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = unsupported()
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?): Int = unsupported()
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = unsupported()
+
+    companion object {
+        private const val REQUEST_LIMIT = 96 * 1024
+    }
+}

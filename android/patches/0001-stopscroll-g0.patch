+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import java.security.MessageDigest
+
+internal class PolicyException(val code: String, message: String) : IllegalArgumentException(message)
+internal fun invalid(reason: String): Nothing = throw PolicyException("INVALID_REQUEST", reason)
+internal fun oversized(reason: String): Nothing = throw PolicyException("TOO_LARGE", reason)
+internal val siteId = Regex("[a-z][a-z0-9]{0,23}")
+internal fun sha256(bytes: ByteArray): String =
+    MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+internal data class SitePolicy(
+    val limited: Boolean,
+    val budgetMin: Int,
+    val domains: ImmutableList<String>,
+    val exceptions: ImmutableList<String>
+)
+
+internal data class Policy(val defaultSessionMin: Int, val sites: ImmutableMap<String, SitePolicy>) {
+    val hash: String by lazy { sha256(PolicyCodec.encode(this).toByteArray()) }
+    companion object {
+        val EMPTY = Policy(15, ImmutableMap.of())
+    }
+}

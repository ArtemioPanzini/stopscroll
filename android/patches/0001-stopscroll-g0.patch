@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+/** A native context may leave async handlers and process-global cleanup pending even after
+ * disconnect. A JVM/process has one construction slot, consumed before entering the constructor. */
+internal class NativeProcessLifetime(private val endProcess: () -> Nothing) {
+    private var service: Any? = null
+    private var constructedFor: Any? = null
+
+    @Synchronized fun register(owner: Any) {
+        if (constructedFor != null && constructedFor !== owner) endProcess()
+        service = owner
+    }
+
+    fun <T> construct(owner: Any, create: () -> T): T {
+        synchronized(this) {
+            check(service === owner) { "Retired VPN service" }
+            if (constructedFor != null) endProcess()
+            constructedFor = owner
+        }
+        return try { create() } catch (_: Throwable) {
+            // Even a constructor that throws may already have allocated native FDs/cleanup.
+            endProcess()
+        }
+    }
+
+    @Synchronized fun retire(owner: Any) {
+        if (service === owner) service = null
+        if (constructedFor === owner) endProcess()
+    }
+}

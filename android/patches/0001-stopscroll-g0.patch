@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Notification
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.SystemClock
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+internal data class SessionEnd(val elapsedMs: Long, val timezone: ZoneId)
+
+/** Process-local notification projection. The controller remains the only journal and policy writer. */
+internal class DailyController(private val core: StopscrollController) {
+    private val nearest = MutableStateFlow<SessionEnd?>(null)
+    val ending = nearest.asStateFlow()
+
+    fun execute(request: RpcRequest) = core.execute(request).also { refreshEnding() }
+    fun reconcile() { core.reconcile(); refreshEnding() }
+
+    @Synchronized fun refreshEnding() {
+        val snap = try { core.snapshot() } catch (_: IllegalStateException) { null }
+        nearest.value = snap?.sites?.values?.mapNotNull { it.session?.deadlineMs }?.minOrNull()?.let {
+            SessionEnd(it, snap.timezone)
+        }
+    }
+}
+
+internal object StopscrollNotifications {
+    private const val DAILY = "com.celzero.bravedns.stopscroll.StopscrollActivity"
+    fun open(context: Context): PendingIntent {
+        val intent = Intent().setClassName(context.packageName, DAILY)
+            .addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+        return PendingIntent.getActivity(context, 0, intent, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+    }
+
+    fun service(context: Context, channel: String, end: SessionEnd?): Notification {
+        val until = end?.let {
+            val left = it.elapsedMs - SystemClock.elapsedRealtime()
+            if (left <= 0) null else Instant.ofEpochMilli(System.currentTimeMillis() + left)
+                .atZone(it.timezone).format(DateTimeFormatter.ofPattern("HH:mm:ss z"))
+        }
+        return Notification.Builder(context, channel).setSmallIcon(com.celzero.bravedns.R.drawable.ic_notification_icon)
+            .setContentTitle("Stopscroll · служба VPN")
+            .setContentText(if (until == null) "Открыть состояние защиты" else "Ближайший конец отрезка в $until")
+            .setContentIntent(open(context)).setOngoing(true).setOnlyAlertOnce(true)
+            .setVisibility(Notification.VISIBILITY_PRIVATE).build()
+    }
+}

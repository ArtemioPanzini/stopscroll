+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.os.ParcelFileDescriptor
+import com.celzero.bravedns.util.Logger
+import java.io.IOException
+
+internal inline fun <T> withVpnDescriptor(descriptor: ParcelFileDescriptor, stopscroll: Boolean,
+                                          relaxed: Boolean, hasAdapter: Boolean, setDup: (Boolean) -> Unit,
+                                          transfer: (Long) -> T): T {
+    val duplicate = stopscroll || !relaxed
+    try {
+        val fd = if (duplicate) descriptor.fd else descriptor.detachFd()
+        if (stopscroll || hasAdapter) setDup(duplicate)
+        return transfer(fd.toLong())
+    } finally {
+        if (duplicate) try {
+            descriptor.close()
+        } catch (e: IOException) {
+            if (stopscroll) throw e
+            Logger.e(Logger.LOG_TAG_VPN, "err closing tunFd: ${e.message}", e)
+        }
+    }
+}

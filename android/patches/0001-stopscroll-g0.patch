+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.os.ParcelFileDescriptor
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class VpnDescriptorTest {
+    private fun transfer(relaxed: Boolean, hasAdapter: Boolean, initialDup: Boolean, failed: Boolean) {
+        val (read, write) = ParcelFileDescriptor.createPipe()
+        var nativeDup = initialDup
+        val set = mutableListOf<Boolean>()
+        val javaFd = read.fileDescriptor
+        try {
+            fun run() = withVpnDescriptor(read, true, relaxed, hasAdapter, {
+                set.add(it); nativeDup = it
+            }) { fd ->
+                assertTrue(javaFd.valid())
+                assertTrue(fd >= 0)
+                assertEquals(listOf(true), set)
+                assertTrue(nativeDup)
+                if (failed) throw IllegalStateException("link failed")
+            }
+            if (failed) assertThrows(IllegalStateException::class.java) { run() } else run()
+            assertFalse(javaFd.valid())
+        } finally { read.close(); write.close() }
+    }
+
+    @Test fun coldRelaxedConstructorBorrowsAndClosesJavaFd() = transfer(true, false, true, false)
+    @Test fun previousTakeOwnershipModeIsOverwrittenBeforeColdConstruction() = transfer(false, false, false, false)
+    @Test fun failedColdConstructionClosesJavaOriginal() = transfer(true, false, false, true)
+    @Test fun failedRelaxedRelinkStillClosesJavaOriginal() = transfer(true, true, false, true)
+}

@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.celzero.bravedns.net.go.GoVpnAdapter
+import com.celzero.bravedns.service.BraveVPNService
+import com.celzero.firestack.backend.Backend
+import com.celzero.firestack.backend.DNSOpts
+import com.celzero.firestack.intra.Bridge
+import com.celzero.firestack.intra.Mark
+
+/** A native callback retains this bridge even if its service later publishes another adapter. */
+internal class G0Tunnel(override val owner: BraveVPNService) : Bridge by owner, EngineTarget {
+    lateinit var adapter: GoVpnAdapter
+        private set
+
+    fun attach(created: GoVpnAdapter) {
+        adapter = created
+        G0Vpn.cutoff.attach(this)
+    }
+
+    override fun sweep() = adapter.g0Sweep()
+    override fun refreshResolver() = adapter.g0RefreshResolver()
+    override fun platform() = PlatformProtection(adapter.hasTunnel(), owner.isAlwaysOn,
+        owner.isLockdownEnabled, G0Vpn.exempt())
+
+    override fun flow(protocol: Int, uid: Int, src: String?, dst: String?, realIps: String?,
+                      domains: String?, probable: String?, blocklists: String?, isAlg: Boolean): Mark {
+        return G0Vpn.cutoff.admitted(this, domains.orEmpty().split(',')) {
+            owner.flow(protocol, uid, src, dst, realIps, domains, probable, blocklists, isAlg)
+                .takeUnless { it.pidcsv.isNullOrBlank() }
+        } ?: blocked(uid)
+    }
+
+    override fun inflow(protocol: Int, uid: Int, src: String?, dst: String?): Mark =
+        G0Vpn.cutoff.admitted(this, emptyList()) {
+            owner.inflow(protocol, uid, src, dst).takeUnless { it.pidcsv.isNullOrBlank() }
+        } ?: blocked(uid)
+
+    private fun blocked(flowUid: Int) = Mark().apply {
+        uid = flowUid.toString()
+        pidcsv = Backend.Block
+    }
+
+    override fun onQuery(origin: String, uidGostr: String, fqdn: String, qtype: Long): DNSOpts {
+        return G0Vpn.cutoff.admitted(this, listOf(fqdn)) {
+            owner.onQuery(origin, uidGostr, fqdn, qtype).takeUnless { it.tidcsv.isNullOrBlank() }
+        } ?: DNSOpts().apply { uid = uidGostr; tidcsv = "${Backend.BlockAll}:${Backend.Base}" }
+    }
+}

+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.content.Intent
+import android.net.VpnService
+import android.os.Bundle
+import com.celzero.bravedns.R
+import com.celzero.bravedns.service.VpnController
+
+/** VPN permission must be granted by the device owner through Android's consent activity. */
+class G0VpnActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (savedInstanceState != null) return
+        AlertDialog.Builder(this)
+            .setTitle(R.string.stopscroll_g0_title)
+            .setMessage(getString(R.string.stopscroll_g0_resolver, G0Vpn.resolverUrl))
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val prepare = VpnService.prepare(this)
+                if (prepare == null) {
+                    startVpn()
+                } else {
+                    @Suppress("DEPRECATION")
+                    startActivityForResult(prepare, REQUEST_VPN)
+                }
+            }
+            .setNegativeButton(android.R.string.cancel) { _, _ -> finish() }
+            .setOnCancelListener { finish() }
+            .show()
+    }
+
+    @Deprecated("Android compatibility callback for the system VPN consent screen")
+    @Suppress("DEPRECATION")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        if (requestCode != REQUEST_VPN) return
+        if (resultCode == RESULT_OK) startVpn() else finish()
+    }
+
+    private fun startVpn() {
+        VpnController.start(this)
+        finish()
+    }
+
+    companion object {
+        private const val REQUEST_VPN = 1
+    }
+}

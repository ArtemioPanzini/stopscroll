+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.io.File
+import java.io.IOException
+import java.time.ZoneId
+import java.util.concurrent.Executors
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class StateStoreTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val clock = ClockSample(1783850400000, 7000, 12)
+    private val initial get() = JournalState.initial(ZoneId.of("Europe/Belgrade"), clock, examplePolicy())
+    private val file get() = File(folder.root, "stopscroll/state.json")
+
+    @Test fun reloadAndOnlyReturnGrantAfterVerifiedSave() {
+        val store = StateStore(file)
+        assertEquals(initial, store.loadOrCreate { initial })
+        val granted = store.update { BudgetEngine(it).open("video", 600, clock) }
+        assertEquals(listOf(EffectKind.OPEN), granted.effects.map { it.kind })
+        val restart = StateStore(file).loadOrCreate { error("unexpected initialization") }
+        assertEquals(granted.state, restart)
+        assertEquals(600, BudgetEngine(restart).snapshot(clock).sites.getValue("video").reservedSeconds)
+    }
+
+    @Test fun failedWriteAndSilentRenameFailureBothKeepOldBudgetAndNoGrant() {
+        val store = StateStore(file)
+        store.loadOrCreate { initial }
+        for ((expected, fault) in listOf<Pair<String, () -> Unit>>(
+            "injected write failure" to { throw IOException("injected write failure") },
+            "Journal commit did not publish expected bytes" to {
+            // Android 13 AtomicFile.finishWrite logs a failed rename and returns normally.
+            assertTrue(File(file.path + ".new").delete())
+        })) {
+            val broken = StateStore(file, beforeFinish = fault)
+            val grants = mutableListOf<Effect>()
+            val failure = assertThrows(IOException::class.java) {
+                grants.addAll(broken.update { BudgetEngine(it).open("video", 120, clock) }.effects)
+            }
+            assertEquals(expected, failure.cause?.message)
+            assertTrue(grants.isEmpty())
+            assertEquals(initial, store.read())
+        }
+    }
+
+    @Test fun corruptionAndOrphanedFirstWriteNeverInitializeEmpty() {
+        file.parentFile!!.mkdirs()
+        file.writeText("corrupt")
+        File(file.path + ".bak").writeText("also corrupt")
+        val store = StateStore(file)
+        assertThrows(IOException::class.java) { store.loadOrCreate { error("unexpected initialization") } }
+        assertThrows(IOException::class.java) { store.update { BudgetEngine(it).open("video", 60, clock) } }
+        file.delete()
+        File(file.path + ".new").writeBytes(JournalCodec.encode(initial))
+        assertThrows(IOException::class.java) { store.loadOrCreate { error("unexpected initialization") } }
+    }
+
+    @Test fun serializesConcurrentReservations() {
+        val store = StateStore(file)
+        store.loadOrCreate { initial }
+        val pool = Executors.newFixedThreadPool(4)
+        try {
+            val results = (1..8).map { pool.submit<Transition> { store.update { BudgetEngine(it).open("video", 60, clock) } } }.map { it.get() }
+            assertEquals(1, results.count { it.error == null })
+            assertEquals(7, results.count { it.error == "SESSION_ACTIVE" })
+            assertEquals(1L, store.read().revision)
+        } finally {
+            pool.shutdownNow()
+        }
+    }
+
+    @Test fun validLegacyBackupAndCorruptedButParseablePrimary() {
+        val store = StateStore(file)
+        store.loadOrCreate { initial }
+        val good = file.readText()
+        file.writeText(good.replace("\"spent\":0", "\"spent\":5"))
+        assertThrows(IOException::class.java) { store.read() }
+        File(file.path + ".bak").writeText(good)
+        assertEquals(initial, store.read())
+    }
+
+    @Test fun retainsOnlyLast64ReceiptsAcrossRestartAndRollover() {
+        val store = StateStore(file)
+        store.loadOrCreate { initial }
+        val replies = (1..65).map {
+            MutationReceipt(java.util.UUID(0, it.toLong()).toString(), "a".repeat(64), "{\"n\":$it}")
+        }
+        store.update { state -> Transition(replies.fold(state) { s, r -> s.withReceipt(r) }, emptyList()) }
+        assertEquals(replies.drop(1), StateStore(file).read().receipts)
+        val next = store.update { BudgetEngine(it).tick(clock.copy(wallMs = clock.wallMs + 86400000)) }
+        assertEquals(replies.drop(1), next.state.receipts)
+        assertThrows(IOException::class.java) {
+            store.update { Transition(it.withReceipt(replies.first().copy(replyJson = "x".repeat(96 * 1024 + 1))), emptyList()) }
+        }
+        assertEquals(replies.drop(1), store.read().receipts)
+    }
+}

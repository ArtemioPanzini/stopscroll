+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import org.junit.Assert.*
+import org.junit.Test
+
+internal fun fixture(name: String): JsonObject =
+    PolicyMatcherTest::class.java.getResourceAsStream("/$name.json")!!.bufferedReader().use {
+        JsonParser.parseReader(it).asJsonObject
+    }
+
+internal fun examplePolicy(minutes: Int = 45): Policy {
+    val doc = fixture("policy")["policy"].asJsonObject
+    doc["sites"].asJsonObject["video"].asJsonObject.addProperty("budget_min", minutes)
+    return PolicyCodec.decode(doc.toString())
+}
+
+class PolicyMatcherTest {
+    private val vectors = fixture("policy")
+    private val doc = vectors["policy"].asJsonObject
+
+    @Test fun labelBoundariesAndIndependentGroups() {
+        val matcher = PolicyMatcher(PolicyCodec.decode(doc.toString()))
+        for (case in vectors["matches"].asJsonArray.map { it.asJsonObject }) {
+            val open = case["open"].asJsonArray.map { it.asString }.toSet()
+            assertEquals(case.toString(), case["blocked"].asBoolean, matcher.blocks(case["host"].asString, open))
+        }
+    }
+
+    private fun domains(values: List<String>): JsonObject = doc.deepCopy().apply {
+        val site = getAsJsonObject("sites").getAsJsonObject("news")
+        site.add("domains", com.google.gson.JsonArray().also { a -> values.forEach(a::add) })
+    }
+
+    @Test fun normalizedPolicyDomainsAndScope() {
+        for (domain in vectors["valid_domains"].asJsonArray) PolicyCodec.decode(domains(listOf(domain.asString)).toString())
+        for (domain in vectors["invalid_domains"].asJsonArray) invalid(domains(listOf(domain.asString)).toString())
+        invalid(doc.toString().replace("accounts.video.example.org", "other.example.org"))
+    }
+
+    private fun invalid(raw: String, code: String = "INVALID_REQUEST") {
+        assertEquals(raw.take(60), code, assertThrows(PolicyException::class.java) { PolicyCodec.decode(raw) }.code)
+    }
+
+    @Test fun strictJsonAndSchema() {
+        for (field in vectors["invalid_root_fields"].asJsonArray) invalid(doc.deepCopy().apply { addProperty(field.asString, 1) }.toString())
+        val raw = doc.toString()
+        invalid(raw.replace("\"schema\":1", "\"schema\":2"), "UNSUPPORTED_SCHEMA")
+        invalid(raw.replace("\"schema\":1", "\"schema\":1,\"schema\":1"))
+        invalid(raw.replace("\"reset_hour\":4", "\"reset_hour\":3"))
+        invalid(raw.replace("\"video\":{", "\"Video\":{"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":\"45\""))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":45.0"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":0"))
+        invalid(raw.replace("\"budget_min\":0", "\"budget_min\":1"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":45,\"spent\":1"))
+        invalid(raw.replace("\"default_session_min\":15", "\"default_session_min\":1441"))
+        invalid(raw.replace("\"mode\":\"limited\",", ""))
+        invalid(raw + "{}")
+        invalid(raw.replace("\"schema\"", "'schema'"))
+    }
+
+    @Test fun structuredNumbersRequireIntegerTokensWithinRange() {
+        fun withBudget(value: com.google.gson.JsonElement) = doc.deepCopy().apply {
+            getAsJsonObject("sites").getAsJsonObject("video").add("budget_min", value)
+        }
+        assertEquals(45, PolicyCodec.fromJson(withBudget(JsonParser.parseString("45"))).sites.getValue("video").budgetMin)
+        val invalidTokens = listOf("45.0", "45.9", "45e0", "18446744073709551661", "0", "1441", "true", "\"45\"")
+        val invalidValues = invalidTokens.map(JsonParser::parseString) + listOf("+45", "045").map {
+            // Simulate a numeric tree built by another decoder. Strict JSON input cannot contain these tokens.
+            com.google.gson.JsonPrimitive(com.google.gson.internal.LazilyParsedNumber(it))
+        }
+        for (bad in invalidValues) {
+            val error = assertThrows("unexpectedly accepted ${bad.asString}", PolicyException::class.java) { PolicyCodec.fromJson(withBudget(bad)) }
+            assertEquals("INVALID_REQUEST", error.code)
+        }
+    }
+
+    @Test fun canonicalHashAndLimits() {
+        val policy = PolicyCodec.decode(doc.toString())
+        assertEquals(policy, PolicyCodec.decode(PolicyCodec.encode(policy)))
+        assertEquals(vectors["canonical_sha256"].asString, policy.hash)
+        val sites = doc.deepCopy()
+        val groups = sites["sites"].asJsonObject
+        groups.remove("video")
+        val news = groups.remove("news")
+        val limits = vectors["limits"].asJsonObject
+        repeat(limits["groups"].asInt) { groups.add("g$it", news) }
+        PolicyCodec.decode(sites.toString())
+        groups.add("more", news)
+        invalid(sites.toString(), "TOO_LARGE")
+        val entries = List(limits["entries"].asInt - 2) { "x$it.example" }
+        PolicyCodec.decode(domains(entries).toString())
+        invalid(domains(entries + "extra.example").toString(), "TOO_LARGE")
+        val base = List(998) { "a.example" }
+        val target = limits["canonical_bytes"].asInt
+        val padding = target - domains(base).toString().toByteArray().size
+        val exact = base.mapIndexed { index, host ->
+            val extra = padding / base.size + if (index < padding % base.size) 1 else 0
+            "x".repeat(extra - 1) + "." + host
+        }
+        assertEquals(target, PolicyCodec.encode(PolicyCodec.decode(domains(exact).toString())).toByteArray().size)
+        invalid(domains(exact.toMutableList().also { it[0] = "x" + it[0] }).toString(), "TOO_LARGE")
+        val large = domains(entries.map { "x".repeat(60) + "." + it })
+        assertTrue(large.toString().toByteArray().size > limits["canonical_bytes"].asInt)
+        invalid(large.toString(), "TOO_LARGE")
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/StateStoreTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/StateStoreTest.kt

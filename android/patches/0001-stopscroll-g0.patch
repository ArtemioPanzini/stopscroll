+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+/** The launcher consumes the same revisioned transactions as USB. External intents never select
+ * an operation, arguments or site. Only an explicit tap can start a session or request consent. */
+class StopscrollActivity : Activity() {
+    internal var execute: (RpcRequest) -> RpcReply = { G0Vpn.controller.execute(it) }
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+    private var visible: Job? = null
+    private val reads = Mutex()
+    private var mutation = false
+    private var generation = 0L
+    private var state: DailyStatus? = null
+    private val rows = linkedMapOf<String, Row>()
+    private lateinit var column: LinearLayout
+    private lateinit var protection: TextView
+    private lateinit var settings: TextView
+    private lateinit var day: TextView
+    private lateinit var message: TextView
+    private lateinit var groups: LinearLayout
+    private lateinit var empty: TextView
+    private lateinit var start: Button
+    private lateinit var battery: Button
+    private lateinit var notifications: Button
+
+    private inner class Row(val id: String) {
+        val container = LinearLayout(this@StopscrollActivity).apply { orientation = LinearLayout.VERTICAL }
+        val name = text(container, id, 19, true)
+        val balance = text(container, "", 16)
+        val action = button(container, "") { choose(id) }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        column = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            val pad = (20 * resources.displayMetrics.density).toInt()
+            setPadding(pad, pad, pad, pad)
+        }
+        setContentView(ScrollView(this).apply { addView(column) })
+        text(column, "Stopscroll", 28, true)
+        protection = text(column, "Проверяем защиту…", 21, true)
+        settings = text(column, "", 15)
+        day = text(column, "", 16)
+        message = text(column, "", 16).apply { accessibilityLiveRegion = View.ACCESSIBILITY_LIVE_REGION_POLITE }
+        text(column, "Сайты", 22, true)
+        empty = text(column, "", 16)
+        groups = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; column.addView(this) }
+        text(column, "Настройка VPN", 22, true)
+        text(column, "Разрешённые DNS-запросы обрабатывает ${G0Vpn.resolverUrl}.", 15)
+        start = button(column, "Запустить VPN") { prepareVpn() }
+        button(column, "Постоянный VPN и блокировка без VPN") { launchSystem(Intent(Settings.ACTION_VPN_SETTINGS)) }
+        battery = button(column, "Исключить Stopscroll из оптимизации батареи") {
+            launchSystem(Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:$packageName")))
+        }
+        notifications = button(column, "Разрешить уведомления об отрезках") {
+            if (Build.VERSION.SDK_INT >= 33)
+                requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), NOTICE)
+        }
+        button(column, "О приложении") {
+            AlertDialog.Builder(this).setTitle("Stopscroll")
+                .setMessage("VPN основан на RethinkDNS и Firestack. Бюджет телефона хранится на этом устройстве.")
+                .setPositiveButton(android.R.string.ok, null).show()
+        }
+    }
+
+    private fun text(parent: LinearLayout, label: String, size: Int, bold: Boolean = false) =
+        TextView(this).apply {
+            text = label
+            textSize = size.toFloat()
+            if (bold) setTypeface(typeface, Typeface.BOLD)
+            val space = (resources.displayMetrics.density * (if (bold) 12 else 4)).toInt()
+            setPadding(0, space, 0, space)
+            parent.addView(this)
+        }
+
+    private fun button(parent: LinearLayout, label: String, click: () -> Unit) = Button(this).apply {
+        text = label
+        isAllCaps = false
+        setOnClickListener { click() }
+        parent.addView(this)
+    }
+
+    override fun onResume() {
+        super.onResume()
+        notifications.visibility = if (Build.VERSION.SDK_INT >= 33 &&
+            checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED)
+            View.VISIBLE else View.GONE
+        visible = scope.launch {
+            while (isActive) {
+                refresh()
+                // Only while visible. Countdown rendering uses elapsed time without journal I/O.
+                repeat(5) { delay(1000); renderRows() }
+            }
+        }
+    }
+
+    override fun onPause() { visible?.cancel(); visible = null; super.onPause() }
+    override fun onDestroy() { scope.cancel(); super.onDestroy() }
+
+    private suspend fun refresh() = reads.withLock {
+        val stamp = generation
+        val result = withContext(Dispatchers.IO) { execute(DailyCommands.status()) }
+        if (stamp != generation || mutation) return@withLock
+        if (!result.ok) {
+            state = null
+            protection.text = "Состояние защиты неизвестно"
+            settings.text = result.json.getAsJsonObject("error")["message"].asString
+            day.text = ""
+            start.visibility = View.VISIBLE
+            battery.visibility = View.VISIBLE
+        } else {
+            state = DailyStatus.from(result)
+            renderState(requireNotNull(state))
+        }
+        renderRows()
+    }
+
+    private fun renderState(s: DailyStatus) {
+        val label = when (s.state) {
+            "active" -> "Защита активна"
+            "degraded" -> "Фильтр работает с ошибкой"
+            "stopped" -> "VPN остановлен"
+            else -> "Нет подтверждённой защиты"
+        }
+        protection.text = label
+        fun yes(value: Boolean) = if (value) "да" else "нет"
+        settings.text = listOfNotNull(
+            "Туннель — ${yes(s.tunnel)}  ·  постоянный VPN — ${yes(s.alwaysOn)}",
+            "Блокировка без VPN — ${yes(s.lockdown)}  ·  исключение батареи — ${yes(s.exempt)}",
+            "DNS Preferred — ${s.preferred}",
+            "Ревизия сохранена ${s.revision}, применена ${s.applied ?: "—"}", s.reason
+        ).joinToString("\n")
+        day.text = String.format(Locale.ROOT, "День бюджета %s\nСброс в %02d:00 · %s", s.day, s.reset, s.zone.id)
+        start.visibility = if (s.tunnel) View.GONE else View.VISIBLE
+        battery.visibility = if (s.exempt) View.GONE else View.VISIBLE
+    }
+
+    private fun renderRows() {
+        val s = state
+        val sites = s?.sites.orEmpty()
+        for (id in rows.keys.toList()) if (!sites.containsKey(id)) groups.removeView(rows.remove(id)!!.container)
+        empty.text = if (s != null && sites.isEmpty()) "Групп пока нет. Правила можно импортировать с компьютера по USB." else ""
+        empty.visibility = if (empty.text.isEmpty()) View.GONE else View.VISIBLE
+        if (s == null) return
+        val elapsed = SystemClock.elapsedRealtime()
+        for ((id, site) in sites) {
+            val row = rows.getOrPut(id) { Row(id).also { groups.addView(it.container) } }
+            val end = site.end
+            val actualReserve = if (end == null) 0 else ((end - elapsed).coerceAtLeast(0) / 1000)
+                .toInt().coerceAtMost(site.reserved)
+            val remaining = (site.remaining - site.reserved + actualReserve).coerceAtLeast(0)
+            row.balance.text = when {
+                !site.limited -> "Постоянный запрет"
+                end == null -> "Остаток ${duration(remaining)} из ${site.budgetMin} мин · отрезок закрыт"
+                else -> {
+                    val endTime = Instant.ofEpochMilli(s.endWall(end)).atZone(s.zone).format(DateTimeFormatter.ofPattern("HH:mm:ss"))
+                    "Остаток ${duration(remaining)}, в отрезке ${duration(actualReserve)} · конец в $endTime"
+                }
+            }
+            row.action.visibility = if (site.limited) View.VISIBLE else View.GONE
+            row.action.text = if (end == null) "Открыть отрезок" else "Закрыть отрезок"
+            row.action.isEnabled = !mutation && (end != null || (remaining > 0 && s.state == "active"))
+        }
+    }
+
+    private fun duration(seconds: Int) = String.format(Locale.ROOT, "%d:%02d", seconds / 60, seconds % 60)
+
+    private fun choose(id: String) {
+        val s = state ?: return
+        val site = s.sites[id] ?: return
+        if (!site.limited || mutation) return
+        if (site.end != null) {
+            submit(DailyCommands.session(id, s.revision, open = false))
+            return
+        }
+        val input = EditText(this).apply {
+            inputType = InputType.TYPE_CLASS_NUMBER
+            hint = "По умолчанию ${s.defaultMin} мин"
+            contentDescription = "Длительность в минутах"
+            isSingleLine = true
+        }
+        val dialog = AlertDialog.Builder(this).setTitle("Отрезок для $id").setView(input)
+            .setPositiveButton("Открыть", null).setNegativeButton(android.R.string.cancel, null).create()
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val typed = input.text.toString().trim()
+                val min = typed.toIntOrNull()
+                if (typed.isNotEmpty() && (min == null || min !in 1..1440)) {
+                    input.error = "Введите от 1 до 1440 минут"; return@setOnClickListener
+                }
+                dialog.dismiss()
+                submit(DailyCommands.session(id, s.revision, open = true, minutes = min))
+            }
+        }
+        dialog.show()
+    }
+
+    private fun submit(request: RpcRequest) {
+        if (mutation) return
+        mutation = true
+        generation++
+        renderRows()
+        message.text = ""
+        scope.launch {
+            try {
+                val reply = withContext(Dispatchers.IO) { execute(request) }
+                if (!reply.ok) {
+                    val err = reply.json.getAsJsonObject("error")
+                    message.text = "${err["code"].asString} · ${err["message"].asString}"
+                }
+            } finally { mutation = false; generation++; renderRows() }
+            refresh()
+        }
+    }
+
+    private fun launchSystem(intent: Intent) {
+        try { startActivity(intent) } catch (_: RuntimeException) {
+            message.text = "Экран недоступен. Откройте настройки системы."
+        }
+    }
+
+    private fun prepareVpn() {
+        try {
+            val consent = VpnService.prepare(this)
+            if (consent == null) VpnController.start(this)
+            else @Suppress("DEPRECATION") startActivityForResult(consent, CONSENT)
+        } catch (_: IllegalStateException) { message.text = "Проверьте выбранный VPN в настройках системы." }
+    }
+
+    @Deprecated("System VPN consent result")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        if (requestCode != CONSENT) return
+        if (resultCode == RESULT_OK) VpnController.start(this)
+        else message.text = "Разрешение VPN не получено."
+    }
+
+    private companion object { const val CONSENT = 1; const val NOTICE = 2 }
+}

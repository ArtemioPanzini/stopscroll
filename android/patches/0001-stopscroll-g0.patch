+    private fun outcomeCrash(identityLoss: Boolean, beforeAuthorization: Boolean, loseProcess: Boolean = true) {
+        attach()
+        store.loadOrCreate { initial }
+        var writes = 0
+        var finishing = false
+        var crashed = false
+        fun revoke() {
+            if (identityLoss) engine.detach(target) else {
+                clock = clock.copy(elapsedMs = clock.elapsedMs + 300000)
+                timers.cutoff!!()
+            }
+        }
+        val source = StateStore(file, beforeFinish = {
+            if (++writes == 2) {
+                finishing = true
+                if (beforeAuthorization) revoke()
+            }
+        }, beforeDirectorySync = { dir ->
+            if (finishing && !crashed && dir == file.parentFile) {
+                // The directory-sync hook runs after the selected file was renamed and verified.
+                // If authorization vetoed success, this can also be a read of the pending journal.
+                crashed = true
+                if (!beforeAuthorization) revoke()
+                if (loseProcess) throw AssertionError("process lost after publication, before returning")
+            }
+        })
+        val open = request("session.open", 0)
+        if (loseProcess) assertThrows(AssertionError::class.java) { controller(source).execute(open) }
+        else assertTrue(controller(source).execute(open).ok)
+        val restart = EngineAdapter({ clock }, timers)
+        val rebuilt = TestTunnel()
+        restart.register(rebuilt.owner)
+        restart.attach(rebuilt)
+        restart.installPreferred(rebuilt) {}
+        val recovered = StopscrollController(store, { error("must recover") }, { clock }, restart, timers, rebuilt::platform)
+        val replay = recovered.execute(open)
+        assertEquals(!beforeAuthorization, replay.ok)
+        if (beforeAuthorization) {
+            assertEquals("APPLY_FAILED", replay.code())
+            assertNull(store.read().accounts["video"]!!.session)
+        }
+        assertEquals(replay.json, recovered.execute(open).json)
+        assertEquals(1, store.read().receipts.count { it.requestId == open.requestId })
+    }
+

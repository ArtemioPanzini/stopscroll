+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Application
+import android.content.ContentValues
+import android.net.Uri
+import android.os.Binder
+import android.os.Bundle
+import android.os.Process
+import com.google.gson.JsonNull
+import com.google.gson.JsonObject
+import java.io.File
+import java.lang.reflect.InvocationTargetException
+import java.time.ZoneId
+import kotlin.io.encoding.Base64
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowBinder
+import org.robolectric.shadows.ShadowContentResolver
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE, application = Application::class)
+class UsbControlProviderTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val authority = "com.celzero.bravedns.stopscroll.usb"
+    private val uri = Uri.parse("content://$authority")
+    private val requestId = "12345678-90ab-4def-8123-456789abcdef"
+    private val reads = """{"schema":1,"request_id":"$requestId","op":"status","args":{}}"""
+    private val open = """{"schema":1,"request_id":"$requestId","op":"session.open",
+        "args":{"site":"video","minutes":5},"expected_revision":1}"""
+    private val context get() = RuntimeEnvironment.getApplication()
+    private val requests = mutableListOf<RpcRequest>()
+    private val provider = UsbControlProvider { request ->
+        requests.add(request)
+        RpcReply(success(request.requestId))
+    }
+
+    @After fun clearBinderIdentity() = ShadowBinder.reset()
+
+    private fun encode(raw: String) = Base64.encode(raw.toByteArray())
+
+    private fun decode(bundle: Bundle?): JsonObject {
+        val result = requireNotNull(bundle)
+        assertEquals(setOf("result_b64"), result.keySet())
+        val encoded = requireNotNull(result.getString("result_b64"))
+        val bytes = Base64.decode(encoded)
+        assertTrue(bytes.size <= RpcCodec.MAX_BYTES)
+        assertEquals(encoded, Base64.encode(bytes))
+        return strictJson(bytes.decodeToString()).obj()
+    }
+
+    private fun success(id: String, data: JsonObject = JsonObject()) = JsonObject().apply {
+        addProperty("schema", 1)
+        addProperty("request_id", id)
+        addProperty("ok", true)
+        addProperty("revision", 8)
+        addProperty("applied_revision", 7)
+        add("data", data)
+    }
+
+    private fun assertFailure(reply: JsonObject, code: String, id: String, revision: Long = 0) {
+        assertEquals(setOf("schema", "request_id", "ok", "revision", "applied_revision", "error"), reply.keySet())
+        assertEquals(1, reply["schema"].asInt)
+        assertEquals(id, reply["request_id"].asString)
+        assertFalse(reply["ok"].asBoolean)
+        assertEquals(revision, reply["revision"].asLong)
+        assertEquals(JsonNull.INSTANCE, reply["applied_revision"])
+        val error = reply["error"].asJsonObject
+        assertEquals(setOf("code", "message"), error.keySet())
+        assertEquals(code, error["code"].asString)
+    }
+
+    @Test fun binderUidGuardRunsBeforeMethodDecodingOrDispatch() {
+        ShadowContentResolver.registerProviderInternal(authority, provider)
+        val spoofedExtras = Bundle().apply {
+            putString("calling_package", "com.android.shell")
+            putInt("calling_uid", 2000)
+        }
+        for (uid in listOf(Process.myUid(), 0, 1000, 10_001)) {
+            ShadowBinder.setCallingUid(uid)
+            assertEquals(uid, Binder.getCallingUid())
+            assertThrows(SecurityException::class.java) {
+                context.contentResolver.call(uri, "nonexistent", "!".repeat(RpcCodec.MAX_ENCODED_CHARS + 1), spoofedExtras)
+            }
+            assertThrows(SecurityException::class.java) {
+                context.contentResolver.call(uri, "rpc", encode(reads), spoofedExtras)
+            }
+            assertThrows(SecurityException::class.java) {
+                provider.call(authority, "rpc", null, spoofedExtras)
+            }
+        }
+        assertTrue(requests.isEmpty())
+    }
+
+    @Test fun evenNullMethodsAndAuthoritiesAreDeniedByUidBeforeArgumentChecks() {
+        val legacy = provider.javaClass.getMethod(
+            "call", String::class.java, String::class.java, Bundle::class.java
+        )
+        val modern = provider.javaClass.getMethod(
+            "call", String::class.java, String::class.java, String::class.java, Bundle::class.java
+        )
+        ShadowBinder.setCallingUid(10_001)
+        val legacyError = assertThrows(InvocationTargetException::class.java) {
+            legacy.invoke(provider, null, encode(reads), null)
+        }
+        val modernError = assertThrows(InvocationTargetException::class.java) {
+            modern.invoke(provider, authority, null, encode(reads), null)
+        }
+        assertTrue(legacyError.cause is SecurityException)
+        assertTrue(modernError.cause is SecurityException)
+        val authorityError = assertThrows(InvocationTargetException::class.java) {
+            modern.invoke(provider, null, "rpc", encode(reads), null)
+        }
+        assertTrue(authorityError.cause is SecurityException)
+        ShadowBinder.setCallingUid(2000)
+        val invalidMethod = assertThrows(InvocationTargetException::class.java) {
+            modern.invoke(provider, authority, null, encode(reads), null)
+        }
+        assertTrue(invalidMethod.cause is UnsupportedOperationException)
+        val invalidAuthority = assertThrows(InvocationTargetException::class.java) {
+            modern.invoke(provider, null, "rpc", encode(reads), null)
+        }
+        assertTrue(invalidAuthority.cause is UnsupportedOperationException)
+        assertTrue(requests.isEmpty())
+    }
+
+    @Test fun validShellCallsForwardActualReplyAndPreserveRevisions() {
+        ShadowBinder.setCallingUid(2000)
+        assertEquals(2000, Binder.getCallingUid())
+        ShadowContentResolver.registerProviderInternal(authority, provider)
+        val viaResolver = context.contentResolver.call(uri, "rpc", encode(reads), Bundle())
+        assertEquals(success(requestId), decode(viaResolver))
+        val direct = provider.call(authority, "rpc", encode(open), null)
+        assertEquals(success(requestId), decode(direct))
+        assertEquals(listOf("status", "session.open"), requests.map { it.op })
+        assertEquals(1L, requests.last().expectedRevision)
+        assertEquals("video", requests.last().args["site"].asString)
+    }
+
+    @Test fun invalidShellCallsReturnOnlyBoundedErrorsAndNeverDispatch() {
+        ShadowBinder.setCallingUid(2000)
+        assertThrows(UnsupportedOperationException::class.java) {
+            provider.call(authority, "status", "!".repeat(RpcCodec.MAX_ENCODED_CHARS + 1), null)
+        }
+        assertFailure(decode(provider.call("rpc", "!!!", null)), "INVALID_REQUEST", RpcCodec.UNAVAILABLE_REQUEST_ID)
+        assertFailure(decode(provider.call("rpc", encode(reads.replace("\"schema\":1", "\"schema\":2")), null)),
+            "UNSUPPORTED_SCHEMA", requestId)
+        assertFailure(decode(provider.call("rpc", encode(reads.replace("\"status\"", "\"legacy.get\"")), null)),
+            "INVALID_REQUEST", requestId)
+        assertFailure(decode(provider.call("rpc", encode(open.replace("\"minutes\":5", "\"minutes\":5e0")), null)),
+            "INVALID_REQUEST", RpcCodec.UNAVAILABLE_REQUEST_ID)
+        assertFailure(decode(provider.call("rpc", "A".repeat(RpcCodec.MAX_ENCODED_CHARS + 1), null)),
+            "TOO_LARGE", RpcCodec.UNAVAILABLE_REQUEST_ID)
+        assertTrue(requests.isEmpty())
+    }
+
+    @Test fun ordinaryContentProviderMethodsAreDeniedForShellAndApps() {
+        val operations: List<() -> Unit> = listOf(
+            { provider.query(uri, null, null, null, null) },
+            { provider.query(uri, null, null, null, null, null) },
+            { provider.query(uri, null, null, null) },
+            { provider.getType(uri) },
+            { provider.getTypeAnonymous(uri) },
+            { provider.insert(uri, ContentValues()) },
+            { provider.insert(uri, ContentValues(), Bundle()) },
+            { provider.bulkInsert(uri, emptyArray()) },
+            { provider.update(uri, null, null, null) },
+            { provider.update(uri, null, Bundle()) },
+            { provider.delete(uri, null, null) },
+            { provider.delete(uri, Bundle()) },
+            { provider.applyBatch(arrayListOf()) },
+            { provider.applyBatch(authority, arrayListOf()) },
+            { provider.openFile(uri, "r") },
+            { provider.openFile(uri, "r", null) },
+            { provider.openAssetFile(uri, "r") },
+            { provider.openAssetFile(uri, "r", null) },
+            { provider.openTypedAssetFile(uri, "*/*", null) },
+            { provider.openTypedAssetFile(uri, "*/*", null, null) },
+            { provider.getStreamTypes(uri, "*/*") },
+            { provider.canonicalize(uri) },
+            { provider.uncanonicalize(uri) },
+            { provider.refresh(uri, null, null) }
+        )
+        ShadowBinder.setCallingUid(2000)
+        operations.forEach { assertThrows(UnsupportedOperationException::class.java) { it() } }
+        ShadowBinder.setCallingUid(10_001)
+        operations.forEach { assertThrows(SecurityException::class.java) { it() } }
+        assertTrue(requests.isEmpty())
+    }
+
+    @Test fun preDispatchFailuresLeaveRealJournalUntouchedAndStaleRevisionCannotReserve() {
+        ShadowBinder.setCallingUid(2000)
+        val file = File(folder.root, "stopscroll/state.json")
+        val clock = ClockSample(1783850400000, 7000, 12)
+        val initial = JournalState.initial(ZoneId.of("Europe/Belgrade"), clock, examplePolicy())
+        val store = StateStore(file)
+        val timers = TestTimers()
+        val controller = StopscrollController(store, { initial }, { clock }, EngineAdapter({ clock }, timers), timers) {
+            PlatformProtection(false, false, false, false)
+        }
+        controller.reconcile()
+        val original = store.read()
+        val bytes = file.readBytes()
+        val provider = UsbControlProvider { request ->
+            requests.add(request)
+            controller.execute(request)
+        }
+        assertFailure(decode(provider.call("rpc", encode(open.replace("\"video\"", "\"bad-id\"")), null)),
+            "INVALID_REQUEST", requestId)
+        assertTrue(requests.isEmpty())
+        assertArrayEquals(bytes, file.readBytes())
+
+        val stale = decode(provider.call("rpc", encode(open), null))
+        assertFailure(stale, "CONFLICT", requestId, original.revision)
+        val saved = store.read()
+        assertEquals(original.revision, saved.revision)
+        assertEquals(original.policy.hash, saved.policy.hash)
+        assertEquals(original.accounts, saved.accounts)
+        assertNull(saved.accounts.getValue("video").session)
+        assertEquals(1, requests.size)
+    }
+
+    @Test fun oversizedOrInvalidControllerRepliesNeverBecomeAcknowledgements() {
+        ShadowBinder.setCallingUid(2000)
+        val oversized = UsbControlProvider { request ->
+            RpcReply(success(request.requestId, JsonObject().apply {
+                addProperty("diagnostic", "😀".repeat(RpcCodec.MAX_BYTES / 4))
+            }))
+        }
+        assertFailure(decode(oversized.call("rpc", encode(reads), null)), "TOO_LARGE", requestId, 8)
+        val wrongId = UsbControlProvider {
+            RpcReply(success("9a000000-0000-0000-0000-000000000000"))
+        }
+        assertFailure(decode(wrongId.call("rpc", encode(reads), null)), "INVALID_RESPONSE", requestId)
+    }
+}

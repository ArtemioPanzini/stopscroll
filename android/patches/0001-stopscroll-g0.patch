+import org.koin.core.component.KoinComponent
+import org.koin.core.component.inject
+import java.nio.ByteBuffer
+
+/** G0 acceptance hooks, reachable only through the Android shell UID. */
+class UsbControlProvider : ContentProvider(), KoinComponent {
+    private val persistentState by inject<PersistentState>()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var timer: Job? = null
+    private var deadline = 0L
+    private var wakeLock: PowerManager.WakeLock? = null
+    private var lastCloseMs: Long? = null
+    private var lastError: String? = null
+
+    override fun onCreate() = true
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        val uid = requireShell()
+        require(method == "rpc") { "Expected rpc method" }
+        val reply = synchronized(this) {
+            try {
+                val request = decode(arg)
+                val app = requireNotNull(context)
+                dispatch(app, request)
+            } catch (_: Exception) {
+                JSONObject().put("ok", false).put("error", "G0 request failed")
+            }.put("uid", uid)
+        }
+        return Bundle().apply {
+            putString("result_b64", Base64.encodeToString(reply.toString().toByteArray(Charsets.UTF_8), Base64.NO_WRAP))
+        }
+    }
+
+    private fun dispatch(app: Context, request: JSONObject): JSONObject {
+        val operation = request.get("op") as? String
+        when (operation) {
+            "status" -> Unit
+            "enable" -> app.startActivity(Intent(app, G0VpnActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            "blockDomains" -> {
+                val policy = policy(request)
+                G0Vpn.replace(app, policy)
+                cancelTimer()
+                closeAll()
+            }
+            "closeAll" -> closeAll()
+            "setAlg" -> {
+                persistentState.enableDnsAlg = request.get("enabled") as? Boolean
+                    ?: throw IllegalArgumentException("enabled must be a boolean")
+                runBlocking(Dispatchers.IO) { VpnController.g0UpdateDnsAlg() }
+            }
+            "watchUid" -> {
+                val watchUid = number(request, "uid")
+                require(watchUid == -1L || watchUid in 10_000L..99_999L)
+                G0Vpn.watch = if (watchUid < 0) null else G0Vpn.FlowWatch(watchUid.toInt())
+            }
+            "timedBlock" -> {
+                val policy = policy(request)
+                val duration = number(request, "duration_ms")
+                require(duration in 1L..120_000L)
+                require(VpnController.hasTunnel()) { "VPN is inactive" }
+                scheduleBlock(app, policy, duration)
+            }
+            else -> throw IllegalArgumentException("Unknown G0 operation")
+        }
+        return status(app)
+    }
+
+    private fun closeAll() {
+        val started = SystemClock.elapsedRealtime()
+        val dispatched = runBlocking(Dispatchers.IO) { VpnController.g0CloseAll() }
+        lastCloseMs = SystemClock.elapsedRealtime() - started
+        lastError = if (dispatched) null else "VPN inactive during close"
+    }
+
+    private fun scheduleBlock(app: Context, policy: G0Domains, duration: Long) {
+        cancelTimer()
+        val power = app.getSystemService(PowerManager::class.java)
+        val lock = power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Stopscroll:G0Deadline")
+        lock.setReferenceCounted(false)
+        lock.acquire(duration + 2_000L)
+        wakeLock = lock
+        val expires = SystemClock.elapsedRealtime() + duration
+        deadline = expires
+        timer = scope.launch {
+            delay((expires - SystemClock.elapsedRealtime()).coerceAtLeast(0L))
+            synchronized(this@UsbControlProvider) {
+                if (wakeLock !== lock) return@synchronized
+                try {
+                    G0Vpn.replace(app, policy)
+                    closeAll()
+                } catch (_: Exception) {
+                    lastError = "Timed close failed"
+                } finally {
+                    timer = null
+                    cancelTimer()
+                }
+            }
+        }
+    }
+
+    private fun cancelTimer() {
+        timer?.cancel()
+        timer = null
+        deadline = 0L
+        wakeLock?.let { if (it.isHeld) it.release() }
+        wakeLock = null
+    }
+
+    private fun status(app: Context): JSONObject {
+        val info = runBlocking(Dispatchers.IO) { VpnController.g0DnsInfo() }
+        val response = JSONObject()
+            .put("ok", lastError == null)
+            .put("tunnel", VpnController.hasTunnel())
+            .put("always_on", VpnController.isAlwaysOn(app))
+            .put("lockdown", VpnController.isVpnLockdown())
+            .put("mode", "dns_firewall")
+            .put("resolver", G0Vpn.resolverUrl)
+            .put("bootstrap", G0Vpn.resolverIps)
+            .put("dns_alg", persistentState.enableDnsAlg)
+            .put("dns_cache", persistentState.enableDnsCache)
+            .put("logs_enabled", persistentState.logsEnabled)
+            .put("domains", JSONArray(G0Vpn.policy.domains))
+            .put("exceptions", JSONArray(G0Vpn.policy.exceptions))
+            .put("deadline_elapsed_ms", deadline)
+            .put("now_elapsed_ms", SystemClock.elapsedRealtime())
+            .put("wake_lock_held", wakeLock?.isHeld == true)
+            .put("last_close_call_ms", lastCloseMs ?: JSONObject.NULL)
+            .put("error", lastError ?: JSONObject.NULL)
+        if (info != null) {
+            response.put("native_preferred_dns", info.dnsPreferred)
+                .put("native_default_dns", info.dnsDefault)
+                .put("native_fallback", info.defaultDNSAsFallback)
+        }
+        G0Vpn.watch?.let {
+            response.put("watched_uid", it.uid)
+                .put("watched_tcp", it.tcp.get())
+                .put("watched_udp", it.udp.get())
+                .put("watched_blocked", it.blocked.get())
+        }
+        return response
+    }
+
+    private fun policy(request: JSONObject): G0Domains {
+        val domains = G0Vpn.strings(request.getJSONArray("domains"))
+        val exceptions = if (request.has("exceptions")) G0Vpn.strings(request.getJSONArray("exceptions")) else emptyList()
+        return G0Domains.create(domains, exceptions)
+    }
+
+    private fun number(request: JSONObject, key: String): Long = when (val value = request.get(key)) {
+        is Int -> value.toLong()
+        is Long -> value
+        else -> throw IllegalArgumentException("Expected integer")
+    }
+
+    private fun decode(arg: String?): JSONObject {
+        val encoded = requireNotNull(arg)
+        require(encoded.length <= REQUEST_LIMIT / 3 * 4)
+        val decoded = Base64.decode(encoded, Base64.NO_WRAP)
+        require(decoded.size <= REQUEST_LIMIT)
+        return JSONObject(Charsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(decoded)).toString())
+    }
+
+    private fun requireShell(): Int = Binder.getCallingUid().also {
+        if (it != 2_000) throw SecurityException("Stopscroll USB control requires shell UID 2000")
+    }
+
+    private fun unsupported(): Nothing {
+        requireShell()
+        throw UnsupportedOperationException("Stopscroll supports content call only")
+    }
+
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?, selectionArgs: Array<out String>?, sortOrder: String?): Cursor? = unsupported()
+    override fun getType(uri: Uri): String? = unsupported()
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = unsupported()
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?): Int = unsupported()
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = unsupported()
+
+    companion object {
+        private const val REQUEST_LIMIT = 96 * 1024
+    }
+}

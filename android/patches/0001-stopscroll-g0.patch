+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/LimitEngine.kt
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+internal data class ClockSample(val wallMs: Long, val elapsedMs: Long, val bootCount: Int) {
+    init { require(elapsedMs >= 0 && bootCount >= 0) }
+}
+
+private fun LocalDate.resetMs(zone: ZoneId) = atTime(4, 0).atZone(zone).toInstant().toEpochMilli()
+
+private fun dayAt(clock: ClockSample, zone: ZoneId): LocalDate {
+    val date = Instant.ofEpochMilli(clock.wallMs).atZone(zone).toLocalDate()
+    return if (clock.wallMs < date.resetMs(zone)) date.minusDays(1) else date
+}
+
+internal fun roundedSeconds(durationMs: Long): Int = ((durationMs + 999) / 1000).toInt()
+
+internal data class Session(val startMs: Long, val deadlineMs: Long, val warned: Boolean = false) {
+    val reservedSeconds get() = roundedSeconds(deadlineMs - startMs)
+    fun consumed(elapsedMs: Long) = roundedSeconds(elapsedMs.coerceIn(startMs, deadlineMs) - startMs)
+}
+
+internal data class Account(val spentSeconds: Int = 0, val session: Session? = null)
+
+// Task 3 owns the protocol envelope. Persist opaque replies alongside their request hashes.
+internal data class MutationReceipt(val requestId: String, val requestHash: String, val replyJson: String)
+
+internal data class JournalState(
+    val policy: Policy, val timezone: ZoneId, val dayId: LocalDate, val bootCount: Int,
+    val revision: Long, val accounts: ImmutableMap<String, Account>,
+    val receipts: ImmutableList<MutationReceipt> = ImmutableList.of()
+) {
+    fun withReceipt(receipt: MutationReceipt): JournalState {
+        val recent = receipts.filterNot { it.requestId == receipt.requestId }.takeLast(63)
+        return copy(receipts = ImmutableList.copyOf(recent + receipt))
+    }
+
+    companion object {
+        fun initial(timezone: ZoneId, clock: ClockSample, policy: Policy = Policy.EMPTY) =
+            JournalState(policy, timezone, dayAt(clock, timezone), clock.bootCount, 0,
+                ImmutableMap.copyOf(policy.sites.keys.associateWith { Account() }))
+    }
+}
+
+internal enum class EffectKind { OPEN, CLOSE, WARN, RECONFIGURE }
+internal data class Effect(val kind: EffectKind, val site: String? = null)
+internal data class Transition(val state: JournalState, val effects: List<Effect>, val error: String? = null)
+internal data class SiteBudget(val remainingSeconds: Int, val reservedSeconds: Int, val session: Session?) {
+    val unreservedSeconds get() = remainingSeconds - reservedSeconds
+}
+internal data class PolicySnapshot(
+    val policy: Policy, val revision: Long, val timezone: ZoneId, val dayId: LocalDate,
+    val bootCount: Int, val sites: ImmutableMap<String, SiteBudget>
+) {
+    private val matcher = PolicyMatcher(policy)
+    private val nextReset = dayId.plusDays(1).resetMs(timezone)
+
+    /** Even a previously published snapshot cannot grant past its deadline. */
+    fun blocks(host: String, clock: ClockSample): Boolean {
+        return matcher.blocks(host) { id ->
+            val s = sites[id]?.session
+            s != null && clock.bootCount == bootCount && clock.wallMs < nextReset &&
+                clock.elapsedMs >= s.startMs && clock.elapsedMs < s.deadlineMs
+        }
+    }
+}
+
+internal interface LimitEngine {
+    fun open(site: String, seconds: Int, clock: ClockSample): Transition
+    fun close(site: String, clock: ClockSample): Transition
+    fun tick(clock: ClockSample): Transition
+    fun replacePolicy(policy: Policy, clock: ClockSample): Transition
+    fun snapshot(clock: ClockSample): PolicySnapshot
+}
+
+/** Each invocation starts with exactly the supplied journal. Only StateStore commits a transition. */
+internal class BudgetEngine(private val state: JournalState) : LimitEngine {
+    private class Update(val original: JournalState, val clock: ClockSample) {
+        val accounts = original.accounts.toMutableMap()
+        val effects = mutableListOf<Effect>()
+        var policy = original.policy
+        var day = original.dayId
+        var changed = false
+
+        init {
+            val observedDay = dayAt(clock, original.timezone)
+            if (observedDay > day) {
+                for ((id, account) in accounts) if (account.session != null) effects.add(Effect(EffectKind.CLOSE, id))
+                accounts.clear()
+                policy.sites.keys.forEach { accounts[it] = Account() }
+                day = observedDay
+                changed = true
+            }
+            val rebooted = original.bootCount != clock.bootCount
+            if (rebooted) changed = true
+            for ((id, account) in accounts) {
+                val s = account.session ?: continue
+                if (rebooted || clock.elapsedMs < s.startMs || clock.elapsedMs >= s.deadlineMs) {
+                    settle(id, full = true)
+                } else if (!s.warned && s.deadlineMs - s.startMs > 120000 && s.deadlineMs - clock.elapsedMs <= 120000) {
+                    accounts[id] = account.copy(session = s.copy(warned = true))
+                    effects.add(Effect(EffectKind.WARN, id))
+                }
+            }
+        }
+
+        fun settle(id: String, full: Boolean = false) {
+            val account = accounts.getValue(id)
+            val s = account.session ?: return
+            val used = if (full) s.reservedSeconds else s.consumed(clock.elapsedMs)
+            accounts[id] = Account(account.spentSeconds + used)
+            effects.remove(Effect(EffectKind.WARN, id))
+            effects.add(Effect(EffectKind.CLOSE, id))
+            changed = true
+        }
+
+        fun result(error: String? = null): Transition {
+            val next = if (changed || effects.isNotEmpty()) original.copy(
+                policy = policy, accounts = ImmutableMap.copyOf(accounts), dayId = day, bootCount = clock.bootCount,
+                revision = if (changed) Math.incrementExact(original.revision) else original.revision
+            ) else original
+            return Transition(next, ImmutableList.copyOf(effects), error)
+        }
+    }
+
+    override fun open(site: String, seconds: Int, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (seconds <= 0) return u.result("INVALID_REQUEST")
+        val rule = state.policy.sites[site]
+        if (rule?.limited != true) return u.result("NOT_LIMITED")
+        val account = u.accounts.getValue(site)
+        if (account.session != null) return u.result("SESSION_ACTIVE")
+        val available = rule.budgetMin * 60 - account.spentSeconds
+        if (available <= 0) return u.result("NO_BUDGET")
+        val untilReset = u.day.plusDays(1).resetMs(state.timezone) - clock.wallMs
+        val duration = minOf(minOf(available, seconds) * 1000L, untilReset)
+        val s = Session(clock.elapsedMs, Math.addExact(clock.elapsedMs, duration))
+        u.accounts[site] = account.copy(session = s)
+        u.changed = true
+        u.effects.add(Effect(EffectKind.OPEN, site))
+        return u.result()
+    }
+
+    override fun close(site: String, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (state.policy.sites[site]?.limited != true) return u.result("NOT_LIMITED")
+        u.settle(site)
+        return u.result()
+    }
+
+    override fun replacePolicy(policy: Policy, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (policy == state.policy) return u.result()
+        if (u.accounts.size + policy.sites.keys.count { it !in u.accounts } > 1000) return u.result("TOO_LARGE")
+        for (id in u.accounts.keys) u.settle(id)
+        for (id in policy.sites.keys) u.accounts.putIfAbsent(id, Account())
+        u.changed = true
+        u.policy = policy
+        u.effects.add(Effect(EffectKind.RECONFIGURE))
+        return u.result()
+    }
+
+    override fun tick(clock: ClockSample): Transition = Update(state, clock).result()
+
+    override fun snapshot(clock: ClockSample): PolicySnapshot {
+        val current = tick(clock).state
+        val budgets = current.policy.sites.mapValues { (id, group) ->
+            val account = current.accounts.getValue(id)
+            val s = account.session
+            val consumed = s?.consumed(clock.elapsedMs) ?: 0
+            SiteBudget((group.budgetMin * 60 - account.spentSeconds - consumed).coerceAtLeast(0),
+                (s?.reservedSeconds ?: 0) - consumed, s)
+        }
+        return PolicySnapshot(current.policy, state.revision, current.timezone, current.dayId,
+            current.bootCount, ImmutableMap.copyOf(budgets))
+    }
+}
diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/Policy.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/Policy.kt
new file mode 100644
index 0000000..c7ea905
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/Policy.kt
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import java.security.MessageDigest
+
+internal class PolicyException(val code: String, message: String) : IllegalArgumentException(message)
+internal fun invalid(reason: String): Nothing = throw PolicyException("INVALID_REQUEST", reason)
+internal fun oversized(reason: String): Nothing = throw PolicyException("TOO_LARGE", reason)
+internal val siteId = Regex("[a-z][a-z0-9]{0,23}")
+internal fun sha256(bytes: ByteArray): String =
+    MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+internal data class SitePolicy(
+    val limited: Boolean,
+    val budgetMin: Int,
+    val domains: ImmutableList<String>,
+    val exceptions: ImmutableList<String>
+)
+
+internal data class Policy(val defaultSessionMin: Int, val sites: ImmutableMap<String, SitePolicy>) {
+    val hash: String by lazy { sha256(PolicyCodec.encode(this).toByteArray()) }
+    companion object {
+        val EMPTY = Policy(15, ImmutableMap.of())
+    }
+}
diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyCodec.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyCodec.kt
new file mode 100644
index 0000000..01fe395
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyCodec.kt
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import com.google.common.net.InternetDomainName
+import com.google.gson.JsonArray
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonPrimitive
+import com.google.gson.Strictness
+import com.google.gson.stream.JsonReader
+import com.google.gson.stream.JsonToken
+import java.io.StringReader
+import java.net.IDN
+
+private val integerToken = Regex("-?(?:0|[1-9][0-9]*)")
+
+private fun jsonLong(token: String): Long {
+    if (token.length > 20 || !integerToken.matches(token)) invalid("Expected integer")
+    return token.toLongOrNull() ?: invalid("Integer out of range")
+}
+
+/** Gson's tree parser silently overwrites duplicate keys. Check them while streaming. */
+internal fun strictJson(raw: String): JsonElement {
+    val reader = JsonReader(StringReader(raw)).apply { strictness = Strictness.STRICT }
+    fun value(depth: Int): JsonElement {
+        if (depth > 16) invalid("JSON nesting is too deep")
+        return when (reader.peek()) {
+            JsonToken.BEGIN_OBJECT -> JsonObject().apply {
+                reader.beginObject()
+                while (reader.hasNext()) {
+                    val key = reader.nextName()
+                    if (has(key)) invalid("Repeated JSON field")
+                    add(key, value(depth + 1))
+                }
+                reader.endObject()
+            }
+            JsonToken.BEGIN_ARRAY -> JsonArray().apply {
+                reader.beginArray()
+                while (reader.hasNext()) add(value(depth + 1))
+                reader.endArray()
+            }
+            JsonToken.STRING -> JsonPrimitive(reader.nextString())
+            JsonToken.NUMBER -> JsonPrimitive(jsonLong(reader.nextString()))
+            JsonToken.BOOLEAN -> JsonPrimitive(reader.nextBoolean())
+            else -> invalid("Unexpected JSON token")
+        }
+    }
+    return try {
+        val parsed = value(0)
+        if (reader.peek() != JsonToken.END_DOCUMENT) invalid("Trailing JSON")
+        parsed
+    } catch (e: PolicyException) {
+        throw e
+    } catch (e: Exception) {
+        invalid("Malformed JSON")
+    }
+}
+
+internal fun JsonElement.obj(): JsonObject = if (isJsonObject) asJsonObject else invalid("Expected object")
+internal fun JsonElement.array(): JsonArray = if (isJsonArray) asJsonArray else invalid("Expected array")
+internal fun JsonElement.string(): String =
+    if (isJsonPrimitive && asJsonPrimitive.isString) asString else invalid("Expected string")
+internal fun JsonElement.number(min: Long, max: Long): Long {
+    if (!isJsonPrimitive || !asJsonPrimitive.isNumber) invalid("Expected integer")
+    val value = jsonLong(asString)
+    if (value !in min..max) invalid("Integer out of range")
+    return value
+}
+internal fun JsonObject.fields(vararg names: String) {
+    if (keySet() != names.toSet()) invalid("Missing or unknown field")
+}
+
+internal object PolicyCodec {
+    const val MAX_BYTES = 65536
+    private val label = Regex("[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
+
+    private val ipv4Component = Regex("[0-9]+|0x[0-9a-f]*")
+
+    fun decode(raw: String): Policy = fromJson(strictJson(raw))
+
+    /** A parsed tree retains number types and tokens. Reject duplicate keys at the raw JSON boundary. */
+    fun fromJson(element: JsonElement): Policy {
+        val root = element.obj()
+        root.fields("schema", "reset_hour", "default_session_min", "sites")
+        if (root["schema"].number(0, Long.MAX_VALUE) != 1L) throw PolicyException("UNSUPPORTED_SCHEMA", "Policy schema must be 1")
+        root["reset_hour"].number(4, 4)
+        val defaultMin = root["default_session_min"].number(1, 1440).toInt()
+        val sites = root["sites"].obj()
+        if (sites.size() > 100) oversized("At most 100 site groups")
+        var count = 0
+        fun domains(element: JsonElement): ImmutableList<String> {
+            val array = element.array()
+            count += array.size()
+            if (count > 1000) oversized("At most 1000 domains and exceptions")
+            return ImmutableList.copyOf(array.map { validateDomain(it.string()) })
+        }
+        val policies = sites.entrySet().associate { (id, entry) ->
+            if (!siteId.matches(id)) invalid("Invalid site ID")
+            val group = entry.obj()
+            group.fields("mode", "budget_min", "domains", "exceptions")
+            val limited = when (group["mode"].string()) {
+                "limited" -> true
+                "blocked" -> false
+                else -> invalid("Invalid mode")
+            }
+            val budget = if (limited) group["budget_min"].number(1, 1440) else group["budget_min"].number(0, 0)
+            val entries = domains(group["domains"])
+            if (entries.isEmpty()) invalid("Group requires a domain")
+            val exceptions = domains(group["exceptions"])
+            val roots = entries.toSet()
+            if (exceptions.any { !PolicyMatcher.matches(it, roots) }) invalid("Exception is outside group domains")
+            id to SitePolicy(limited, budget.toInt(), entries, exceptions)
+        }
+        val policy = Policy(defaultMin, ImmutableMap.copyOf(policies.toSortedMap()))
+        if (encode(policy).toByteArray().size > MAX_BYTES) oversized("Canonical policy exceeds 64 KiB")
+        return policy
+    }
+
+    private fun validateDomain(host: String): String {
+        val labels = host.split('.')
+        if (host.length > 253 || host.startsWith("www.") || labels.size < 2 || !labels.all(label::matches))
+            invalid("Expected normalized ASCII domain")
+        if (labels.size <= 4 && labels.all(ipv4Component::matches))
+            invalid("IP address is not a domain")
+        if (labels.any { it.startsWith("xn--") && IDN.toUnicode(it) == it }) invalid("Invalid IDNA label")
+        if (InternetDomainName.isValid(host) && InternetDomainName.from(host).isPublicSuffix) invalid("Public suffix is not a site")
+        return host
+    }
+
+    // Compact UTF-8, sorted object keys, original array order. No reflection on persisted field names.
+    fun toJson(policy: Policy): JsonObject = JsonObject().apply {
+        addProperty("default_session_min", policy.defaultSessionMin)
+        addProperty("reset_hour", 4)
+        addProperty("schema", 1)
+        add("sites", JsonObject().apply {
+            for ((id, group) in policy.sites.toSortedMap()) add(id, JsonObject().apply {
+                addProperty("budget_min", group.budgetMin)
+                add("domains", JsonArray().apply { group.domains.forEach(::add) })
+                add("exceptions", JsonArray().apply { group.exceptions.forEach(::add) })
+                addProperty("mode", if (group.limited) "limited" else "blocked")
+            })
+        })
+    }
+
+    fun encode(policy: Policy): String = toJson(policy).toString()
+}
diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyMatcher.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyMatcher.kt
new file mode 100644
index 0000000..29de335
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyMatcher.kt
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+internal class PolicyMatcher(policy: Policy) {
+    private data class Rule(val id: String, val limited: Boolean, val domains: Set<String>, val exceptions: Set<String>)
+    private val rules = policy.sites.map { (id, s) -> Rule(id, s.limited, s.domains.toSet(), s.exceptions.toSet()) }
+
+    fun blocks(host: String, openSites: Set<String>): Boolean = blocks(host, openSites::contains)
+
+    fun blocks(host: String, isOpen: (String) -> Boolean): Boolean {
+        val name = host.removeSuffix(".").lowercase(java.util.Locale.ROOT)
+        return rules.any { (!it.limited || !isOpen(it.id)) && matches(name, it.domains) && !matches(name, it.exceptions) }
+    }
+
+    companion object {
+        fun matches(host: String, entries: Set<String>): Boolean {
+            var name = host
+            while (name.isNotEmpty()) {
+                if (name in entries) return true
+                name = name.substringAfter('.', "")
+            }
+            return false
+        }
+    }
+}
diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt
new file mode 100644
index 0000000..b8ad1c1
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.util.AtomicFile
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import com.google.gson.JsonArray
+import com.google.gson.JsonObject
+import java.io.File
+import java.io.IOException
+import java.nio.ByteBuffer
+import java.nio.channels.FileChannel
+import java.nio.charset.StandardCharsets
+import java.nio.file.StandardOpenOption
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.Base64
+import java.util.UUID
+
+internal object JournalCodec {
+    // 64 replies of at most 96 KiB, base64 encoded, plus policy and 1000 accounts.
+    const val MAX_BYTES = 9 * 1024 * 1024
+    private val hashPattern = Regex("[0-9a-f]{64}")
+    private const val MAX_REPLY = 96 * 1024
+    private fun utf8(bytes: ByteArray) = StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(bytes)).toString()
+
+    private fun validate(state: JournalState) {
+        require(state.revision >= 0 && state.bootCount >= 0)
+        require(state.accounts.size <= 1000 && state.accounts.keys.containsAll(state.policy.sites.keys))
+        for ((id, account) in state.accounts) {
+            require(siteId.matches(id) && account.spentSeconds in 0..86400)
+            val s = account.session ?: continue
+            val group = state.policy.sites[id]
+            require(group != null && group.limited)
+            require(s.startMs >= 0 && s.deadlineMs > s.startMs && s.deadlineMs - s.startMs <= 86400000)
+            require(account.spentSeconds + s.reservedSeconds <= group.budgetMin * 60)
+        }
+        require(state.receipts.size <= 64 && state.receipts.distinctBy { it.requestId }.size == state.receipts.size)
+        for (r in state.receipts) {
+            require(UUID.fromString(r.requestId).toString() == r.requestId && hashPattern.matches(r.requestHash))
+            require(r.replyJson.toByteArray().size in 1..MAX_REPLY)
+        }
+    }
+
+    fun encode(state: JournalState): ByteArray {
+        validate(state)
+        val body = JsonObject().apply {
+            addProperty("format", 1)
+            add("policy", PolicyCodec.toJson(state.policy))
+            addProperty("timezone", state.timezone.id)
+            addProperty("day_id", state.dayId.toString())
+            addProperty("boot_count", state.bootCount)
+            addProperty("revision", state.revision)
+            add("accounts", JsonObject().apply {
+                for ((id, account) in state.accounts) add(id, JsonObject().apply {
+                    addProperty("spent", account.spentSeconds)
+                    account.session?.let { s ->
+                        add("session", JsonObject().apply {
+                            addProperty("start_ms", s.startMs)
+                            addProperty("deadline_ms", s.deadlineMs)
+                            addProperty("reserved", s.reservedSeconds)
+                            addProperty("warned", s.warned)
+                        })
+                    }
+                })
+            })
+            add("receipts", JsonArray().apply {
+                for (r in state.receipts) add(JsonObject().apply {
+                    addProperty("id", r.requestId)
+                    addProperty("hash", r.requestHash)
+                    addProperty("reply_b64", Base64.getEncoder().encodeToString(r.replyJson.toByteArray()))
+                })
+            })
+        }
+        return JsonObject().apply {
+            addProperty("sha256", sha256(body.toString().toByteArray()))
+            add("state", body)
+        }.toString().toByteArray()
+    }
+
+    fun decode(bytes: ByteArray): JournalState {
+        require(bytes.size <= MAX_BYTES)
+        val envelope = strictJson(utf8(bytes)).obj()
+        envelope.fields("sha256", "state")
+        val body = envelope["state"].obj()
+        require(sha256(body.toString().toByteArray()) == envelope["sha256"].string())
+        body.fields("format", "policy", "timezone", "day_id", "boot_count", "revision", "accounts", "receipts")
+        body["format"].number(1, 1)
+        val records = body["accounts"].obj()
+        require(records.size() <= 1000)
+        val accounts = records.entrySet().associate { (id, entry) ->
+            val a = entry.obj()
+            val session = if (a.has("session")) {
+                a.fields("spent", "session")
+                val s = a["session"].obj()
+                s.fields("start_ms", "deadline_ms", "reserved", "warned")
+                val warned = s["warned"]
+                require(warned.isJsonPrimitive && warned.asJsonPrimitive.isBoolean)
+                Session(s["start_ms"].number(0, Long.MAX_VALUE), s["deadline_ms"].number(0, Long.MAX_VALUE),
+                    warned.asBoolean).also { require(it.reservedSeconds.toLong() == s["reserved"].number(1, 86400)) }
+            } else {
+                a.fields("spent")
+                null
+            }
+            id to Account(a["spent"].number(0, 86400).toInt(), session)
+        }
+        val history = body["receipts"].array()
+        require(history.size() <= 64)
+        val receipts = history.map { entry ->
+            val r = entry.obj()
+            r.fields("id", "hash", "reply_b64")
+            MutationReceipt(r["id"].string(), r["hash"].string(), utf8(Base64.getDecoder().decode(r["reply_b64"].string())))
+        }
+        return JournalState(PolicyCodec.fromJson(body["policy"]), ZoneId.of(body["timezone"].string()),
+            LocalDate.parse(body["day_id"].string()), body["boot_count"].number(0, Int.MAX_VALUE.toLong()).toInt(),
+            body["revision"].number(0, Long.MAX_VALUE), ImmutableMap.copyOf(accounts), ImmutableList.copyOf(receipts)
+        ).also(::validate)
+    }
+}
+
+internal class StateStore(private val file: File, private val beforeFinish: () -> Unit = {}) {
+    private val atomic = AtomicFile(file)
+
+    // Provider, VPN and UI share one process. Serialize even across separate store handles.
+    private companion object { val journalLock = Any() }
+
+    fun loadOrCreate(initial: () -> JournalState): JournalState = synchronized(journalLock) {
+        if (listOf(file, File(file.path + ".bak"), File(file.path + ".new")).any { it.exists() }) {
+            read()
+        } else {
+            val state = initial()
+            save(state)
+            state
+        }
+    }
+
+    private fun readBytes(): ByteArray = atomic.openRead().use { stream ->
+        val size = stream.channel.size()
+        if (size !in 1L..JournalCodec.MAX_BYTES.toLong()) throw IOException("Invalid journal size")
+        val data = ByteArray(size.toInt())
+        java.io.DataInputStream(stream).readFully(data)
+        if (stream.read() != -1) throw IOException("Journal grew during read")
+        data
+    }
+
+    fun read(): JournalState = synchronized(journalLock) {
+        try {
+            JournalCodec.decode(readBytes())
+        } catch (e: Exception) {
+            throw IOException("Cannot read Stopscroll journal", e)
+        }
+    }
+
+    /** No effects escape this call until the complete transition has been committed. */
+    fun update(transform: (JournalState) -> Transition): Transition = synchronized(journalLock) {
+        val previous = read()
+        val next = transform(previous)
+        if (next.state != previous) save(next.state)
+        next
+    }
+
+    private fun syncDirectory(dir: File) {
+        FileChannel.open(dir.toPath(), StandardOpenOption.READ).use { it.force(true) }
+    }
+
+    private fun save(state: JournalState) {
+        try {
+            val data = JournalCodec.encode(state)
+            val dir = requireNotNull(file.parentFile)
+            if (!dir.exists()) {
+                if (!dir.mkdir()) throw IOException("Cannot create journal directory")
+                syncDirectory(requireNotNull(dir.parentFile))
+            }
+            val stream = atomic.startWrite()
+            try {
+                stream.write(data)
+                // AtomicFile.finishWrite logs some sync/rename failures without throwing.
+                stream.fd.sync()
+                beforeFinish()
+            } catch (e: Exception) {
+                atomic.failWrite(stream)
+                throw e
+            }
+            atomic.finishWrite(stream)
+            syncDirectory(dir)
+            if (!readBytes().contentEquals(data)) throw IOException("Journal commit did not publish expected bytes")
+        } catch (e: Exception) {
+            throw IOException("Cannot commit Stopscroll journal", e)
+        }
+    }
+}

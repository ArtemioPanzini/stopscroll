@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+internal data class ClockSample(val wallMs: Long, val elapsedMs: Long, val bootCount: Int) {
+    init { require(elapsedMs >= 0 && bootCount >= 0) }
+}
+
+private fun LocalDate.resetMs(zone: ZoneId) = atTime(4, 0).atZone(zone).toInstant().toEpochMilli()
+
+private fun dayAt(clock: ClockSample, zone: ZoneId): LocalDate {
+    val date = Instant.ofEpochMilli(clock.wallMs).atZone(zone).toLocalDate()
+    return if (clock.wallMs < date.resetMs(zone)) date.minusDays(1) else date
+}
+
+internal fun roundedSeconds(durationMs: Long): Int = ((durationMs + 999) / 1000).toInt()
+
+internal data class Session(val startMs: Long, val deadlineMs: Long, val warned: Boolean = false) {
+    val reservedSeconds get() = roundedSeconds(deadlineMs - startMs)
+    fun consumed(elapsedMs: Long) = roundedSeconds(elapsedMs.coerceIn(startMs, deadlineMs) - startMs)
+}
+
+internal data class Account(val spentSeconds: Int = 0, val session: Session? = null)
+
+// Task 3 owns the protocol envelope. Persist opaque replies alongside their request hashes.
+internal data class MutationReceipt(val requestId: String, val requestHash: String, val replyJson: String)
+
+internal data class JournalState(
+    val policy: Policy, val timezone: ZoneId, val dayId: LocalDate, val bootCount: Int,
+    val revision: Long, val accounts: ImmutableMap<String, Account>,
+    val receipts: ImmutableList<MutationReceipt> = ImmutableList.of()
+) {
+    fun withReceipt(receipt: MutationReceipt): JournalState {
+        val recent = receipts.filterNot { it.requestId == receipt.requestId }.takeLast(63)
+        return copy(receipts = ImmutableList.copyOf(recent + receipt))
+    }
+
+    companion object {
+        fun initial(timezone: ZoneId, clock: ClockSample, policy: Policy = Policy.EMPTY) =
+            JournalState(policy, timezone, dayAt(clock, timezone), clock.bootCount, 0,
+                ImmutableMap.copyOf(policy.sites.keys.associateWith { Account() }))
+    }
+}
+
+internal enum class EffectKind { OPEN, CLOSE, WARN, RECONFIGURE }
+internal data class Effect(val kind: EffectKind, val site: String? = null)
+internal data class Transition(val state: JournalState, val effects: List<Effect>, val error: String? = null)
+internal data class SiteBudget(val remainingSeconds: Int, val reservedSeconds: Int, val session: Session?) {
+    val unreservedSeconds get() = remainingSeconds - reservedSeconds
+}
+internal data class PolicySnapshot(
+    val policy: Policy, val revision: Long, val timezone: ZoneId, val dayId: LocalDate,
+    val bootCount: Int, val sites: ImmutableMap<String, SiteBudget>, val admissionOpen: Boolean = true
+) {
+    private val matcher = PolicyMatcher(policy)
+    private val nextReset = dayId.plusDays(1).resetMs(timezone)
+
+    private val active = sites.values.mapNotNull { it.session }
+    private val firstDeadline = active.minOfOrNull { it.deadlineMs }
+    private val lastStart = active.maxOfOrNull { it.startMs } ?: 0L
+
+    fun resetElapsed(clock: ClockSample) = clock.elapsedMs + (nextReset - clock.wallMs).coerceAtLeast(0)
+
+    fun cutoffAt(clock: ClockSample): Long? = firstDeadline?.let { minOf(it, resetElapsed(clock)) }
+
+    fun closedAcrossReset(clock: ClockSample) =
+        firstDeadline == null && clock.bootCount == bootCount && clock.wallMs >= nextReset
+
+    fun validAt(clock: ClockSample) = bootCount == clock.bootCount && clock.wallMs < nextReset &&
+        clock.elapsedMs >= lastStart && (firstDeadline == null || clock.elapsedMs < firstDeadline)
+
+    /** Even a previously published snapshot cannot grant past its deadline. */
+    fun blocks(host: String, clock: ClockSample): Boolean {
+        if (!admissionOpen) return true
+        return matcher.blocks(host) { id ->
+            val s = sites[id]?.session
+            s != null && clock.bootCount == bootCount && clock.wallMs < nextReset &&
+                clock.elapsedMs >= s.startMs && clock.elapsedMs < s.deadlineMs
+        }
+    }
+}
+
+internal interface LimitEngine {
+    fun open(site: String, seconds: Int, clock: ClockSample): Transition
+    fun close(site: String, clock: ClockSample): Transition
+    fun tick(clock: ClockSample): Transition
+    fun replacePolicy(policy: Policy, clock: ClockSample): Transition
+    fun snapshot(clock: ClockSample): PolicySnapshot
+}
+
+/** Each invocation starts with exactly the supplied journal. Only StateStore commits a transition. */
+internal class BudgetEngine(private val state: JournalState) : LimitEngine {
+    private class Update(val original: JournalState, val clock: ClockSample) {
+        val accounts = original.accounts.toMutableMap()
+        val effects = mutableListOf<Effect>()
+        var policy = original.policy
+        var day = original.dayId
+        var changed = false
+
+        init {
+            val observedDay = dayAt(clock, original.timezone)
+            if (observedDay > day) {
+                for ((id, account) in accounts) if (account.session != null) effects.add(Effect(EffectKind.CLOSE, id))
+                accounts.clear()
+                policy.sites.keys.forEach { accounts[it] = Account() }
+                day = observedDay
+                changed = true
+            }
+            val rebooted = original.bootCount != clock.bootCount
+            if (rebooted) changed = true
+            for ((id, account) in accounts) {
+                val s = account.session ?: continue
+                if (rebooted || clock.elapsedMs < s.startMs || clock.elapsedMs >= s.deadlineMs) {
+                    settle(id, full = true)
+                } else if (!s.warned && s.deadlineMs - s.startMs > 120000 && s.deadlineMs - clock.elapsedMs <= 120000) {
+                    accounts[id] = account.copy(session = s.copy(warned = true))
+                    effects.add(Effect(EffectKind.WARN, id))
+                }
+            }
+        }
+
+        fun settle(id: String, full: Boolean = false) {
+            val account = accounts.getValue(id)
+            val s = account.session ?: return
+            val used = if (full) s.reservedSeconds else s.consumed(clock.elapsedMs)
+            accounts[id] = Account(account.spentSeconds + used)
+            effects.remove(Effect(EffectKind.WARN, id))
+            effects.add(Effect(EffectKind.CLOSE, id))
+            changed = true
+        }
+
+        fun result(error: String? = null): Transition {
+            val next = if (changed || effects.isNotEmpty()) original.copy(
+                policy = policy, accounts = ImmutableMap.copyOf(accounts), dayId = day, bootCount = clock.bootCount,
+                revision = if (changed) Math.incrementExact(original.revision) else original.revision
+            ) else original
+            return Transition(next, ImmutableList.copyOf(effects), error)
+        }
+    }
+
+    override fun open(site: String, seconds: Int, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (seconds <= 0) return u.result("INVALID_REQUEST")
+        val rule = state.policy.sites[site]
+        if (rule?.limited != true) return u.result("NOT_LIMITED")
+        val account = u.accounts.getValue(site)
+        if (account.session != null) return u.result("SESSION_ACTIVE")
+        val available = rule.budgetMin * 60 - account.spentSeconds
+        if (available <= 0) return u.result("NO_BUDGET")
+        val untilReset = u.day.plusDays(1).resetMs(state.timezone) - clock.wallMs
+        val duration = minOf(minOf(available, seconds) * 1000L, untilReset)
+        val s = Session(clock.elapsedMs, Math.addExact(clock.elapsedMs, duration))
+        u.accounts[site] = account.copy(session = s)
+        u.changed = true
+        u.effects.add(Effect(EffectKind.OPEN, site))
+        return u.result()
+    }
+
+    override fun close(site: String, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (state.policy.sites[site]?.limited != true) return u.result("NOT_LIMITED")
+        u.settle(site)
+        return u.result()
+    }
+
+    override fun replacePolicy(policy: Policy, clock: ClockSample): Transition {
+        val u = Update(state, clock)
+        if (policy == state.policy) return u.result()
+        if (u.accounts.size + policy.sites.keys.count { it !in u.accounts } > 1000) return u.result("TOO_LARGE")
+        for (id in u.accounts.keys) u.settle(id)
+        for (id in policy.sites.keys) u.accounts.putIfAbsent(id, Account())
+        u.changed = true
+        u.policy = policy
+        u.effects.add(Effect(EffectKind.RECONFIGURE))
+        return u.result()
+    }
+
+    override fun tick(clock: ClockSample): Transition = Update(state, clock).result()
+
+    override fun snapshot(clock: ClockSample): PolicySnapshot {
+        val current = tick(clock).state
+        val budgets = current.policy.sites.mapValues { (id, group) ->
+            val account = current.accounts.getValue(id)
+            val s = account.session
+            val consumed = s?.consumed(clock.elapsedMs) ?: 0
+            SiteBudget((group.budgetMin * 60 - account.spentSeconds - consumed).coerceAtLeast(0),
+                (s?.reservedSeconds ?: 0) - consumed, s)
+        }
+        return PolicySnapshot(current.policy, state.revision, current.timezone, current.dayId,
+            current.bootCount, ImmutableMap.copyOf(budgets))
+    }
+}

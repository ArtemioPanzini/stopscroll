+package com.celzero.bravedns.stopscroll
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class G0DomainsTest {
+    @Test
+    fun `matches DNS labels and honors exceptions for entire subtrees`() {
+        val policy = G0Domains.create(listOf("YouTube.COM."), listOf("accounts.youtube.com"))
+
+        assertTrue(policy.blocks("YOUTUBE.COM."))
+        assertTrue(policy.blocks("www.youtube.com"))
+        assertFalse(policy.blocks("notyoutube.com"))
+        assertFalse(policy.blocks("youtube.com.example"))
+        assertFalse(policy.blocks("accounts.youtube.com."))
+        assertFalse(policy.blocks("login.accounts.youtube.com"))
+        assertFalse(policy.blocks("accounts.google.com"))
+    }
+
+    @Test
+    fun `rejects invalid or oversized inputs before replacing anything`() {
+        for (bad in listOf("", "*.example.com", "a..example", "a.test..", "https://test", "-a.test")) {
+            assertThrows(IllegalArgumentException::class.java) { G0Domains.create(listOf(bad), emptyList()) }
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            G0Domains.create(List(1_001) { "domain$it.example" }, emptyList())
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            G0Domains.create(List(700) { "${"a".repeat(60)}.${"b".repeat(60)}.$it.example" }, emptyList())
+        }
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/LimitEngineTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/LimitEngineTest.kt
new file mode 100644
index 0000000..ee1cc51
--- /dev/null
+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/LimitEngineTest.kt
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.time.Instant
+import java.time.ZoneId
+import org.junit.Assert.*
+import org.junit.Test
+
+class LimitEngineTest {
+    @Test fun budgetVectors() {
+        val vectors = fixture("budget")
+        val zone = ZoneId.of(vectors["zone"].asString)
+        for (scenario in vectors["scenarios"].asJsonArray.map { it.asJsonObject }) {
+            var clock = ClockSample(Instant.parse(scenario["start"].asString).toEpochMilli(), 10000, 4)
+            var state = JournalState.initial(zone, clock, examplePolicy())
+            for (step in scenario["steps"].asJsonArray.map { it.asJsonObject }) {
+                val op = step["op"].asString
+                val dt = step["after_ms"]?.asLong ?: 0
+                clock = ClockSample(clock.wallMs + (step["wall_delta_ms"]?.asLong ?: dt),
+                    if (op == "reboot") 30 else clock.elapsedMs + dt, clock.bootCount + if (op == "reboot") 1 else 0)
+                if (op == "restore" || op == "reboot") state = JournalCodec.decode(JournalCodec.encode(state))
+                val engine = BudgetEngine(state)
+                val transition = when (op) {
+                    "open" -> engine.open("video", step["seconds"].asInt, clock)
+                    "close" -> engine.close("video", clock)
+                    "tick", "restore", "reboot" -> engine.tick(clock)
+                    "same" -> engine.replacePolicy(examplePolicy(), clock)
+                    "limit" -> engine.replacePolicy(examplePolicy(step["minutes"].asInt), clock)
+                    "remove" -> engine.replacePolicy(Policy.EMPTY, clock)
+                    else -> error(op)
+                }
+                state = transition.state
+                val label = scenario["name"].asString + " " + step
+                val status = BudgetEngine(state).snapshot(clock).sites["video"]
+                assertEquals(label, step["error"]?.asString, transition.error)
+                step["remaining"]?.let { assertEquals(label, it.asInt, status!!.remainingSeconds) }
+                step["reserved"]?.let { assertEquals(label, it.asInt, status!!.reservedSeconds) }
+                step["day"]?.let { assertEquals(label, it.asString, state.dayId.toString()) }
+                step["revision"]?.let { assertEquals(label, it.asLong, state.revision) }
+                step["effects"]?.let { expected ->
+                    assertEquals(label, expected.asJsonArray.map { it.asString }, transition.effects.map { it.kind.name })
+                }
+            }
+        }
+    }
+
+    @Test fun historyBoundNeverEvictsAndNewDayAdvancesRevision() {
+        var clock = ClockSample(Instant.parse("2026-07-12T12:00:00Z").toEpochMilli(), 0, 2)
+        var state = JournalState.initial(ZoneId.of("UTC"), clock, examplePolicy())
+        state = BudgetEngine(state).open("video", 100, clock).state
+        clock = clock.copy(elapsedMs = 4500)
+        state = BudgetEngine(state).close("video", clock).state
+        fun batch(first: Int, count: Int): Policy {
+            val doc = fixture("policy")["policy"].asJsonObject
+            val sites = doc["sites"].asJsonObject
+            val rule = sites.remove("video")
+            sites.remove("news")
+            repeat(count) { sites.add("g" + (first + it), rule) }
+            return PolicyCodec.decode(doc.toString())
+        }
+        repeat(10) { state = BudgetEngine(state).replacePolicy(batch(it * 100, if (it == 9) 98 else 100), clock).state }
+        assertEquals(1000, state.accounts.size)
+        val denied = BudgetEngine(state).replacePolicy(batch(2000, 1), clock)
+        assertEquals("TOO_LARGE", denied.error)
+        assertEquals(state, denied.state)
+        val restored = BudgetEngine(state).replacePolicy(examplePolicy(), clock).state
+        assertEquals(2695, BudgetEngine(restored).snapshot(clock).sites.getValue("video").remainingSeconds)
+        clock = clock.copy(wallMs = clock.wallMs + 86400000)
+        val next = BudgetEngine(restored).replacePolicy(batch(2000, 1), clock)
+        assertNull(next.error)
+        assertTrue(next.state.revision > restored.revision)
+        assertEquals(3, next.state.accounts.size)
+    }
+
+    @Test fun resetUsesActualCalendarBoundaryAcrossDstAndFractions() {
+        val zone = ZoneId.of("Europe/Belgrade")
+        for ((start, hours) in listOf("2026-03-28T03:00:00Z" to 23, "2026-10-24T04:00:00Z" to 23)) {
+            val clock = ClockSample(Instant.parse(start).toEpochMilli(), 100, 7)
+            val initial = JournalState.initial(zone, clock, examplePolicy(1440))
+            val opened = BudgetEngine(initial).open("video", 86400, clock)
+            assertEquals(hours * 3600, opened.state.accounts.getValue("video").session!!.reservedSeconds)
+        }
+        val clock = ClockSample(Instant.parse("2026-07-12T01:59:59.750Z").toEpochMilli(), 200, 4)
+        val state = BudgetEngine(JournalState.initial(zone, clock, examplePolicy())).open("video", 60, clock).state
+        val s = state.accounts.getValue("video").session!!
+        assertEquals(450L, s.deadlineMs)
+        assertEquals(1, s.reservedSeconds)
+        val snapshot = BudgetEngine(state).snapshot(clock)
+        assertFalse(snapshot.blocks("video.example.org", clock))
+        assertTrue(snapshot.blocks("video.example.org", clock.copy(elapsedMs = 450)))
+        assertTrue(snapshot.blocks("video.example.org", clock.copy(wallMs = clock.wallMs + 250)))
+        assertTrue(snapshot.blocks("video.example.org", clock.copy(bootCount = 5)))
+        assertTrue(snapshot.blocks("video.example.org", clock.copy(elapsedMs = 100)))
+    }
+
+    @Test fun replacementClosesEveryActiveGroupAndAccountsIndependently() {
+        val doc = fixture("policy")["policy"].asJsonObject
+        val sites = doc["sites"].asJsonObject
+        sites.add("second", sites["video"].deepCopy())
+        val policy = PolicyCodec.decode(doc.toString())
+        val c = ClockSample(1000000000, 0, 1)
+        val first = BudgetEngine(JournalState.initial(ZoneId.of("UTC"), c, policy)).open("video", 200, c).state
+        assertTrue(BudgetEngine(first).snapshot(c).blocks("video.example.org", c))
+        val later = c.copy(elapsedMs = 1500)
+        val both = BudgetEngine(first).open("second", 150, later).state
+        assertFalse(BudgetEngine(both).snapshot(later).blocks("video.example.org", later))
+        val closed = BudgetEngine(both).replacePolicy(Policy.EMPTY, c.copy(elapsedMs = 2200))
+        assertEquals(setOf("video", "second"), closed.effects.filter { it.kind == EffectKind.CLOSE }.map { it.site }.toSet())
+        assertEquals(3, closed.state.accounts.getValue("video").spentSeconds)
+        assertEquals(1, closed.state.accounts.getValue("second").spentSeconds)
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/PolicyMatcherTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/PolicyMatcherTest.kt
new file mode 100644
index 0000000..0df5ae2
--- /dev/null
+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/PolicyMatcherTest.kt
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonObject
+import com.google.gson.JsonParser
+import org.junit.Assert.*
+import org.junit.Test
+
+internal fun fixture(name: String): JsonObject =
+    PolicyMatcherTest::class.java.getResourceAsStream("/$name.json")!!.bufferedReader().use {
+        JsonParser.parseReader(it).asJsonObject
+    }
+
+internal fun examplePolicy(minutes: Int = 45): Policy {
+    val doc = fixture("policy")["policy"].asJsonObject
+    doc["sites"].asJsonObject["video"].asJsonObject.addProperty("budget_min", minutes)
+    return PolicyCodec.decode(doc.toString())
+}
+
+class PolicyMatcherTest {
+    private val vectors = fixture("policy")
+    private val doc = vectors["policy"].asJsonObject
+
+    @Test fun labelBoundariesAndIndependentGroups() {
+        val matcher = PolicyMatcher(PolicyCodec.decode(doc.toString()))
+        for (case in vectors["matches"].asJsonArray.map { it.asJsonObject }) {
+            val open = case["open"].asJsonArray.map { it.asString }.toSet()
+            assertEquals(case.toString(), case["blocked"].asBoolean, matcher.blocks(case["host"].asString, open))
+        }
+    }
+
+    private fun domains(values: List<String>): JsonObject = doc.deepCopy().apply {
+        val site = getAsJsonObject("sites").getAsJsonObject("news")
+        site.add("domains", com.google.gson.JsonArray().also { a -> values.forEach(a::add) })
+    }
+
+    @Test fun normalizedPolicyDomainsAndScope() {
+        for (domain in vectors["valid_domains"].asJsonArray) PolicyCodec.decode(domains(listOf(domain.asString)).toString())
+        for (domain in vectors["invalid_domains"].asJsonArray) invalid(domains(listOf(domain.asString)).toString())
+        invalid(doc.toString().replace("accounts.video.example.org", "other.example.org"))
+    }
+
+    private fun invalid(raw: String, code: String = "INVALID_REQUEST") {
+        assertEquals(raw.take(60), code, assertThrows(PolicyException::class.java) { PolicyCodec.decode(raw) }.code)
+    }
+
+    @Test fun strictJsonAndSchema() {
+        for (field in vectors["invalid_root_fields"].asJsonArray) invalid(doc.deepCopy().apply { addProperty(field.asString, 1) }.toString())
+        val raw = doc.toString()
+        invalid(raw.replace("\"schema\":1", "\"schema\":2"), "UNSUPPORTED_SCHEMA")
+        invalid(raw.replace("\"schema\":1", "\"schema\":1,\"schema\":1"))
+        invalid(raw.replace("\"reset_hour\":4", "\"reset_hour\":3"))
+        invalid(raw.replace("\"video\":{", "\"Video\":{"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":\"45\""))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":45.0"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":0"))
+        invalid(raw.replace("\"budget_min\":0", "\"budget_min\":1"))
+        invalid(raw.replace("\"budget_min\":45", "\"budget_min\":45,\"spent\":1"))
+        invalid(raw.replace("\"default_session_min\":15", "\"default_session_min\":1441"))
+        invalid(raw.replace("\"mode\":\"limited\",", ""))
+        invalid(raw + "{}")
+        invalid(raw.replace("\"schema\"", "'schema'"))
+    }
+
+    @Test fun structuredNumbersRequireIntegerTokensWithinRange() {
+        fun withBudget(value: com.google.gson.JsonElement) = doc.deepCopy().apply {
+            getAsJsonObject("sites").getAsJsonObject("video").add("budget_min", value)
+        }
+        assertEquals(45, PolicyCodec.fromJson(withBudget(JsonParser.parseString("45"))).sites.getValue("video").budgetMin)
+        val invalidTokens = listOf("45.0", "45.9", "45e0", "18446744073709551661", "0", "1441", "true", "\"45\"")
+        val invalidValues = invalidTokens.map(JsonParser::parseString) + listOf("+45", "045").map {
+            // Simulate a numeric tree built by another decoder. Strict JSON input cannot contain these tokens.
+            com.google.gson.JsonPrimitive(com.google.gson.internal.LazilyParsedNumber(it))
+        }
+        for (bad in invalidValues) {
+            val error = assertThrows("unexpectedly accepted ${bad.asString}", PolicyException::class.java) { PolicyCodec.fromJson(withBudget(bad)) }
+            assertEquals("INVALID_REQUEST", error.code)
+        }
+    }
+
+    @Test fun canonicalHashAndLimits() {
+        val policy = PolicyCodec.decode(doc.toString())
+        assertEquals(policy, PolicyCodec.decode(PolicyCodec.encode(policy)))
+        assertEquals(vectors["canonical_sha256"].asString, policy.hash)
+        val sites = doc.deepCopy()
+        val groups = sites["sites"].asJsonObject
+        groups.remove("video")
+        val news = groups.remove("news")
+        val limits = vectors["limits"].asJsonObject
+        repeat(limits["groups"].asInt) { groups.add("g$it", news) }
+        PolicyCodec.decode(sites.toString())
+        groups.add("more", news)
+        invalid(sites.toString(), "TOO_LARGE")
+        val entries = List(limits["entries"].asInt - 2) { "x$it.example" }
+        PolicyCodec.decode(domains(entries).toString())
+        invalid(domains(entries + "extra.example").toString(), "TOO_LARGE")
+        val base = List(998) { "a.example" }
+        val target = limits["canonical_bytes"].asInt
+        val padding = target - domains(base).toString().toByteArray().size
+        val exact = base.mapIndexed { index, host ->
+            val extra = padding / base.size + if (index < padding % base.size) 1 else 0
+            "x".repeat(extra - 1) + "." + host
+        }
+        assertEquals(target, PolicyCodec.encode(PolicyCodec.decode(domains(exact).toString())).toByteArray().size)
+        invalid(domains(exact.toMutableList().also { it[0] = "x" + it[0] }).toString(), "TOO_LARGE")
+        val large = domains(entries.map { "x".repeat(60) + "." + it })
+        assertTrue(large.toString().toByteArray().size > limits["canonical_bytes"].asInt)
+        invalid(large.toString(), "TOO_LARGE")
+    }
+}

+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class ControllerTest {
+    @get:Rule val folder = TemporaryFolder()
+    private val file get() = File(folder.root, "stopscroll/state.json")
+    private var clock = ClockSample(1783850400000, 7000, 12)
+    private val initial get() = JournalState.initial(ZoneId.of("Europe/Belgrade"), clock, examplePolicy())
+    private val target = TestTunnel()
+    private val timers = TestTimers()
+    private val engine = EngineAdapter({ clock }, timers)
+    private val store by lazy { StateStore(file) }
+    private fun controller(source: StateStore = store) =
+        StopscrollController(source, { initial }, { clock }, engine, timers, { target.platform() })
+    private fun attach() {
+        engine.register(target.owner)
+        engine.attach(target)
+        engine.installPreferred(target) {}
+    }
+    private fun request(op: String, revision: Long? = null, minutes: Int = 5) =
+        RpcRequest(UUID.randomUUID().toString(), op, JsonObject().apply {
+            if (op.startsWith("session.")) addProperty("site", "video")
+            if (op == "session.open") addProperty("minutes", minutes)
+        }, revision)
+    private fun RpcReply.code() = json["error"].asJsonObject["code"].asString
+
+    @Test fun reservePrecedesGrantAndRestartReplaysOriginalReply() {
+        attach()
+        val c = controller()
+        c.reconcile()
+        target.refresh = {
+            assertEquals(300, store.read().accounts.getValue("video").session!!.reservedSeconds)
+            assertNull(engine.receipt(target))
+        }
+        val open = request("session.open", 0)
+        val reply = c.execute(open)
+        assertTrue(reply.json.toString(), reply.ok)
+        assertFalse(engine.receipt(target)!!.snapshot.blocks("video.example.org", clock))
+        target.refresh = {}
+        val close = c.execute(request("session.close", 1))
+        assertTrue(close.ok)
+        val replay = controller().execute(open)
+        assertEquals(reply.json, replay.json)
+        assertNull(store.read().accounts["video"]!!.session)
+        assertEquals("CONFLICT", c.execute(open.copy(expectedRevision = 2)).code())
+    }
+
+    @Test fun concurrentUiAndUsbAreOneBudgetAndOneRevision() {
+        attach()
+        val c = controller()
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val replies = (1..2).map { pool.submit<RpcReply> { c.execute(request("session.open", 0)) } }
+                .map { it.get(10, SECONDS) }
+            assertEquals(1, replies.count { it.ok })
+            assertEquals("CONFLICT", replies.single { !it.ok }.code())
+            assertEquals(1L, store.read().revision)
+        } finally { pool.shutdownNow() }
+    }
+
+    @Test fun cutoffSweepsWithoutWaitingForTheWriterAndStaleAlarmCannotSweepAgain() {
+        attach()
+        val entered = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        var stall = false
+        val c = controller(StateStore(file, beforeFinish = {
+            if (stall) {
+                entered.countDown()
+                check(resume.await(10, SECONDS))
+            }
+        }))
+        assertTrue(c.execute(request("session.open", 0)).ok)
+        val alarm = timers.cutoff!!
+        stall = true
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val write = pool.submit<RpcReply> { c.execute(request("session.open", 1)) }
+            assertTrue(entered.await(10, SECONDS))
+            val swept = CountDownLatch(1)
+            target.close = { swept.countDown() }
+            clock = clock.copy(elapsedMs = clock.elapsedMs + 300000)
+            val expiry = pool.submit { alarm() }
+            assertTrue(swept.await(2, SECONDS))
+            assertNull(engine.receipt(target))
+            resume.countDown()
+            write.get(10, SECONDS)
+            expiry.get(10, SECONDS)
+            assertTrue(c.execute(request("session.open", 2)).ok)
+            val before = engine.receipt(target)
+            alarm()
+            assertSame(before, engine.receipt(target))
+        } finally { resume.countDown(); pool.shutdownNow() }
+    }
+
+    @Test fun warningAndRepeatedStatusDoNotResetTransport() {
+        attach()
+        val c = controller()
+        assertTrue(c.execute(request("session.open", 0)).ok)
+        val count = target.sweeps
+        clock = clock.copy(elapsedMs = clock.elapsedMs + 180000)
+        repeat(5) { assertTrue(c.execute(request("status")).ok) }
+        assertEquals(count, target.sweeps)
+        assertEquals(1L, store.read().revision)
+        assertTrue(store.read().accounts["video"]!!.session!!.warned)
+        assertEquals(listOf("video"), timers.warnings)
+    }
+
+    @Test fun storageErrorAfterNativeGrantClosesForwardingAndPendingReplaySettlesOnce() {
+        attach()
+        store.loadOrCreate { initial }
+        val open = request("session.open", 0)
+        var writes = 0
+        var authorizedBeforeCrash = false
+        val fault = StateStore(file, beforeFinish = {
+            if (++writes == 2) {
+                authorizedBeforeCrash = engine.receipt(target) != null
+                throw java.io.IOException("lost final receipt")
+            }
+        })
+        val result = controller(fault).execute(open)
+        assertEquals("STORAGE_ERROR", result.code())
+        assertTrue(authorizedBeforeCrash)
+        assertNull(engine.receipt(target))
+        assertEquals(1L, store.read().revision)
+        assertNotNull(store.read().accounts["video"]!!.session)
+        clock = clock.copy(elapsedMs = clock.elapsedMs + 1500)
+        val after = controller()
+        val replay = after.execute(open)
+        assertEquals("APPLY_FAILED", replay.code())
+        assertTrue(replay.json["saved"].asBoolean)
+        assertEquals(replay.json, after.execute(open).json)
+        assertNull(store.read().accounts["video"]!!.session)
+        assertEquals(2, store.read().accounts["video"]!!.spentSeconds)
+        assertTrue(engine.receipt(target)!!.snapshot.blocks("video.example.org", clock))
+    }
+
+    @Test fun preNativeCrashConsumesPendingMutationWithoutApplyingItsGrant() {
+        attach()
+        val open = request("session.open", 0)
+        val crash = object : SessionTimers by timers {
+            override fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit =
+                throw AssertionError("simulated process loss after committed reservation")
+        }
+        val c = StopscrollController(store, { initial }, { clock }, engine, crash, { target.platform() })
+        assertThrows(AssertionError::class.java) { c.execute(open) }
+        assertEquals(0, target.sweeps)
+        assertNotNull(store.read().accounts["video"]!!.session)
+        val replay = controller().execute(open)
+        assertEquals("APPLY_FAILED", replay.code())
+        assertNull(store.read().accounts["video"]!!.session)
+        assertTrue(engine.receipt(target)!!.snapshot.blocks("video.example.org", clock))
+    }
+
+    @Test fun missingProductJournalNeverReinitializesAndAdmitsNothing() {
+        attach()
+        val c = controller()
+        assertTrue(c.execute(request("session.open", 0)).ok)
+        assertTrue(file.delete())
+        val failed = controller().execute(request("status"))
+        assertEquals("STORAGE_ERROR", failed.code())
+        assertNull(engine.receipt(target))
+        assertFalse(file.exists())
+    }
+
+    @Test fun adapterFailureDistinguishesSavedPolicyAndSettlesFailedOpen() {
+        attach()
+        val c = controller()
+        c.reconcile()
+        target.refresh = { error("injected native resolver error") }
+        val open = request("session.open", 0)
+        val failed = c.execute(open)
+        assertEquals("APPLY_FAILED", failed.code())
+        assertTrue(failed.json["saved"].asBoolean)
+        assertTrue(failed.json["applied_revision"].isJsonNull)
+        assertNull(engine.receipt(target))
+        assertTrue(c.snapshot().blocks("ordinary.example", clock))
+        assertNull(store.read().accounts["video"]!!.session)
+        val replacement = examplePolicy(20)
+        val replace = RpcRequest(UUID.randomUUID().toString(), "policy.replace",
+            JsonObject().apply { add("policy", PolicyCodec.toJson(replacement)) }, 2)
+        val result = c.execute(replace)
+        assertEquals("APPLY_FAILED", result.code())
+        assertEquals(replacement, store.read().policy)
+        val status = c.execute(request("status"))
+        assertTrue(status.ok)
+        assertEquals("degraded", status.json["data"].obj()["protection"].obj()["state"].string())
+        target.refresh = {}
+        assertEquals("active", c.execute(request("status")).json["data"].obj()["protection"].obj()["state"].string())
+        assertEquals(result.json, c.execute(replace).json)
+        assertEquals(3L, engine.receipt(target)?.snapshot?.revision)
+    }
+
+    @Test fun persistsOnlyLast64OutcomesIncludingConflictsAcrossRestart() {
+        attach()
+        val c = controller()
+        val queries = (1..65).map { request("session.close", 9) }
+        val results = queries.map { c.execute(it) }
+        assertTrue(results.all { it.code() == "CONFLICT" })
+        val history = store.read().receipts
+        assertEquals(queries.drop(1).map { it.requestId }, history.map { it.requestId })
+        val recovered = controller()
+        assertEquals(results[1].json, recovered.execute(queries[1]).json)
+        assertEquals("CONFLICT", recovered.execute(queries[1].copy(expectedRevision = 0)).code())
+        assertEquals(history, store.read().receipts)
+    }
+
+    @Test fun legacyMigrationKeepsScopedRulesAndRejectsCorruption() {
+        assertEquals(Policy.EMPTY, legacyPolicy(null))
+        val raw = """{"revision":7,"domains":["video.example.org"],"exceptions":["accounts.video.example.org"]}"""
+        val legacy = legacyPolicy(raw)
+        val first = JournalState.initial(ZoneId.of("UTC"), clock, legacy)
+        val c = StopscrollController(store, { first }, { clock }, engine, timers, { target.platform() })
+        attach()
+        c.reconcile()
+        assertTrue(c.snapshot().blocks("x.video.example.org", clock))
+        assertFalse(c.snapshot().blocks("accounts.video.example.org", clock))
+        assertEquals(setOf("legacy"), store.read().policy.sites.keys)
+        assertTrue(controller().execute(request("status")).ok)
+        assertEquals(legacy, store.read().policy)
+        assertThrows(IllegalArgumentException::class.java) { legacyPolicy(raw.replace("accounts.video.", "outside.")) }
+        assertThrows(IllegalArgumentException::class.java) { legacyPolicy("{broken") }
+    }
+
+    @Test fun savedProhibitionClosesAdmissionWhileTheNativeSweepIsStillRunning() {
+        attach()
+        val c = controller()
+        assertTrue(c.execute(request("session.open", 0)).ok)
+        val started = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        val pool = Executors.newSingleThreadExecutor()
+        target.close = { started.countDown(); check(resume.await(4, SECONDS)) }
+        try {
+            val close = pool.submit<RpcReply> { c.execute(request("session.close", 1)) }
+            assertTrue(started.await(3, SECONDS))
+            assertNull(engine.admitted(target, listOf("video.example.org")) { "stale permit" })
+            assertNull(store.read().accounts["video"]!!.session)
+            assertNull(engine.receipt(target))
+            resume.countDown()
+            assertTrue(close.get(3, SECONDS).ok)

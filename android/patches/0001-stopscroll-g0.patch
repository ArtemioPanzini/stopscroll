+++ b/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodecTest.kt
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonNull
+import com.google.gson.JsonObject
+import kotlin.io.encoding.Base64
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RpcCodecTest {
+    private val id = "12345678-90ab-4def-8123-456789abcdef"
+    private val policy = """
+        {"schema":1,"reset_hour":4,"default_session_min":15,"sites":{
+            "video":{"mode":"limited","budget_min":45,"domains":["video.example.org"],
+                "exceptions":["safe.video.example.org"]}
+        }}
+    """.trimIndent()
+
+    private fun request(
+        op: String = "status",
+        args: String = "{}",
+        revision: String? = null,
+        schema: String = "1",
+        requestId: String = id
+    ): String {
+        val expected = revision?.let { ""","expected_revision":$it""" }.orEmpty()
+        return """{"schema":$schema,"request_id":"$requestId","op":"$op","args":$args$expected}"""
+    }
+
+    private fun encode(raw: String) = Base64.encode(raw.toByteArray())
+    private fun decode(raw: String) = RpcCodec.decodeRequest(encode(raw))
+
+    private fun rejects(raw: String, code: String = "INVALID_REQUEST"): RpcDecodeException =
+        assertThrows(raw.take(160), RpcDecodeException::class.java) { decode(raw) }.also {
+            assertEquals(code, it.code)
+        }
+
+    @Test fun acceptsOnlyTheFiveSchemaOneOperations() {
+        for (op in listOf("status", "policy.get")) {
+            val read = decode(request(op))
+            assertEquals(id, read.requestId)
+            assertEquals(op, read.op)
+            assertEquals(0, read.args.size())
+            assertNull(read.expectedRevision)
+        }
+        val replace = decode(request("policy.replace", """{"policy":$policy}""", "0"))
+        assertEquals("policy.replace", replace.op)
+        assertEquals(0L, replace.expectedRevision)
+        assertEquals(45, PolicyCodec.fromJson(replace.args["policy"]).sites.getValue("video").budgetMin)
+        val openDefault = decode(request("session.open", """{"site":"video","minutes":null}""", "1"))
+        assertEquals("video", openDefault.args["site"].asString)
+        assertEquals(JsonNull.INSTANCE, openDefault.args["minutes"])
+        val openExplicit = decode(request("session.open", """{"minutes":1440,"site":"video"}""", "2"))
+        assertEquals(1440, openExplicit.args["minutes"].asInt)
+        val close = decode(request("session.close", """{"site":"video"}""", Long.MAX_VALUE.toString()))
+        assertEquals("session.close", close.op)
+        assertEquals(Long.MAX_VALUE, close.expectedRevision)
+    }
+
+    @Test fun rejectsBadBase64IncludingAlternativeRepresentationsOfTheSameBytes() {
+        val padded = request() + " ".repeat((1 - request().length % 3 + 3) % 3)
+        val canonical = encode(padded)
+        assertTrue(canonical.endsWith("=="))
+        val lastDataIndex = canonical.length - 3
+        val alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
+        val alternatePadBits = canonical.replaceRange(
+            lastDataIndex, lastDataIndex + 1, alphabet[alphabet.indexOf(canonical[lastDataIndex]) + 1].toString()
+        )
+        val withWhitespace = " " + encode(request())
+        for (encoded in listOf(null, "", "abc!", "_w==", "Zg===", "Zg=", "Zg", "$canonical\n",
+            canonical.dropLast(2), alternatePadBits, withWhitespace)) {
+            val error = assertThrows(RpcDecodeException::class.java) { RpcCodec.decodeRequest(encoded) }
+            assertEquals("INVALID_REQUEST", error.code)
+            assertEquals(RpcCodec.UNAVAILABLE_REQUEST_ID, error.requestId)
+        }
+    }
+
+    @Test fun checksByteAndEncodedBounds() {
+        val exact = request().padEnd(RpcCodec.MAX_BYTES)
+        val exactEncoded = encode(exact)
+        assertEquals(RpcCodec.MAX_ENCODED_CHARS, exactEncoded.length)
+        assertEquals(id, RpcCodec.decodeRequest(exactEncoded).requestId)
+
+        val extraByte = Base64.encode(ByteArray(RpcCodec.MAX_BYTES + 1))
+        for (encoded in listOf(extraByte, "!".repeat(RpcCodec.MAX_ENCODED_CHARS + 1))) {
+            val error = assertThrows(RpcDecodeException::class.java) { RpcCodec.decodeRequest(encoded) }
+            assertEquals("TOO_LARGE", error.code)
+        }
+    }
+
+    @Test fun rejectsNonUtf8AndUtf8SurrogateEncoding() {
+        val prefix = """{"bad":"""".toByteArray()
+        val suffix = """"}""".toByteArray()
+        for (bytes in listOf(
+            byteArrayOf(0xc0.toByte(), 0xaf.toByte()),
+            byteArrayOf(0xe2.toByte(), 0x82.toByte()),
+            byteArrayOf(0xed.toByte(), 0xa0.toByte(), 0x80.toByte())
+        )) {
+            val error = assertThrows(RpcDecodeException::class.java) {
+                RpcCodec.decodeRequest(Base64.encode(prefix + bytes + suffix))
+            }
+            assertEquals("Expected UTF-8", error.message)
+        }
+    }
+
+    @Test fun rejectsMalformedTrailingDuplicateAndDeepJson() {
+        val duplicates = listOf(
+            request().replaceFirst("}", """},"request_id":"$id""""),
+            request().replaceFirst("}", """},"\u0072equest_id":"$id""""),
+            request(args = """{"x":{"site":"video","site":"video"}}"""),
+            request("policy.replace", """{"policy":${policy.replace("\"schema\":1", "\"schema\":1,\"schema\":1")}}""", "0")
+        )
+        for (raw in duplicates) assertEquals("Repeated JSON field", rejects(raw).message)
+        val deep = "[".repeat(30) + "0" + "]".repeat(30)
+        assertEquals("JSON nesting is too deep", rejects(request(args = """{"x":$deep}""")).message)
+        for (raw in listOf("", "\uFEFF${request()}", "{", "null", "[]", "${request()} {}", request().replace("\"status\"", "'status'"),
+            request().replace("\"status\"", "\"sta\ntus\""), request().replace("\"status\"", "\"sta\u0000tus\""),
+            request().replace("\"args\":{}", "\"args\":{/*comment*/}"), request().dropLast(1) + ",}")) {
+            rejects(raw)
+        }
+    }
+
+    @Test fun rejectsLoneSurrogatesInNamesAndValuesAndAcceptsPairsAtTheUnicodeLayer() {
+        val loneHigh = rejects(request("session.close", """{"site":"\uD800"}""", "0"))
+        val loneLow = rejects(request(args = """{"\uDC00":null}"""))
+        assertEquals("Expected Unicode scalar strings", loneHigh.message)
+        assertEquals("Expected Unicode scalar strings", loneLow.message)
+        for (pair in listOf("\\uD83D\\uDE00", "😀")) {
+            val result = rejects(request("session.close", """{"site":"$pair"}""", "0"))
+            assertEquals("Invalid site ID", result.message)
+        }
+    }
+
+    @Test fun verifiesEnvelopeAndRetainsOnlyCanonicalIdsForErrors() {
+        for (raw in listOf(
+            request().replace("\"schema\":1,", ""),
+            request().replace("\"request_id\":\"$id\",", ""),
+            request().replace("\"op\":\"status\",", ""),
+            request().replace(",\"args\":{}", ""),
+            request().dropLast(1) + ""","extra":null}""",
+            request().replace("\"op\":\"status\"", "\"op\":true"),
+            request(args = "null"),
+            request(args = "[]")
+        )) rejects(raw)
+        val error = rejects(request("status", """{"extra":null}"""))
+        assertEquals(id, error.requestId)
+        for (badId in listOf("", id.uppercase(), "1-1-1-1-1", "{$id}", "$id ")) {
+            assertEquals(RpcCodec.UNAVAILABLE_REQUEST_ID, rejects(request(requestId = badId)).requestId)
+        }
+        assertEquals(RpcCodec.UNAVAILABLE_REQUEST_ID, rejects(request().replace("\"$id\"", "1")).requestId)
+        for (op in listOf("Status", "legacy.get", "set-alg", "doctor", "status\u0000", "")) {
+            rejects(request(op))
+        }
+    }
+
+    @Test fun requiresStrictIntegerSchemaAndRevisions() {
+        for (schema in listOf("0", "2", Long.MAX_VALUE.toString())) {
+            assertEquals(id, rejects(request(schema = schema), "UNSUPPORTED_SCHEMA").requestId)
+        }
+        for (schema in listOf("-1", "true", "\"1\"", "1.0", "1e0", "9223372036854775808")) {
+            rejects(request(schema = schema))
+        }
+        val closeArgs = """{"site":"video"}"""
+        for (rev in listOf(null, "-1", "true", "null", "\"1\"", "1.0", "1e0", "1E+0", "9223372036854775808")) {
+            rejects(request("session.close", closeArgs, rev))
+        }
+        rejects(request(revision = "0"))
+        rejects(request("policy.get", revision = "null"))
+    }
+
+    @Test fun validatesArgumentsBeforeControllerDispatch() {
+        for (op in listOf("status", "policy.get")) rejects(request(op, """{"extra":null}"""))
+        for (args in listOf("{}", """{"site":"Video"}""", """{"site":1}""", """{"site":"video","minutes":1}""")) {
+            rejects(request("session.close", args, "0"))
+        }
+        for (minutes in listOf("0", "1441", "-1", "true", "\"1\"", "1.0", "1e0", "9223372036854775808")) {
+            rejects(request("session.open", """{"site":"video","minutes":$minutes}""", "0"))
+        }
+        rejects(request("session.open", """{"site":"video"}""", "0"))
+        rejects(request("session.open", """{"site":"video","minutes":1,"extra":null}""", "0"))
+        rejects(request("session.open", """{"site":"bad-id","minutes":null}""", "0"))
+        rejects(request("policy.replace", "{}", "0"))
+        rejects(request("policy.replace", """{"policy":null}""", "0"))
+        rejects(request("policy.replace", """{"policy":$policy,"extra":null}""", "0"))
+        rejects(request("policy.replace", """{"policy":${policy.replace("45", "45e0")}}""", "0"))
+        rejects(request("policy.replace", """{"policy":${policy.replace("45", "45.0")}}""", "0"))
+        rejects(request("policy.replace", """{"policy":${policy.replace("safe.video.example.org", "other.example.org")}}""", "0"))
+    }
+
+    @Test fun checksCanonicalPolicyByteLimitInsideTheRequest() {
+        val domains = (0..599).joinToString(",") {
+            "\"domain$it.${"a".repeat(48)}.${"b".repeat(48)}.example.org\""
+        }
+        val bigPolicy = """
+            {"schema":1,"reset_hour":4,"default_session_min":15,"sites":{
+                "video":{"mode":"blocked","budget_min":0,"domains":[$domains],"exceptions":[]}
+            }}
+        """.trimIndent()
+        val raw = request("policy.replace", """{"policy":$bigPolicy}""", "0")
+        assertTrue(raw.toByteArray().size in (PolicyCodec.MAX_BYTES + 1)..RpcCodec.MAX_BYTES)
+        assertEquals(id, rejects(raw, "TOO_LARGE").requestId)
+    }
+
+    @Test fun validatesAndEncodesRepliesWithRealUtf8AndUnprovedAppliedRevision() {
+        val data = JsonObject().apply { addProperty("diagnostic", "😀") }
+        val reply = JsonObject().apply {
+            addProperty("schema", 1)
+            addProperty("request_id", id)
+            addProperty("ok", true)
+            addProperty("revision", 8)
+            add("applied_revision", JsonNull.INSTANCE)
+            add("data", data)
+        }
+        val encoded = RpcCodec.encodeReply(id, reply)
+        val parsed = strictJson(Base64.decode(encoded).decodeToString()).obj()
+        assertEquals("😀", parsed["data"].asJsonObject["diagnostic"].asString)
+        assertEquals(encoded, Base64.encode(Base64.decode(encoded)))
+        assertEquals(JsonNull.INSTANCE, parsed["applied_revision"])
+
+        data.addProperty("diagnostic", "\uD800")
+        assertThrows(PolicyException::class.java) { RpcCodec.encodeReply(id, reply) }
+        data.addProperty("diagnostic", "😀".repeat(RpcCodec.MAX_BYTES / 4))
+        val oversized = assertThrows(PolicyException::class.java) { RpcCodec.encodeReply(id, reply) }
+        assertEquals("TOO_LARGE", oversized.code)
+
+        val fallback = strictJson(Base64.decode(RpcCodec.encodeFailure(id, "TOO_LARGE", "Reply is too large"))
+            .decodeToString()).obj()
+        assertEquals(setOf("schema", "request_id", "ok", "revision", "applied_revision", "error"), fallback.keySet())
+        assertEquals(id, fallback["request_id"].asString)
+        assertEquals(0L, fallback["revision"].asLong)
+        assertEquals(JsonNull.INSTANCE, fallback["applied_revision"])
+        assertFalse(fallback["ok"].asBoolean)
+    }
+
+    @Test fun acceptsSavedOnlyOnAnApplyFailureAndRejectsReplyEnvelopeCoercion() {
+        val failure = strictJson(Base64.decode(RpcCodec.encodeFailure(id, "APPLY_FAILED", "Failed", 9))
+            .decodeToString()).obj()
+        failure.addProperty("saved", true)
+        val encoded = RpcCodec.encodeReply(id, failure)
+        assertEquals(failure, strictJson(Base64.decode(encoded).decodeToString()))
+        val mutations: List<(JsonObject) -> Unit> = listOf(
+            { it.addProperty("saved", false) },
+            { it.addProperty("saved", "true") },
+            { it["error"].asJsonObject.addProperty("code", "CONFLICT") },
+            { it["error"].asJsonObject.addProperty("code", "lowercase") },
+            { it["error"].asJsonObject.addProperty("extra", true) },
+            { it.addProperty("ok", "false") },
+            { it.addProperty("schema", "1") },
+            { it.addProperty("revision", 9.0) },
+            { it.remove("applied_revision") },
+            { it.add("data", JsonObject()) }
+        )
+        for (mutate in mutations) {
+            val invalid = failure.deepCopy()
+            mutate(invalid)
+            assertThrows(PolicyException::class.java) { RpcCodec.encodeReply(id, invalid) }
+        }
+    }
+}

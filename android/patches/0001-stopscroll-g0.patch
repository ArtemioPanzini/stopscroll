+            assertTrue(install.get(3, SECONDS))
+        } finally { resume.countDown() }
+    }
+
+    @Test fun nativeCleanupMayOutliveDisconnectButCannotOverlapSuccessorInSameProcess() {
+        val lifetime = NativeProcessLifetime { throw AssertionError("process death") }
+        val owner = Any()
+        lifetime.register(owner)
+        val cleanup = CountDownLatch(1)
+        val delayed = FutureTask { cleanup.await(3, SECONDS); "old global mapper cleared" }
+        lifetime.construct(owner) { thread { delayed.run() } }
+        // Firestack can already report disconnected while this old cleanup is outstanding.
+        assertNull(delayed.takeIf { it.isDone })
+        var constructions = 1
+        try {
+            assertThrows(AssertionError::class.java) { lifetime.retire(owner) }
+            assertThrows(AssertionError::class.java) { lifetime.register(Any()) }
+            assertThrows(AssertionError::class.java) { lifetime.register(owner); lifetime.construct(owner) { constructions++ } }
+            assertEquals(1, constructions)
+        } finally { cleanup.countDown() }
+        assertEquals("old global mapper cleared", delayed.get(3, SECONDS))
+        val newProcess = NativeProcessLifetime { error("unexpected retirement") }
+        newProcess.register(owner)
+        newProcess.construct(owner) { constructions++ }
+        assertEquals(2, constructions)
+    }
+
+    @Test fun partialNativeConstructionAlsoConsumesTheProcessSlot() {
+        val owner = Any()
+        val process = NativeProcessLifetime { throw AssertionError("process death") }
+        process.register(owner)
+        assertThrows(AssertionError::class.java) { process.construct(owner) { error("failed after FD allocation") } }
+        assertThrows(AssertionError::class.java) { process.construct(owner) { fail("second context") } }
+    }
+}

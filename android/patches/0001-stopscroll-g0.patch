+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.app.Application
+import android.content.Intent
+import android.os.Looper
+import android.os.SystemClock
+import android.provider.Settings
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.TextView
+import java.io.File
+import java.time.Duration
+import java.time.ZoneId
+import java.util.concurrent.ConcurrentLinkedQueue
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowAlertDialog
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE, application = Application::class)
+class StopscrollActivityTest {
+    @get:Rule val folder = TemporaryFolder()
+    private fun descendants(view: View): Sequence<View> = sequence {
+        yield(view)
+        if (view is ViewGroup) for (i in 0 until view.childCount) yieldAll(descendants(view.getChildAt(i)))
+    }
+    private fun waitFor(predicate: () -> Boolean) {
+        val deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5)
+        while (true) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (predicate()) return
+            assertTrue("UI did not publish state", System.nanoTime() < deadline)
+            Thread.sleep(5)
+        }
+    }
+
+    @Test fun visibleScreenTracksUsbEditsAndTapsUseTheDisplayedRevisionOffMain() {
+        val zone = ZoneId.of("Europe/Belgrade")
+        val clock = { ClockSample(1783850400000L + SystemClock.elapsedRealtime(), SystemClock.elapsedRealtime(), 12) }
+        val timers = TestTimers()
+        val target = TestTunnel()
+        val engine = EngineAdapter(clock, timers)
+        engine.register(target.owner)
+        engine.attach(target)
+        engine.installPreferred(target) {}
+        val core = DailyController(StopscrollController(StateStore(File(folder.root, "s/state.json")),
+            { JournalState.initial(zone, clock(), examplePolicy()) }, clock, engine, timers, { target.platform() }))
+        val requests = ConcurrentLinkedQueue<RpcRequest>()
+        val launch = Intent().putExtra("op", "session.open").putExtra("site", "video")
+        val activity = Robolectric.buildActivity(StopscrollActivity::class.java, launch)
+        val screen = activity.get()
+        screen.execute = { request ->
+            check(Looper.myLooper() != Looper.getMainLooper())
+            requests.add(request)
+            core.execute(request)
+        }
+        activity.create().start().resume()
+        val contents = screen.findViewById<View>(android.R.id.content)
+        fun button(label: String) = descendants(contents).filterIsInstance<Button>()
+            .firstOrNull { it.visibility == View.VISIBLE && it.text.toString() == label }
+        fun contains(text: String) = descendants(contents).filterIsInstance<TextView>().any { text in it.text.toString() }
+        try {
+            waitFor { button("Открыть отрезок")?.isEnabled == true }
+            assertTrue(contains("Защита активна"))
+            assertTrue(contains("04:00 · Europe/Belgrade"))
+            assertTrue(requests.all { it.op == "status" })
+
+            // A USB edit while the chooser is open cannot silently change its expected revision.
+            button("Открыть отрезок")!!.performClick()
+            shadowOf(Looper.getMainLooper()).idle()
+            val chooser = ShadowAlertDialog.getLatestAlertDialog()
+            assertTrue(core.execute(DailyCommands.session("video", 0, true, 5)).ok)
+            chooser.getButton(android.app.AlertDialog.BUTTON_POSITIVE).performClick()
+            waitFor { contains("CONFLICT") && button("Закрыть отрезок")?.isEnabled == true }
+            assertEquals(0L, requests.first { it.op == "session.open" }.expectedRevision)
+            button("Закрыть отрезок")!!.performClick()
+            waitFor { button("Открыть отрезок")?.isEnabled == true && contains("применена 2") }
+            assertEquals(1L, requests.first { it.op == "session.close" }.expectedRevision)
+
+            button("Открыть отрезок")!!.performClick()
+            shadowOf(Looper.getMainLooper()).idle()
+            val selected = ShadowAlertDialog.getLatestAlertDialog()
+            descendants(selected.window!!.decorView).filterIsInstance<EditText>().single().setText("3")
+            selected.getButton(android.app.AlertDialog.BUTTON_POSITIVE).performClick()
+            waitFor { button("Закрыть отрезок")?.isEnabled == true && contains("применена 3") }
+            val submitted = requests.filter { it.op == "session.open" }
+            assertEquals(3, submitted.last().args["minutes"].asInt)
+            assertNotEquals(submitted.first().requestId, submitted.last().requestId)
+
+            // The visible activity learns the remote close without a new tap or resuming.
+            assertTrue(core.execute(DailyCommands.session("video", 3, false)).ok)
+            shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(6))
+            waitFor { contains("применена 4") && button("Открыть отрезок") != null }
+        } finally { activity.pause().stop().destroy() }
+    }
+
+    @Test fun setupLinksUseSystemVpnSettingsAndOnlyThisPackagesBatteryExemption() {
+        val activity = Robolectric.buildActivity(StopscrollActivity::class.java).create()
+        val screen = activity.get()
+        val buttons = descendants(screen.findViewById(android.R.id.content)).filterIsInstance<Button>().toList()
+        buttons.single { it.text == "Постоянный VPN и блокировка без VPN" }.performClick()
+        assertEquals(Settings.ACTION_VPN_SETTINGS, shadowOf(screen).nextStartedActivity.action)
+        buttons.single { it.text == "Исключить Stopscroll из оптимизации батареи" }.performClick()
+        val battery = shadowOf(screen).nextStartedActivity
+        assertEquals(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, battery.action)
+        assertEquals("package:${screen.packageName}", battery.dataString)
+        activity.destroy()
+    }
+}

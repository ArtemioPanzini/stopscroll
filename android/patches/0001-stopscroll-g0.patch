+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonObject
+import java.time.ZoneId
+import java.util.UUID
+
+internal object DailyCommands {
+    fun status() = RpcRequest(UUID.randomUUID().toString(), "status", JsonObject())
+
+    fun session(site: String, revision: Long, open: Boolean, minutes: Int? = null) =
+        RpcRequest(UUID.randomUUID().toString(), if (open) "session.open" else "session.close", JsonObject().apply {
+            addProperty("site", site)
+            if (open) addProperty("minutes", minutes)
+        }, revision)
+}
+
+internal data class DailySite(val limited: Boolean, val budgetMin: Int, val remaining: Int,
+                              val reserved: Int, val end: Long?)
+internal data class DailyStatus(
+    val revision: Long, val applied: Long?, val state: String, val reason: String?, val tunnel: Boolean,
+    val alwaysOn: Boolean, val lockdown: Boolean, val exempt: Boolean, val preferred: String,
+    val zone: ZoneId, val day: String, val reset: Int, val defaultMin: Int,
+    val wallMs: Long, val elapsedMs: Long, val sites: Map<String, DailySite>
+) {
+    fun endWall(deadline: Long) = wallMs + (deadline - elapsedMs)
+
+    companion object {
+        fun from(reply: RpcReply): DailyStatus {
+            val r = reply.json
+            val d = r.getAsJsonObject("data")
+            val p = d.getAsJsonObject("protection")
+            val clock = d.getAsJsonObject("clock")
+            val sites = d.getAsJsonObject("sites").entrySet().associate { (id, raw) ->
+                val s = raw.asJsonObject
+                val deadline = s["session"].takeUnless { it.isJsonNull }?.asJsonObject?.get("deadline_elapsed_ms")?.asLong
+                id to DailySite(s["mode"].asString == "limited", s["budget_min"].asInt, s["remaining_sec"].asInt,
+                    s["reserved_sec"].asInt, deadline)
+            }
+            return DailyStatus(r["revision"].asLong, r["applied_revision"].takeUnless { it.isJsonNull }?.asLong,
+                p["state"].asString, p["reason"].takeUnless { it.isJsonNull }?.asString, p["tunnel"].asBoolean,
+                p["always_on"].asBoolean, p["lockdown"].asBoolean, p["ignoring_battery_optimizations"].asBoolean,
+                p["preferred_state"].asString, ZoneId.of(d["timezone"].asString), d["day_id"].asString,
+                d["reset_hour"].asInt, d["default_session_min"].asInt, clock["wall_ms"].asLong,
+                clock["elapsed_ms"].asLong, sites)
+        }
+    }
+}
diff --git a/app/src/stopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodec.kt b/app/src/stopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodec.kt
new file mode 100644
index 0000000..ad09613
--- /dev/null
+++ b/app/src/stopscrollRelease/java/com/celzero/bravedns/stopscroll/RpcCodec.kt
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonElement
+import com.google.gson.JsonNull
+import com.google.gson.JsonObject
+import java.nio.ByteBuffer
+import java.nio.charset.CharacterCodingException
+import kotlin.io.encoding.Base64
+
+internal class RpcDecodeException(val code: String, val requestId: String, message: String) :
+    IllegalArgumentException(message)
+
+internal object RpcCodec {
+    const val MAX_BYTES = 96 * 1024
+    const val MAX_ENCODED_CHARS = (MAX_BYTES + 2) / 3 * 4
+    const val UNAVAILABLE_REQUEST_ID = "00000000-0000-0000-0000-000000000000"
+
+    private val uuid = Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+    private val errorCode = Regex("[A-Z][A-Z0-9_]{0,63}")
+
+    fun decodeRequest(arg: String?): RpcRequest {
+        var id = UNAVAILABLE_REQUEST_ID
+        try {
+            val root = strictJson(decodeText(arg)).obj()
+            val candidate = root["request_id"]
+            val hasCanonicalId = candidate != null && candidate.isJsonPrimitive &&
+                candidate.asJsonPrimitive.isString && uuid.matches(candidate.asString)
+            if (hasCanonicalId) id = candidate.asString
+            root.requireUnicodeScalars()
+            if (!hasCanonicalId) invalid("Expected canonical request UUID")
+            val schema = root["schema"]?.number(0, Long.MAX_VALUE) ?: invalid("Missing RPC schema")
+            if (schema != 1L) throw PolicyException("UNSUPPORTED_SCHEMA", "RPC schema must be 1")
+
+            val op = root["op"]?.string() ?: invalid("Missing operation")
+            val mutation = when (op) {
+                "status", "policy.get" -> false
+                "policy.replace", "session.open", "session.close" -> true
+                else -> invalid("Unknown operation")
+            }
+            val revision = if (mutation) {
+                root.fields("schema", "request_id", "op", "args", "expected_revision")
+                root["expected_revision"].number(0, Long.MAX_VALUE)
+            } else {
+                root.fields("schema", "request_id", "op", "args")
+                null
+            }
+
+            val args = root["args"].obj()
+            when (op) {
+                "status", "policy.get" -> args.fields()
+                "policy.replace" -> {
+                    args.fields("policy")
+                    PolicyCodec.fromJson(args["policy"])
+                }
+                "session.open", "session.close" -> {
+                    if (op == "session.open") {
+                        args.fields("site", "minutes")
+                        args["minutes"].takeUnless { it.isJsonNull }?.number(1, 1440)
+                    } else {
+                        args.fields("site")
+                    }
+                    if (!siteId.matches(args["site"].string())) invalid("Invalid site ID")
+                }
+            }
+            return RpcRequest(id, op, args, revision)
+        } catch (e: PolicyException) {
+            throw RpcDecodeException(e.code, id, e.message ?: e.code)
+        }
+    }
+
+    private fun decodeText(arg: String?): String {
+        if (arg.isNullOrEmpty()) invalid("Missing Base64 request")
+        if (arg.length > MAX_ENCODED_CHARS) oversized("Encoded request exceeds the RPC limit")
+        val bytes = try {
+            Base64.decode(arg)
+        } catch (_: IllegalArgumentException) {
+            invalid("Expected canonical Base64")
+        }
+        if (bytes.size > MAX_BYTES) oversized("Request exceeds 96 KiB")
+        if (Base64.encode(bytes) != arg) invalid("Expected canonical Base64")
+        val text = try {
+            Charsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(bytes)).toString()
+        } catch (_: CharacterCodingException) {
+            invalid("Expected UTF-8")
+        }
+        if (text.startsWith('\uFEFF')) invalid("Unexpected JSON byte order mark")
+        return text
+    }
+
+    fun encodeReply(requestId: String, reply: JsonObject): String {
+        val ok = reply["ok"]?.strictBoolean() ?: invalid("Missing reply outcome")
+        val envelope = arrayOf("schema", "request_id", "ok", "revision", "applied_revision")
+        if (ok) {
+            reply.fields(*envelope, "data")
+            reply["data"].obj()
+        } else {
+            val saved = reply.has("saved")
+            if (saved) reply.fields(*envelope, "error", "saved") else reply.fields(*envelope, "error")
+            val error = reply["error"].obj()
+            error.fields("code", "message")
+            val code = error["code"].string()
+            if (!errorCode.matches(code)) invalid("Invalid reply error code")
+            error["message"].string()
+            if (saved && (code != "APPLY_FAILED" || !reply["saved"].strictBoolean())) {
+                invalid("Invalid reply saved flag")
+            }
+        }
+        reply["schema"].number(1, 1)
+        if (reply["request_id"].string() != requestId || !uuid.matches(requestId)) invalid("Invalid reply request ID")
+        reply["revision"].number(0, Long.MAX_VALUE)
+        reply["applied_revision"].takeUnless { it.isJsonNull }?.number(0, Long.MAX_VALUE)
+        reply.requireUnicodeScalars()
+        val bytes = reply.toString().toByteArray()
+        if (bytes.size > MAX_BYTES) oversized("Reply exceeds 96 KiB")
+        return Base64.encode(bytes)
+    }
+
+    // Revision zero is an unavailable-state placeholder. Decoding failures never query the controller.
+    fun encodeFailure(requestId: String, code: String, message: String, revision: Long = 0): String =
+        encodeReply(requestId, JsonObject().apply {
+            addProperty("schema", 1)
+            addProperty("request_id", requestId)
+            addProperty("ok", false)
+            addProperty("revision", revision)
+            add("applied_revision", JsonNull.INSTANCE)
+            add("error", JsonObject().apply {
+                addProperty("code", code)
+                addProperty("message", message)
+            })
+        })
+
+    private fun JsonElement.strictBoolean(): Boolean =
+        if (isJsonPrimitive && asJsonPrimitive.isBoolean) asBoolean else invalid("Expected boolean")
+
+    private fun JsonElement.requireUnicodeScalars() {
+        when {
+            isJsonObject -> asJsonObject.entrySet().forEach { (name, value) ->
+                name.requireUnicodeScalars()
+                value.requireUnicodeScalars()
+            }
+            isJsonArray -> asJsonArray.forEach { it.requireUnicodeScalars() }
+            isJsonPrimitive && asJsonPrimitive.isString -> asString.requireUnicodeScalars()
+        }
+    }
+
+    private fun String.requireUnicodeScalars() {
+        var i = 0
+        while (i < length) {
+            val unit = this[i++]
+            when {
+                unit.isHighSurrogate() -> {
+                    if (i == length || !this[i++].isLowSurrogate()) invalid("Expected Unicode scalar strings")
+                }
+                unit.isLowSurrogate() -> invalid("Expected Unicode scalar strings")
+            }
+        }
+    }
+}

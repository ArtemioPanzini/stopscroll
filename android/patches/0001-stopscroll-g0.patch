+        val resume = CountDownLatch(1)
+        val first = java.util.concurrent.atomic.AtomicBoolean(true)
+        target.probe = {
+            if (first.getAndSet(false)) { entered.countDown(); check(resume.await(6, SECONDS)) }
+            PlatformProtection(true, true, true, true)
+        }
+        val pool = Executors.newFixedThreadPool(2)
+        try {
+            val status = pool.submit<RpcReply> { c.execute(request("status")) }
+            assertTrue(entered.await(3, SECONDS))
+            val close = pool.submit<RpcReply> { c.execute(request("session.close", 1)) }
+            assertTrue(close.get(2, SECONDS).ok)
+            assertEquals(1L, resume.count)
+            assertNull(store.read().accounts["video"]!!.session)
+            resume.countDown()
+            val stale = status.get(3, SECONDS)
+            assertTrue(stale.json["applied_revision"].isJsonNull)
+            assertEquals(2L, stale.json["revision"].asLong)
+            assertTrue(stale.json["data"].obj()["sites"].obj()["video"].obj()["session"].isJsonNull)
+        } finally { resume.countDown(); pool.shutdownNow() }
+    }
+
+    private fun outcomeCrash(identityLoss: Boolean, beforeAuthorization: Boolean, loseProcess: Boolean = true) {
+        attach()
+        store.loadOrCreate { initial }
+        var writes = 0
+        var finishing = false
+        var crashed = false
+        fun revoke() {
+            if (identityLoss) engine.detach(target) else {
+                clock = clock.copy(elapsedMs = clock.elapsedMs + 300000)
+                timers.cutoff!!()
+            }
+        }
+        val source = StateStore(file, beforeFinish = {
+            if (++writes == 2) {
+                finishing = true
+                if (beforeAuthorization) revoke()
+            }
+        }, beforeDirectorySync = { dir ->
+            if (finishing && !crashed && dir == file.parentFile) {
+                // The directory-sync hook runs after the selected file was renamed and verified.
+                // If authorization vetoed success, this can also be a read of the pending journal.
+                crashed = true
+                if (!beforeAuthorization) revoke()
+                if (loseProcess) throw AssertionError("process lost after publication, before returning")
+            }
+        })
+        val open = request("session.open", 0)
+        if (loseProcess) assertThrows(AssertionError::class.java) { controller(source).execute(open) }
+        else assertTrue(controller(source).execute(open).ok)
+        val restart = EngineAdapter({ clock }, timers)
+        val rebuilt = TestTunnel()
+        restart.register(rebuilt.owner)
+        restart.attach(rebuilt)
+        restart.installPreferred(rebuilt) {}
+        val recovered = StopscrollController(store, { error("must recover") }, { clock }, restart, timers, rebuilt::platform)
+        val replay = recovered.execute(open)
+        assertEquals(!beforeAuthorization, replay.ok)
+        if (beforeAuthorization) {
+            assertEquals("APPLY_FAILED", replay.code())
+            assertNull(store.read().accounts["video"]!!.session)
+        }
+        assertEquals(replay.json, recovered.execute(open).json)
+        assertEquals(1, store.read().receipts.count { it.requestId == open.requestId })
+    }
+
+    @Test fun expiryBeforeAuthorizationNeverPublishesSuccessAcrossCrash() = outcomeCrash(false, true)
+    @Test fun replacementBeforeAuthorizationNeverPublishesSuccessAcrossCrash() = outcomeCrash(true, true)
+    @Test fun expiryAfterSuccessRenameReplaysHistoricalGrant() = outcomeCrash(false, false)
+    @Test fun replacementAfterSuccessRenameReplaysHistoricalGrant() = outcomeCrash(true, false)
+
+    @Test fun expiryAfterAuthorizedRenameDoesNotReverseTheReturnedResult() = outcomeCrash(false, false, false)
+    @Test fun replacementAfterAuthorizedRenameDoesNotReverseTheReturnedResult() = outcomeCrash(true, false, false)
+
+    @Test fun firstPacketsAfterSleepReconcileTheDayBeforeTheAwakeTimerFires() {
+        val zone = ZoneId.of("Europe/Belgrade")
+        val oneAm = java.time.ZonedDateTime.of(2026, 11, 18, 1, 0, 0, 0, zone)
+        clock = clock.copy(wallMs = oneAm.toInstant().toEpochMilli())
+        var awakeMs = 1000L
+        var dueAwake = Long.MAX_VALUE
+        var wakeLocks = 0
+        var timer: (() -> Unit)? = null
+        val sleeping = object : SessionTimers by timers {
+            override fun tick(elapsedMs: Long, action: () -> Unit): () -> Unit {
+                dueAwake = awakeMs + elapsedMs - clock.elapsedMs
+                timer = action
+                return {}
+            }
+            override fun deadline(elapsedMs: Long, action: () -> Unit): () -> Unit {
+                wakeLocks++
+                return {}
+            }
+        }
+        val gate = EngineAdapter({ clock }, sleeping)
+        val c = StopscrollController(store, { initial }, { clock }, gate, sleeping, target::platform)
+        var queued = 0
+        gate.onDue = { queued++ }
+        gate.register(target.owner)
+        gate.attach(target)
+        gate.installPreferred(target) {}
+        c.reconcile()
+        val yesterday = store.read().dayId
+        assertEquals(awakeMs + 3 * 3600000, dueAwake)
+        val sleep = 6 * 3600000L
+        awakeMs += 100
+        clock = clock.copy(wallMs = clock.wallMs + sleep + 100, elapsedMs = clock.elapsedMs + sleep + 100)
+        if (awakeMs >= dueAwake) timer!!()
+        assertEquals(yesterday, store.read().dayId)
+        repeat(20) {
+            assertEquals("allow", gate.admitted(target, listOf("ordinary.example")) { "allow" })
+            assertNull(gate.admitted(target, listOf("video.example.org")) { "allow" })
+        }
+        assertEquals(1, queued)
+        c.reconcile()
+        assertEquals(yesterday.plusDays(1), store.read().dayId)
+        assertEquals(0, wakeLocks)
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/EngineAdapterTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/EngineAdapterTest.kt

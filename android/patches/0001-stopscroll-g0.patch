@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.util.Locale
+
+/** The disposable G0 domain list, shared by DNS and connection callbacks. */
+internal class G0Domains private constructor(
+    val domains: Set<String>,
+    val exceptions: Set<String>
+) {
+    fun blocks(host: String): Boolean {
+        val name = canonical(host)
+        return matches(domains, name) && !matches(exceptions, name)
+    }
+
+    private fun matches(entries: Set<String>, name: String): Boolean {
+        var candidate = name
+        while (candidate.isNotEmpty()) {
+            if (candidate in entries) return true
+            candidate = candidate.substringAfter('.', "")
+        }
+        return false
+    }
+
+    companion object {
+        private val label = Regex("[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
+
+        val EMPTY = create(emptyList(), emptyList())
+
+        fun create(domains: List<String>, exceptions: List<String>): G0Domains {
+            val entries = domains + exceptions
+            require(entries.size <= 1_000) { "Too many domain entries" }
+            require(entries.sumOf { it.length + 1 } <= 64 * 1024) { "Domain policy too large" }
+            return G0Domains(domains.map(::validate).toSet(), exceptions.map(::validate).toSet())
+        }
+
+        private fun canonical(host: String) = host.removeSuffix(".").lowercase(Locale.ROOT)
+
+        private fun validate(host: String): String {
+            val name = canonical(host)
+            require(name.length in 1..253 && name.split('.').all(label::matches)) { "Invalid domain" }
+            return name
+        }
+    }
+}

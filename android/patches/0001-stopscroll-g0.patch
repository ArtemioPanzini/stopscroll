new file mode 100644
index 0000000..7ff4e50
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/G0Cutoff.kt
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.util.concurrent.CountDownLatch
+
+/** Each Target is the bridge of one native adapter, including during native callbacks. */
+internal class G0Cutoff<T : G0Cutoff.Target>(private val now: () -> Long) {
+    interface Target {
+        val owner: Any
+        fun sweep()
+        fun protectedNow(): Boolean
+    }
+
+    enum class Preferred { PENDING, INSTALLING, READY, FAILED }
+
+    data class State<T>(
+        val target: T? = null,
+        val generation: Long = 0,
+        val preferred: Preferred = Preferred.PENDING,
+        val appliedRevision: Long? = null,
+        val changing: Boolean = false,
+        val algUncertain: Boolean = false,
+        val due: Long? = null,
+        val trigger: Long? = null,
+        val cutoff: Long? = null,
+        val closeMs: Long? = null,
+        val error: String? = null
+    )
+
+    class Claim<T>(val target: T?, val generation: Long) {
+        internal val settled = CountDownLatch(1)
+    }
+
+    private val writes = Any()
+    private val alg = Any()
+    private var active: Claim<T>? = null
+    private var service: Any? = null
+    @Volatile var state = State<T>()
+        private set
+
+    @Synchronized fun register(owner: Any) {
+        service = owner
+        changeTarget(null)
+    }
+
+    @Synchronized fun unregister(owner: Any) {
+        if (service !== owner) return
+        service = null
+        changeTarget(null)
+    }
+
+    @Synchronized fun attach(target: T) {
+        if (service === target.owner) changeTarget(target)
+    }
+
+    @Synchronized fun detach(target: T) {
+        if (state.target === target) changeTarget(null)
+    }
+
+    private fun changeTarget(target: T?) {
+        state = state.copy(target = target, preferred = Preferred.PENDING, appliedRevision = null, algUncertain = false)
+    }
+
+    fun receipt(target: T): State<T>? = state.takeIf { it.target === target && it.appliedRevision != null }
+
+    fun permits(target: T, receipt: State<T>?): Boolean =
+        receipt != null && receipt.target === target && state === receipt
+
+    // Platform and native probes can block. Revalidate their subject after returning.
+    fun protectedTarget(target: T? = state.target): T? =
+        target?.takeIf { it.protectedNow() && state.target === it }
+
+    fun protectedReceipt(target: T, sample: State<T>): Boolean =
+        receipt(target) === sample && target.protectedNow() && permits(target, sample)
+
+    // This lock serializes ALG changes, activation on a replacement, and ALG status reads.
+    // Neither deadline claims nor native sweeps ever acquire it.
+    fun <R> withAlgLock(action: () -> R): R = synchronized(alg, action)
+
+    fun updateAlg(target: T, before: State<T>, enabled: Boolean, read: () -> Boolean,
+                  apply: (Boolean) -> Unit, store: (Boolean) -> Unit): Boolean = synchronized(alg) {
+        if (!protectedReceipt(target, before)) return false
+        val previous = read()
+        var storing = false
+        try {
+            apply(enabled)
+            if (protectedReceipt(target, before)) {
+                // The final guard authorizes commit. A replacement reads the committed value
+                // under this same ALG lock before it can obtain an activation receipt.
+                storing = true
+                store(enabled)
+                return true
+            }
+        } catch (_: Exception) {
+            // An exception after the native write also requires reconciliation.
+        }
+        try {
+            apply(previous)
+            if (storing) store(previous)
+        } catch (_: Exception) {
+            synchronized(this) {
+                if (state.target === target) state = state.copy(algUncertain = true,
+                    appliedRevision = null, error = "Native ALG mode is unconfirmed")
+            }
+        }
+        false
+    }
+
+    @Synchronized fun begin(target: T?, due: Long? = null): Claim<T> {
+        val trigger = now()
+        state = state.copy(generation = state.generation + 1, appliedRevision = null,
+            changing = true, due = due ?: trigger, trigger = trigger, cutoff = null, closeMs = null, error = null)
+        active?.settled?.countDown()
+        return Claim(target, state.generation).also { active = it }
+    }
+
+    // Sweep before disk and platform calls so an existing stream is revoked immediately.
+    fun complete(claim: Claim<T>, save: () -> Long?): Boolean {
+        if (state.generation != claim.generation) return false
+        val target = claim.target
+        val started = now()
+        val swept = target != null && try { target.sweep(); true } catch (_: Exception) { false }
+        val completed = now()
+        // Only persistence is serialized. A deadline can close admission and sweep while an
+        // older writer or its protection probe is stalled. Its save is ordered after that writer.
+        val revision = synchronized(writes) {
+            if (state.generation != claim.generation || !state.changing) return false
+            try { save() } catch (_: Exception) { null }
+        }
+        val protected = swept && try { target.protectedNow() } catch (_: Exception) { false }
+        synchronized(this) {
+            val s = state
+            if (s.generation != claim.generation || !s.changing) return false
+            val error = when {
+                revision == null -> "Policy save failed"
+                !protected || target !== s.target -> "Native cutoff unconfirmed or VPN protection changed"
+                s.algUncertain -> "Native ALG mode is unconfirmed"
+                s.preferred != Preferred.READY -> "Preferred DNS is ${s.preferred.name.lowercase()}"
+                else -> null
+            }
+            state = s.copy(changing = false, appliedRevision = revision.takeIf { error == null },
+                cutoff = completed.takeIf { swept }, closeMs = completed - started,
+                error = error ?: if (completed - (s.due ?: completed) > 2_000L) "Cutoff exceeded 2000 ms" else null)
+            active = null
+            claim.settled.countDown()
+            return state.error == null
+        }
+    }
+
+    /** Installation is idempotent for the fixed resolver and never occupies the cutoff monitor. */
+    fun installPreferred(target: T, savedRevision: () -> Long?, install: () -> Unit) {
+        synchronized(this) {
+            if (state.target !== target || state.preferred in listOf(Preferred.READY, Preferred.INSTALLING)) return
+            state = state.copy(preferred = Preferred.INSTALLING, appliedRevision = null)
+        }
+        try {
+            install()
+        } catch (e: Exception) {
+            synchronized(this) {
+                if (state.target === target) state = state.copy(preferred = Preferred.FAILED, appliedRevision = null)
+            }
+            throw e
+        }
+        synchronized(this) {
+            if (state.target !== target || state.preferred != Preferred.INSTALLING) return
+            state = state.copy(preferred = Preferred.READY)
+        }
+        while (true) {
+            val previous = synchronized(this) {
+                if (state.target !== target || receipt(target) != null) return
+                val claim = active
+                if (claim?.target === target) return // that transition owns the acknowledgement
+                if (claim == null) begin(target) else claim
+            }
+            if (previous.target === target) {
+                complete(previous, savedRevision)
+                return
+            }
+            // Another adapter's transition may still own a policy save. Never transfer its
+            // acknowledgement. Activate against this adapter once that write has settled.
+            previous.settled.await()
+        }
+    }
+}
+
+/** A replaced alarm may already be running when coroutine cancellation arrives. */
+internal class G0Deadlines<T : G0Cutoff.Target, D : Any>(private val gate: G0Cutoff<T>) {
+    var pending: D? = null
+        private set
+
+    fun arm(before: G0Cutoff.State<T>, next: D): D? = synchronized(gate) {
+        if (gate.state !== before || before.appliedRevision == null) return@synchronized next
+        pending.also { pending = next }
+    }
+
+    fun clear(): D? = synchronized(gate) { pending.also { pending = null } }
+
+    fun claim(expected: D, due: Long): G0Cutoff.Claim<T>? = synchronized(gate) {
+        if (pending !== expected) return@synchronized null
+        pending = null
+        gate.begin(gate.state.target, due)
+    }
+}

@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class AndroidIdnaTest {
+    @Test fun android13NameprepRejectsUnassignedCharacters() {
+        // Robolectric uses host java.net.IDN. Android 13 libcore delegates to this SDK's
+        // ICU entry point with flags=0 and returns the original label on a nameprep error.
+        val convert = Class.forName("com.android.icu.text.ExtendedIDNA")
+            .getMethod("convertIDNToUnicode", String::class.java, Int::class.javaPrimitiveType)
+        for ((label, expected) in mapOf("xn--e28h" to "xn--e28h", "xn--ls8h" to "xn--ls8h",
+            "xn--caf-dma" to "café", "xn--bcher-kva" to "bücher")) {
+            val actual = try {
+                convert.invoke(null, label, 0).toString()
+            } catch (e: java.lang.reflect.InvocationTargetException) {
+                if (e.cause?.javaClass?.name != "android.icu.text.StringPrepParseException") throw e
+                label
+            }
+            assertEquals(label, expected, actual)
+        }
+    }
+}
diff --git a/app/src/test/java/com/celzero/bravedns/stopscroll/G0CutoffTest.kt b/app/src/test/java/com/celzero/bravedns/stopscroll/G0CutoffTest.kt
new file mode 100644
index 0000000..253429a
--- /dev/null
+++ b/app/src/test/java/com/celzero/bravedns/stopscroll/G0CutoffTest.kt
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.FutureTask
+import java.util.concurrent.TimeUnit.SECONDS
+import java.util.concurrent.atomic.AtomicLong
+import kotlin.concurrent.thread
+import org.junit.Assert.*
+import org.junit.Test
+
+class G0CutoffTest {
+    private class Adapter(override val owner: Any = Any()) : G0Cutoff.Target {
+        var close: () -> Unit = {}
+        var probe: () -> Boolean = { true }
+        override fun sweep() = close()
+        override fun protectedNow() = probe()
+    }
+
+    private val time = AtomicLong(100)
+    private val gate = G0Cutoff<Adapter>(time::get)
+    private val first = Adapter()
+    private fun attach(target: Adapter = first) {
+        gate.register(target.owner)
+        gate.attach(target)
+    }
+
+    private fun activate() {
+        attach()
+        gate.installPreferred(first, { 8L }) {}
+        assertEquals(8L, gate.receipt(first)?.appliedRevision)
+    }
+
+    private fun <T> worker(action: () -> T) = FutureTask(action).also { task ->
+        thread(isDaemon = true) { task.run() }
+    }
+
+    private fun await(latch: CountDownLatch) = assertTrue("worker timed out", latch.await(4, SECONDS))
+
+    @Test fun aNewProcessAndRestoredPolicyNeedANativeActivation() {
+        assertNull(gate.state.appliedRevision)
+        attach()
+        val savedRevision = 8L
+        assertNull(gate.receipt(first))
+        var sweeps = 0
+        first.close = { sweeps++ }
+        gate.installPreferred(first, { savedRevision }) {}
+        assertEquals(1, sweeps)
+        assertEquals(savedRevision, gate.receipt(first)?.appliedRevision)
+    }
+
+    @Test fun activationAndReceiptsBelongToOneServiceAndAdapter() {
+        activate()
+        val oldReceipt = gate.receipt(first)
+        val claim = gate.begin(first)
+        val oldSweep = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        first.close = { oldSweep.countDown(); await(resume) }
+        val saving = worker { gate.complete(claim) { 9L } }
+        await(oldSweep)
+        val second = Adapter()
+        attach(second)
+        gate.unregister(first.owner)
+        gate.attach(first)
+        assertNull(gate.receipt(second))
+        assertFalse(gate.permits(first, oldReceipt))
+        val installed = CountDownLatch(1)
+        var newSweeps = 0
+        second.close = { newSweeps++ }
+        val activating = worker { gate.installPreferred(second, { 9L }) { installed.countDown() } }
+        await(installed)
+        resume.countDown()
+        assertFalse(saving.get(4, SECONDS))
+        activating.get(4, SECONDS)
+        assertEquals(1, newSweeps)
+        assertEquals(9L, gate.receipt(second)?.appliedRevision)
+        val third = Adapter(second.owner)
+        gate.attach(third)
+        gate.detach(second)
+        assertSame(third, gate.state.target)
+        assertNull(gate.receipt(third))
+    }
+
+    @Test fun preferredInstallMustSucceedAndStayOnTheSameAdapter() {
+        attach()
+        val started = CountDownLatch(1)
+        val resume = CountDownLatch(1)
+        val setup = worker {
+            assertThrows(IllegalStateException::class.java) {
+                gate.installPreferred(first, { 7L }) {
+                    started.countDown()
+                    await(resume)
+                    error("install failed")
+                }
+            }
+        }
+        await(started)
+        assertEquals(G0Cutoff.Preferred.INSTALLING, gate.state.preferred)
+        assertFalse(gate.complete(gate.begin(first, 90L)) { 7L })
+        assertNull(gate.receipt(first))
+        resume.countDown()
+        setup.get(4, SECONDS)
+        assertEquals(G0Cutoff.Preferred.FAILED, gate.state.preferred)
+        assertFalse(gate.complete(gate.begin(first)) { 7L })
+        gate.installPreferred(first, { 7L }) {}
+        assertEquals(7L, gate.receipt(first)?.appliedRevision)
+    }
+
+    @Test fun slowStatusOrAlgProtectionProbeCannotHoldUpADeadline() {
+        activate()
+        val sampled = gate.state
+        val blocked = CountDownLatch(2)
+        val resume = CountDownLatch(1)
+        first.probe = { blocked.countDown(); await(resume); true }
+        val status = worker { gate.protectedTarget() }
+        val alg = worker { gate.protectedReceipt(first, sampled) }
+        await(blocked)
+        val swept = CountDownLatch(1)
+        first.close = { time.set(132); swept.countDown() }
+        time.set(117)
+        val revoke = worker { gate.complete(gate.begin(first, 110L)) { 9L } }
+        await(swept)
+        assertNull(gate.receipt(first))
+        resume.countDown()
+        assertSame(first, status.get(4, SECONDS))
+        assertFalse(alg.get(4, SECONDS))
+        assertTrue(revoke.get(4, SECONDS))
+        assertEquals(110L, gate.state.due)
+        assertEquals(117L, gate.state.trigger)
+        assertEquals(132L, gate.state.cutoff)
+        assertEquals(15L, gate.state.closeMs)
+        assertFalse(gate.permits(first, sampled))
+    }
+
+    @Test fun deadlineSweepsWhileOldSaveIsBlockedAndItsPolicyWins() {
+        activate()
+        val oldSaving = CountDownLatch(1)
+        val finish = CountDownLatch(1)
+        val saved = AtomicLong(8)
+        val old = worker {
+            gate.complete(gate.begin(first)) {
+                oldSaving.countDown()
+                await(finish)
+                saved.incrementAndGet()
+            }
+        }
+        await(oldSaving)
+        val swept = CountDownLatch(1)
+        first.close = { swept.countDown() }
+        val latest = worker { gate.complete(gate.begin(first, 99L)) { saved.addAndGet(10) } }
+        await(swept)
+        assertNull(gate.receipt(first))
+        finish.countDown()
+        assertFalse(old.get(4, SECONDS))
+        assertTrue(latest.get(4, SECONDS))
+        assertEquals(19L, saved.get())
+        assertEquals(19L, gate.state.appliedRevision)
+    }
+
+    @Test fun replacedOrCancelledDeadlineCannotConsumeTheNewGrant() {
+        activate()
+        val deadlines = G0Deadlines<Adapter, Any>(gate)
+        val firstAlarm = Any()
+        val nextAlarm = Any()
+        val receipt = gate.state
+        assertNull(deadlines.arm(receipt, firstAlarm))
+        assertSame(firstAlarm, deadlines.arm(receipt, nextAlarm))
+        assertNull(deadlines.claim(firstAlarm, 100))
+        assertTrue(gate.permits(first, receipt))
+        val claim = requireNotNull(deadlines.claim(nextAlarm, 101))
+        assertNull(deadlines.claim(nextAlarm, 101))
+        assertNull(gate.receipt(first))
+        assertTrue(gate.complete(claim) { 9L })
+        assertSame(firstAlarm, deadlines.arm(receipt, firstAlarm))
+        assertNull(deadlines.arm(gate.state, firstAlarm))
+        assertSame(firstAlarm, deadlines.clear())
+        assertNull(deadlines.claim(firstAlarm, 102))
+    }
+
+    @Test fun invalidationAfterNativeAlgMutationRestoresTheReportedMode() {
+        activate()
+        var effective = false
+        var reported = false
+        val before = gate.state
+        val result = gate.updateAlg(first, before, true, { reported }, { enabled ->
+            effective = enabled
+            if (enabled) {
+                assertTrue(gate.complete(gate.begin(first, 99L)) { 9L })
+            }
+        }, { reported = it })
+        assertFalse(result)
+        assertFalse(reported)
+        assertEquals(reported, effective)
+        assertEquals(9L, gate.receipt(first)?.appliedRevision)
+    }
+
+    @Test fun rollbackFailureClosesTheCurrentAdapterUntilAReplacementIsInitialized() {
+        activate()
+        val changed = CountDownLatch(1)
+        val finish = CountDownLatch(1)
+        var effective = false
+        var reported = false
+        val before = gate.state
+        val updating = worker {
+            gate.updateAlg(first, before, true, { reported }, { enabled ->
+                if (!enabled) error("resolver no longer accepts a rollback")
+                effective = true
+                changed.countDown()
+                await(finish)
+            }, { reported = it })
+        }
+        await(changed)
+        // The timer must be able to sweep and publish while the ALG caller is still blocked.
+        assertTrue(gate.complete(gate.begin(first, 99L)) { 9L })
+        finish.countDown()
+        assertFalse(updating.get(4, SECONDS))
+        assertTrue(effective)
+        assertFalse(reported)
+        assertTrue(gate.state.algUncertain)
+        assertNull(gate.receipt(first))
+        assertFalse(gate.complete(gate.begin(first)) { 9L })
+        val next = Adapter()
+        attach(next)
+        gate.installPreferred(next, { 9L }) { gate.withAlgLock { effective = reported } }
+        assertFalse(effective)
+        assertFalse(gate.state.algUncertain)
+        assertEquals(9L, gate.receipt(next)?.appliedRevision)
+    }
+
+    @Test fun authorizedAlgCommitAndInitializationUseTheSameCommittedMode() {
+        activate()
+        var effective = false
+        var reported = false
+        assertTrue(gate.updateAlg(first, gate.state, true, { reported }, { effective = it }, { reported = it }))
+        assertTrue(reported && effective)
+        assertTrue(gate.withAlgLock { reported })
+    }
+
+    @Test fun staleSaveSweepFailureOrMissingProtectionCannotOpenAdmission() {
+        activate()
+        val old = gate.begin(first)
+        val current = gate.begin(first)
+        assertFalse(gate.complete(old) { fail("stale save"); 8L })
+        first.close = { error("native failure") }
+        assertFalse(gate.complete(current) { 9L })
+        assertNull(gate.state.cutoff)
+        assertNull(gate.receipt(first))
+        first.close = {}
+        assertFalse(gate.complete(gate.begin(first)) { null })
+        assertNull(gate.receipt(first))
+        first.probe = { false }
+        assertNull(gate.protectedTarget())
+        assertFalse(gate.complete(gate.begin(first)) { 9L })
+        assertNull(gate.receipt(first))
+    }
+}

diff --git a/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/DailyLifecycleTest.kt b/app/src/testStopscrollRelease/java/com/celzero/bravedns/stopscroll/DailyLifecycleTest.kt

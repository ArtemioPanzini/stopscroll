+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/PolicyMatcher.kt
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+internal class PolicyMatcher(policy: Policy) {
+    private data class Rule(val id: String, val limited: Boolean, val domains: Set<String>, val exceptions: Set<String>)
+    private val rules = policy.sites.map { (id, s) -> Rule(id, s.limited, s.domains.toSet(), s.exceptions.toSet()) }
+
+    fun blocks(host: String, openSites: Set<String>): Boolean = blocks(host, openSites::contains)
+
+    fun blocks(host: String, isOpen: (String) -> Boolean): Boolean {
+        val name = host.removeSuffix(".").lowercase(java.util.Locale.ROOT)
+        return rules.any { (!it.limited || !isOpen(it.id)) && matches(name, it.domains) && !matches(name, it.exceptions) }
+    }
+
+    companion object {
+        fun matches(host: String, entries: Set<String>): Boolean {
+            var name = host
+            while (name.isNotEmpty()) {
+                if (name in entries) return true
+                name = name.substringAfter('.', "")
+            }
+            return false
+        }
+    }
+}
diff --git a/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt b/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt
new file mode 100644
index 0000000..8842ada
--- /dev/null
+++ b/app/src/main/java/com/celzero/bravedns/stopscroll/StateStore.kt
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import android.util.AtomicFile
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import com.google.gson.JsonArray
+import com.google.gson.JsonObject
+import java.io.File
+import java.io.IOException
+import java.nio.ByteBuffer
+import java.nio.channels.FileChannel
+import java.nio.charset.StandardCharsets
+import java.nio.file.StandardOpenOption
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.Base64
+import java.util.UUID
+
+internal object JournalCodec {
+    // 64 replies of at most 96 KiB, base64 encoded, plus policy and 1000 accounts.
+    const val MAX_BYTES = 9 * 1024 * 1024
+    private val hashPattern = Regex("[0-9a-f]{64}")
+    private const val MAX_REPLY = 96 * 1024
+    private fun utf8(bytes: ByteArray) = StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(bytes)).toString()
+
+    private fun validate(state: JournalState) {
+        require(state.revision >= 0 && state.bootCount >= 0)
+        require(state.accounts.size <= 1000 && state.accounts.keys.containsAll(state.policy.sites.keys))
+        for ((id, account) in state.accounts) {
+            require(siteId.matches(id) && account.spentSeconds in 0..86400)
+            val s = account.session ?: continue
+            val group = state.policy.sites[id]
+            require(group != null && group.limited)
+            require(s.startMs >= 0 && s.deadlineMs > s.startMs && s.deadlineMs - s.startMs <= 86400000)
+            require(account.spentSeconds + s.reservedSeconds <= group.budgetMin * 60)
+        }
+        require(state.receipts.size <= 64 && state.receipts.distinctBy { it.requestId }.size == state.receipts.size)
+        for (r in state.receipts) {
+            require(UUID.fromString(r.requestId).toString() == r.requestId && hashPattern.matches(r.requestHash))
+            require(r.replyJson.toByteArray().size in 1..MAX_REPLY)
+        }
+    }
+
+    fun encode(state: JournalState): ByteArray {
+        validate(state)
+        val body = JsonObject().apply {
+            addProperty("format", 1)
+            add("policy", PolicyCodec.toJson(state.policy))
+            addProperty("timezone", state.timezone.id)
+            addProperty("day_id", state.dayId.toString())
+            addProperty("boot_count", state.bootCount)
+            addProperty("revision", state.revision)
+            add("accounts", JsonObject().apply {
+                for ((id, account) in state.accounts) add(id, JsonObject().apply {
+                    addProperty("spent", account.spentSeconds)
+                    account.session?.let { s ->
+                        add("session", JsonObject().apply {
+                            addProperty("start_ms", s.startMs)
+                            addProperty("deadline_ms", s.deadlineMs)
+                            addProperty("reserved", s.reservedSeconds)
+                            addProperty("warned", s.warned)
+                        })
+                    }
+                })
+            })
+            add("receipts", JsonArray().apply {
+                for (r in state.receipts) add(JsonObject().apply {
+                    addProperty("id", r.requestId)
+                    addProperty("hash", r.requestHash)
+                    addProperty("reply_b64", Base64.getEncoder().encodeToString(r.replyJson.toByteArray()))
+                })
+            })
+        }
+        return JsonObject().apply {
+            addProperty("sha256", sha256(body.toString().toByteArray()))
+            add("state", body)
+        }.toString().toByteArray()
+    }
+
+    fun decode(bytes: ByteArray): JournalState {
+        require(bytes.size <= MAX_BYTES)
+        val envelope = strictJson(utf8(bytes)).obj()
+        envelope.fields("sha256", "state")
+        val body = envelope["state"].obj()
+        require(sha256(body.toString().toByteArray()) == envelope["sha256"].string())
+        body.fields("format", "policy", "timezone", "day_id", "boot_count", "revision", "accounts", "receipts")
+        body["format"].number(1, 1)
+        val records = body["accounts"].obj()
+        require(records.size() <= 1000)
+        val accounts = records.entrySet().associate { (id, entry) ->
+            val a = entry.obj()
+            val session = if (a.has("session")) {
+                a.fields("spent", "session")
+                val s = a["session"].obj()
+                s.fields("start_ms", "deadline_ms", "reserved", "warned")
+                val warned = s["warned"]
+                require(warned.isJsonPrimitive && warned.asJsonPrimitive.isBoolean)
+                Session(s["start_ms"].number(0, Long.MAX_VALUE), s["deadline_ms"].number(0, Long.MAX_VALUE),
+                    warned.asBoolean).also { require(it.reservedSeconds.toLong() == s["reserved"].number(1, 86400)) }
+            } else {
+                a.fields("spent")
+                null
+            }
+            id to Account(a["spent"].number(0, 86400).toInt(), session)
+        }
+        val history = body["receipts"].array()
+        require(history.size() <= 64)
+        val receipts = history.map { entry ->
+            val r = entry.obj()
+            r.fields("id", "hash", "reply_b64")
+            MutationReceipt(r["id"].string(), r["hash"].string(), utf8(Base64.getDecoder().decode(r["reply_b64"].string())))
+        }
+        return JournalState(PolicyCodec.fromJson(body["policy"]), ZoneId.of(body["timezone"].string()),
+            LocalDate.parse(body["day_id"].string()), body["boot_count"].number(0, Int.MAX_VALUE.toLong()).toInt(),
+            body["revision"].number(0, Long.MAX_VALUE), ImmutableMap.copyOf(accounts), ImmutableList.copyOf(receipts)
+        ).also(::validate)
+    }
+}
+
+internal class OutcomeSuperseded : Exception()
+
+internal class StateStore(
+    private val file: File,
+    private val beforeFinish: () -> Unit = {},
+    private val beforeDirectorySync: (File) -> Unit = {}
+) {
+    private val atomic = AtomicFile(file)
+    private val directory = requireNotNull(file.parentFile)
+
+    // Provider, VPN and UI share one process. Serialize even across separate store handles.
+    private companion object { val journalLock = Any() }
+
+    fun loadOrCreate(initial: () -> JournalState): JournalState = synchronized(journalLock) {
+        // Keep the installation marker outside the journal directory. A missing initialized
+        // journal must not recreate a fresh empty policy or a full daily budget.
+        val marker = File(requireNotNull(directory.parentFile), ".stopscroll-journal-initialized")
+        val result = if (marker.exists() || listOf(file, File(file.path + ".bak"), File(file.path + ".new")).any { it.exists() }) {
+            read()
+        } else {
+            val state = initial()
+            save(state)
+            state
+        }
+        if (!marker.exists()) marker.createNewFile()
+        java.io.FileInputStream(marker).use { it.fd.sync() }
+        syncDirectory(requireNotNull(marker.parentFile))
+        result
+    }
+
+    private fun readBytes(): ByteArray = atomic.openRead().use { stream ->
+        val size = stream.channel.size()
+        if (size !in 1L..JournalCodec.MAX_BYTES.toLong()) throw IOException("Invalid journal size")
+        val data = ByteArray(size.toInt())
+        java.io.DataInputStream(stream).readFully(data)
+        if (stream.read() != -1) throw IOException("Journal grew during read")
+        stream.fd.sync()
+        data
+    }
+
+    fun read(): JournalState = synchronized(journalLock) {
+        try {
+            val state = JournalCodec.decode(readBytes())
+            // openRead may select a legacy backup or a rename left by an unacknowledged save.
+            // Re-establish both directory links before allowing even a no-op tick to see it.
+            syncDirectory(directory)
+            syncDirectory(requireNotNull(directory.parentFile))
+            state
+        } catch (e: Exception) {
+            throw IOException("Cannot read Stopscroll journal", e)
+        }
+    }
+
+    /** No effects escape this call until the complete transition has been committed. */
+    fun update(authorize: () -> Boolean = { true }, transform: (JournalState) -> Transition): Transition = synchronized(journalLock) {
+        val previous = read()
+        val next = transform(previous)
+        if (next.state != previous) save(next.state, authorize)
+        next
+    }
+
+    private fun syncDirectory(dir: File) {
+        beforeDirectorySync(dir)
+        FileChannel.open(dir.toPath(), StandardOpenOption.READ).use { it.force(true) }
+    }
+
+    private fun save(state: JournalState, authorize: () -> Boolean = { true }) {
+        try {
+            val data = JournalCodec.encode(state)
+            if (!directory.isDirectory && !directory.mkdir()) throw IOException("Cannot create journal directory")
+            // A failed parent sync may have left an empty but visible journal directory.
+            syncDirectory(requireNotNull(directory.parentFile))
+            val stream = atomic.startWrite()
+            try {
+                stream.write(data)
+                // AtomicFile.finishWrite logs some sync/rename failures without throwing.
+                stream.fd.sync()
+                beforeFinish()
+                // The grant outcome linearizes at this short decision. A later cutoff is a
+                // subsequent event. Rename/readback/directory sync are still required to reply.
+                if (!authorize()) throw OutcomeSuperseded()
+            } catch (e: Exception) {
+                atomic.failWrite(stream)
+                throw e
+            }
+            atomic.finishWrite(stream)
+            if (!readBytes().contentEquals(data)) throw IOException("Journal commit did not publish expected bytes")
+            syncDirectory(directory)
+        } catch (e: OutcomeSuperseded) {
+            throw e
+        } catch (e: Exception) {
+            throw IOException("Cannot commit Stopscroll journal", e)
+        }
+    }
+}

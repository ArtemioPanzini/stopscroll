+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.gson.JsonNull
+import com.google.gson.JsonObject
+import java.util.UUID
+
+/** The provider validates raw bytes / envelope before constructing this request. The UI shares
+ * the exact same typed boundary. Freeze the validated arguments before entering the writer. */
+internal data class RpcRequest(val requestId: String, val op: String, val args: JsonObject, val expectedRevision: Long? = null)
+
+internal class RpcReply(val json: JsonObject) {
+    val ok get() = json["ok"].asBoolean
+}
+
+private data class Command(val id: String, val op: String, val expected: Long?, val site: String?,
+                           val minutes: Int?, val policy: Policy?, val hash: String) {
+    companion object {
+        fun parse(q: RpcRequest): Command {
+            if (UUID.fromString(q.requestId).toString() != q.requestId) invalid("Expected canonical UUID")
+            val args = q.args.deepCopy()
+            var site: String? = null
+            var minutes: Int? = null
+            var policy: Policy? = null
+            when (q.op) {
+                "policy.get", "status" -> args.fields()
+                "policy.replace" -> { args.fields("policy"); policy = PolicyCodec.fromJson(args["policy"]) }
+                "session.close", "session.open" -> {
+                    if (q.op == "session.open") {
+                        args.fields("site", "minutes")
+                        minutes = args["minutes"].takeUnless { it.isJsonNull }?.number(1, 1440)?.toInt()
+                    } else args.fields("site")
+                    site = args["site"].string()
+                    if (!siteId.matches(site)) invalid("Invalid site ID")
+                }
+                else -> invalid("Unknown operation")
+            }
+            val mutation = q.op !in listOf("policy.get", "status")
+            if (mutation != (q.expectedRevision != null) || (q.expectedRevision ?: 0) < 0) invalid("Invalid expected revision")
+            // Fixed-order, length-unambiguous canonical tuple of every semantic request field.
+            val tuple = com.google.gson.JsonArray().apply {
+                add(1); add(q.requestId); add(q.op); add(q.expectedRevision); add(site); add(minutes); add(policy?.hash)
+            }
+            return Command(q.requestId, q.op, q.expectedRevision, site, minutes, policy, sha256(tuple.toString().toByteArray()))
+        }
+    }
+}
+
+internal class StopscrollController(
+    private val store: StateStore,
+    private val initial: () -> JournalState,
+    private val clock: () -> ClockSample,
+    private val engine: EngineAdapter,
+    private val timers: SessionTimers,
+    private val platform: () -> PlatformProtection
+) {
+    private var initialized = false
+    private var nextTick: Long? = null
+    private var cancelTick: () -> Unit = {}
+    private data class SavedSample(val snapshot: PolicySnapshot, val clock: ClockSample)
+    @Volatile private var savedSample: SavedSample? = null
+    private val saved get() = savedSample?.snapshot
+
+    fun snapshot(): PolicySnapshot {
+        val snapshot = checkNotNull(saved) { "No trustworthy Stopscroll journal" }
+        return if (engine.applied?.snapshot?.revision == snapshot.revision) snapshot
+            else snapshot.copy(admissionOpen = false)
+    }
+
+    private fun reply(id: String, revision: Long, applied: Long?, data: JsonObject? = null,
+                      error: String? = null, message: String? = null, persisted: Boolean = false) = RpcReply(JsonObject().apply {
+        addProperty("schema", 1)
+        addProperty("request_id", id)
+        addProperty("ok", error == null)
+        addProperty("revision", revision)
+        addProperty("applied_revision", applied)
+        if (error == null) add("data", requireNotNull(data)) else {
+            add("error", JsonObject().apply { addProperty("code", error); addProperty("message", message ?: error) })
+            if (persisted) addProperty("saved", true)
+        }
+    })
+
+    private fun failure(id: String, state: JournalState, message: String) =
+        reply(id, state.revision, null, error = "APPLY_FAILED", message = message, persisted = true)
+
+    private fun init() {
+        if (!initialized) { store.loadOrCreate(initial); initialized = true }
+    }
+
+    // Exactly one committed pending marker exists during a synchronous mutation. An unresolved
+    // open is settled before *any* recovered grant may be activated. Recovery never reruns it.
+    private fun recover(state: JournalState, now: ClockSample): JournalState {
+        val r = state.receipts.lastOrNull() ?: return state
+        val pending = strictJson(r.replyJson).obj()
+        if (!pending.has("pending_open")) return state
+        val site = pending["pending_open"]
+        val next = if (site.isJsonNull) state else BudgetEngine(state).close(site.string(), now).state
+        val outcome = failure(r.requestId, next, "Native acknowledgement was interrupted")
+        return next.withReceipt(r.copy(replyJson = outcome.json.toString()))
+    }
+
+    private fun update(op: (JournalState) -> Transition): Transition = store.update { previous ->
+        op(previous).also {
+            if (it.state.revision != previous.revision) engine.invalidate()
+        }
+    }
+
+    private fun tick(now: ClockSample) = update { previous -> BudgetEngine(recover(previous, now)).tick(now) }
+
+    private fun publish(state: JournalState, now: ClockSample): Pair<PolicySnapshot, NativeReceipt?> {
+        val snap = BudgetEngine(state).snapshot(now)
+        savedSample = SavedSample(snap, now)
+        val warning = snap.sites.values.mapNotNull { it.session }.filter { !it.warned && it.deadlineMs - it.startMs > 120000 }
+            .minOfOrNull { it.deadlineMs - 120000 }
+        // A budget timer also settles inactive/degraded engines that have no native receipt.
+        val due = listOfNotNull(warning, snap.cutoffAt(now), snap.resetElapsed(now)).min()
+        if (due != nextTick) {
+            val old = cancelTick
+            cancelTick = timers.tick(due) { reconcile() }
+            nextTick = due
+            old()
+        }
+        return snap to engine.apply(snap).receipt
+    }
+
+    private fun warnings(t: Transition) {
+        t.effects.filter { it.kind == EffectKind.WARN }.forEach { effect ->
+            try { timers.warn(requireNotNull(effect.site)) } catch (_: Exception) { /* Optional notification permission. */ }
+        }
+    }
+
+    private fun storageFault() {
+        savedSample = null
+        engine.failClosed("Unable to verify durable Stopscroll state")
+    }
+
+    @Synchronized fun reconcile() {
+        try {
+            init()
+            val now = clock()
+            val change = tick(now)
+            publish(change.state, now)
+            warnings(change)
+        } catch (_: Exception) { storageFault() }
+    }
+
+    private data class StatusRead(val id: String, val receipt: NativeReceipt?, val target: EngineTarget?)
+
+    fun execute(request: RpcRequest): RpcReply {
+        val cmd = try { Command.parse(request) } catch (e: IllegalArgumentException) {
+            return reply(request.requestId, saved?.revision ?: 0, engine.applied?.snapshot?.revision,
+                error = (e as? PolicyException)?.code ?: "INVALID_REQUEST", message = e.message)
+        }
+        val read = synchronized(this) {
+            try {
+                init()
+                val now = clock()
+                val change = tick(now)
+                warnings(change)
+                val state = change.state
+                if (cmd.expected != null) return mutate(cmd, state, now)
+                val (_, receipt) = publish(state, now)
+                if (cmd.op == "policy.get") return reply(cmd.id, state.revision, receipt?.snapshot?.revision, JsonObject().apply {
+                    add("policy", PolicyCodec.toJson(state.policy))
+                    addProperty("policy_hash", state.policy.hash)
+                })
+                StatusRead(cmd.id, receipt, engine.target)
+            } catch (_: Exception) {
+                val revision = saved?.revision ?: 0
+                storageFault()
+                return reply(cmd.id, revision, null, error = "STORAGE_ERROR", message = "Unable to verify durable Stopscroll state")
+            }
+        }
+        return status(read)
+    }
+
+    private fun status(read: StatusRead): RpcReply {
+        val (id, receipt, live) = read
+        // This diagnostic can block inside Android or native code. It has no writer ownership.
+        val observed = try { live?.platform() ?: platform() } catch (_: Exception) { PlatformProtection(false, false, false, false) }
+        val same = live === engine.target
+        if (same && receipt != null && !observed.protected && engine.applied === receipt)
+            engine.failClosed("VPN protection is incomplete", receipt)
+        // A concurrent mutation may have finished during the probe. Return its committed budget
+        // sample, never transfer the older probe's health acknowledgement to its new receipt.
+        val (snap, now) = savedSample ?: return reply(id, 0, null, error = "STORAGE_ERROR",
+            message = "No trustworthy Stopscroll journal")
+        val confirmed = receipt != null && same && observed.protected && engine.applied === receipt &&
+            receipt.snapshot.revision == snap.revision && snap.validAt(clock())
+        val protection = when {
+            !same || !observed.lockdown || !observed.alwaysOn -> "unprotected"
+            live == null && !observed.tunnel -> "stopped"
+            confirmed -> "active"
+            else -> "degraded"
+        }
+        return reply(id, snap.revision, receipt?.snapshot?.revision?.takeIf { confirmed }, JsonObject().apply {
+            addProperty("policy_hash", snap.policy.hash)
+            addProperty("timezone", snap.timezone.id)
+            addProperty("day_id", snap.dayId.toString())
+            addProperty("reset_hour", 4)
+            addProperty("default_session_min", snap.policy.defaultSessionMin)
+            add("clock", JsonObject().apply {
+                addProperty("wall_ms", now.wallMs); addProperty("elapsed_ms", now.elapsedMs); addProperty("boot_count", now.bootCount)
+            })
+            add("protection", JsonObject().apply {
+                addProperty("state", protection)
+                addProperty("tunnel", same && observed.tunnel)
+                addProperty("always_on", observed.alwaysOn)
+                addProperty("lockdown", observed.lockdown)
+                addProperty("ignoring_battery_optimizations", observed.exempt)
+                addProperty("preferred_state", engine.preferred.name.lowercase())
+                addProperty("reason", if (confirmed) null else engine.error ?: "No current protected VPN receipt")
+            })
+            addProperty("last_transition_due_elapsed_ms", engine.lastDue)
+            addProperty("last_cutoff_elapsed_ms", engine.lastCutoff)
+            add("sites", JsonObject().apply {
+                for ((id, budget) in snap.sites) add(id, JsonObject().apply {
+                    val rule = snap.policy.sites.getValue(id)
+                    addProperty("mode", if (rule.limited) "limited" else "blocked")
+                    addProperty("budget_min", rule.budgetMin)
+                    addProperty("remaining_sec", budget.remainingSeconds)
+                    addProperty("reserved_sec", budget.reservedSeconds)
+                    add("session", budget.session?.let { s -> JsonObject().apply {
+                        addProperty("start_elapsed_ms", s.startMs); addProperty("deadline_elapsed_ms", s.deadlineMs)
+                    } } ?: JsonNull.INSTANCE)
+                })
+            })
+        })
+    }
+
+    private fun mutate(q: Command, before: JournalState, now: ClockSample): RpcReply {
+        before.receipts.firstOrNull { it.requestId == q.id }?.let { cached ->
+            publish(before, now)
+            if (q.hash != cached.requestHash) return reply(q.id, before.revision, engine.applied?.snapshot?.revision,
+                error = "CONFLICT", message = "Request ID already used for a different command")
+            return RpcReply(strictJson(cached.replyJson).obj())
+        }
+        val budget = BudgetEngine(before)
+        val change = if (q.expected != before.revision) Transition(before, emptyList(), "CONFLICT")
+        else when (q.op) {
+            "policy.replace" -> budget.replacePolicy(requireNotNull(q.policy), now)
+            "session.open" -> budget.open(requireNotNull(q.site), (q.minutes ?: before.policy.defaultSessionMin) * 60, now)
+            else -> budget.close(requireNotNull(q.site), now)
+        }
+        val state = change.state
+        val receipt = MutationReceipt(q.id, q.hash, "")
+        if (change.error != null) {
+            val (_, ack) = publish(state, now)
+            val result = reply(q.id, state.revision, ack?.snapshot?.revision, error = change.error)
+            store.update { Transition(it.withReceipt(receipt.copy(replyJson = result.json.toString())), emptyList()) }
+            return result
+        }
+        val opening = q.site.takeIf { q.op == "session.open" }
+        val pending = JsonObject().apply { addProperty("pending_open", opening) }
+        update { change.copy(state = state.withReceipt(receipt.copy(replyJson = pending.toString()))) }
+        val (snap, ack) = publish(state, now)
+        warnings(change)
+        fun failed(): RpcReply {
+            val reason = engine.error ?: "No current protected VPN receipt"
+            engine.failClosed(reason)
+            val settled = update { current ->
+                val close = if (opening == null) Transition(current, emptyList()) else BudgetEngine(current).close(opening, clock())
+                val result = failure(q.id, close.state, reason)
+                close.copy(state = close.state.withReceipt(receipt.copy(replyJson = result.json.toString())))
+            }.state
+            val sampled = clock()
+            savedSample = SavedSample(BudgetEngine(settled).snapshot(sampled), sampled)
+            return failure(q.id, settled, reason)
+        }
+        if (ack == null || !engine.confirm(ack)) return failed()
+        val data = JsonObject().apply {
+            if (q.op == "policy.replace") {
+                addProperty("changed", before.policy != state.policy); addProperty("policy_hash", state.policy.hash)
+            } else {
+                val site = requireNotNull(q.site)
+                val b = snap.sites.getValue(site)
+                addProperty("site", site); addProperty("remaining_sec", b.remainingSeconds)
+                if (opening == null) addProperty("closed", before.accounts[site]?.session != null)
+                else {
+                    val session = requireNotNull(b.session)
+                    addProperty("granted_sec", session.reservedSeconds); addProperty("deadline_elapsed_ms", session.deadlineMs)
+                }
+            }
+        }
+        val result = reply(q.id, state.revision, ack.snapshot.revision, data)
+        return try {
+            store.update(authorize = { engine.authorizeOutcome(ack) }) {
+                Transition(it.withReceipt(receipt.copy(replyJson = result.json.toString())), emptyList())
+            }
+            result
+        } catch (_: OutcomeSuperseded) { failed() }
+    }
+}

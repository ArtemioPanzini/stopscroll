@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.celzero.bravedns.stopscroll
+
+import com.google.common.collect.ImmutableList
+import com.google.common.collect.ImmutableMap
+import com.google.common.net.InternetDomainName
+import com.google.gson.JsonArray
+import com.google.gson.JsonElement
+import com.google.gson.JsonObject
+import com.google.gson.JsonPrimitive
+import com.google.gson.Strictness
+import com.google.gson.stream.JsonReader
+import com.google.gson.stream.JsonToken
+import java.io.StringReader
+import java.net.IDN
+
+private val integerToken = Regex("-?(?:0|[1-9][0-9]*)")
+
+private fun jsonLong(token: String): Long {
+    if (token.length > 20 || !integerToken.matches(token)) invalid("Expected integer")
+    return token.toLongOrNull() ?: invalid("Integer out of range")
+}
+
+/** Gson's tree parser silently overwrites duplicate keys. Check them while streaming. */
+internal fun strictJson(raw: String): JsonElement {
+    val reader = JsonReader(StringReader(raw)).apply { strictness = Strictness.STRICT }
+    fun value(depth: Int): JsonElement {
+        if (depth > 16) invalid("JSON nesting is too deep")
+        return when (reader.peek()) {
+            JsonToken.BEGIN_OBJECT -> JsonObject().apply {
+                reader.beginObject()
+                while (reader.hasNext()) {
+                    val key = reader.nextName()
+                    if (has(key)) invalid("Repeated JSON field")
+                    add(key, value(depth + 1))
+                }
+                reader.endObject()
+            }
+            JsonToken.BEGIN_ARRAY -> JsonArray().apply {
+                reader.beginArray()
+                while (reader.hasNext()) add(value(depth + 1))
+                reader.endArray()
+            }
+            JsonToken.STRING -> JsonPrimitive(reader.nextString())
+            JsonToken.NUMBER -> JsonPrimitive(jsonLong(reader.nextString()))
+            JsonToken.NULL -> { reader.nextNull(); com.google.gson.JsonNull.INSTANCE }
+            JsonToken.BOOLEAN -> JsonPrimitive(reader.nextBoolean())
+            else -> invalid("Unexpected JSON token")
+        }
+    }
+    return try {
+        val parsed = value(0)
+        if (reader.peek() != JsonToken.END_DOCUMENT) invalid("Trailing JSON")
+        parsed
+    } catch (e: PolicyException) {
+        throw e
+    } catch (e: Exception) {
+        invalid("Malformed JSON")
+    }
+}
+
+internal fun JsonElement.obj(): JsonObject = if (isJsonObject) asJsonObject else invalid("Expected object")
+internal fun JsonElement.array(): JsonArray = if (isJsonArray) asJsonArray else invalid("Expected array")
+internal fun JsonElement.string(): String =
+    if (isJsonPrimitive && asJsonPrimitive.isString) asString else invalid("Expected string")
+internal fun JsonElement.number(min: Long, max: Long): Long {
+    if (!isJsonPrimitive || !asJsonPrimitive.isNumber) invalid("Expected integer")
+    val value = jsonLong(asString)
+    if (value !in min..max) invalid("Integer out of range")
+    return value
+}
+internal fun JsonObject.fields(vararg names: String) {
+    if (keySet() != names.toSet()) invalid("Missing or unknown field")
+}
+
+internal object PolicyCodec {
+    const val MAX_BYTES = 65536
+    private val label = Regex("[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
+
+    private val ipv4Component = Regex("[0-9]+|0x[0-9a-f]*")
+
+    fun decode(raw: String): Policy = fromJson(strictJson(raw))
+
+    /** A parsed tree retains number types and tokens. Reject duplicate keys at the raw JSON boundary. */
+    fun fromJson(element: JsonElement): Policy {
+        val root = element.obj()
+        root.fields("schema", "reset_hour", "default_session_min", "sites")
+        if (root["schema"].number(0, Long.MAX_VALUE) != 1L) throw PolicyException("UNSUPPORTED_SCHEMA", "Policy schema must be 1")
+        root["reset_hour"].number(4, 4)
+        val defaultMin = root["default_session_min"].number(1, 1440).toInt()
+        val sites = root["sites"].obj()
+        if (sites.size() > 100) oversized("At most 100 site groups")
+        var count = 0
+        fun domains(element: JsonElement): ImmutableList<String> {
+            val array = element.array()
+            count += array.size()
+            if (count > 1000) oversized("At most 1000 domains and exceptions")
+            return ImmutableList.copyOf(array.map { validateDomain(it.string()) })
+        }
+        val policies = sites.entrySet().associate { (id, entry) ->
+            if (!siteId.matches(id)) invalid("Invalid site ID")
+            val group = entry.obj()
+            group.fields("mode", "budget_min", "domains", "exceptions")
+            val limited = when (group["mode"].string()) {
+                "limited" -> true
+                "blocked" -> false
+                else -> invalid("Invalid mode")
+            }
+            val budget = if (limited) group["budget_min"].number(1, 1440) else group["budget_min"].number(0, 0)
+            val entries = domains(group["domains"])
+            if (entries.isEmpty()) invalid("Group requires a domain")
+            val exceptions = domains(group["exceptions"])
+            val roots = entries.toSet()
+            if (exceptions.any { !PolicyMatcher.matches(it, roots) }) invalid("Exception is outside group domains")
+            id to SitePolicy(limited, budget.toInt(), entries, exceptions)
+        }
+        val policy = Policy(defaultMin, ImmutableMap.copyOf(policies.toSortedMap()))
+        if (encode(policy).toByteArray().size > MAX_BYTES) oversized("Canonical policy exceeds 64 KiB")
+        return policy
+    }
+
+    private fun validateDomain(host: String): String {
+        val labels = host.split('.')
+        if (host.length > 253 || host.startsWith("www.") || labels.size < 2 || !labels.all(label::matches))
+            invalid("Expected normalized ASCII domain")
+        if (labels.size <= 4 && labels.all(ipv4Component::matches))
+            invalid("IP address is not a domain")
+        if (labels.any { it.startsWith("xn--") && IDN.toUnicode(it) == it }) invalid("Invalid IDNA label")
+        if (InternetDomainName.isValid(host) && InternetDomainName.from(host).isPublicSuffix) invalid("Public suffix is not a site")
+        return host
+    }
+
+    // Compact UTF-8, sorted object keys, original array order. No reflection on persisted field names.
+    fun toJson(policy: Policy): JsonObject = JsonObject().apply {
+        addProperty("default_session_min", policy.defaultSessionMin)
+        addProperty("reset_hour", 4)
+        addProperty("schema", 1)
+        add("sites", JsonObject().apply {
+            for ((id, group) in policy.sites.toSortedMap()) add(id, JsonObject().apply {
+                addProperty("budget_min", group.budgetMin)
+                add("domains", JsonArray().apply { group.domains.forEach(::add) })
+                add("exceptions", JsonArray().apply { group.exceptions.forEach(::add) })
+                addProperty("mode", if (group.limited) "limited" else "blocked")
+            })
+        })
+    }
+
+    fun encode(policy: Policy): String = toJson(policy).toString()
+}
